
{
  "name": "assets",
  "version": "1.0.0",
  "scripts": {
    "build:css": "tailwindcss -i css/app.css -o ../priv/static/assets/app.css",
    "build:js": "esbuild js/app.js --bundle --outdir=../priv/static/assets --external:/fonts/* --external:/images/*",
    "build": "npm run build:css && npm run build:js",
    "deploy": "npm run build:css -- --minify && npm run build:js -- --minify",
    "watch": "npm run build:css -- --watch & npm run build:js -- --watch"
  },
  "devDependencies": {
    "esbuild": "^0.25.4",
    "tailwindcss": "^3.4.18",
    "daisyui": "^5.5.5",
    "phoenix": "file:../deps/phoenix",
    "phoenix_html": "file:../deps/phoenix_html",
    "phoenix_live_view": "file:../deps/phoenix_live_view",
    "topbar": "^1.0.0"
  }
}
