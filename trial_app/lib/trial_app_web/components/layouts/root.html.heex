<!DOCTYPE html>
<html lang="en" data-theme="light" class="scroll-smooth" x-data="{ mobileMenuOpen: false, darkMode: false }" x-init="darkMode = localStorage.getItem('theme') === 'dark' || (!localStorage.getItem('theme') && window.matchMedia('(prefers-color-scheme: dark)').matches); $watch('darkMode', val => { localStorage.setItem('theme', val ? 'dark' : 'light'); document.documentElement.setAttribute('data-theme', val ? 'dark' : 'light'); })">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
   
    <!-- SEO -->
    <meta name="description" content="AMS - Attachment Management System" />
    <meta name="author" content="Value8" />
   
    <.live_title default="AMS" suffix=" · Attachment Management System">
      {assigns[:page_title]}
    </.live_title>

    <!-- Fonts & Assets -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static src={~p"/assets/js/app.js"}></script>
    <script defer src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js"></script>

    <!-- Dark Mode & Animations (unchanged) -->
    <style>
      * { font-family: 'Inter', sans-serif; scroll-behavior: smooth; }
      html[data-theme="light"] body { background: #fff; color: #111; }
      html[data-theme="dark"] body { background: #111827; color: #f9fafb; }
      html[data-theme="dark"] .bg-white { background: #1f2937 !important; }
      html[data-theme="dark"] .text-gray-900 { color: #f9fafb !important; }
      nav.scrolled { box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1); }
      @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
      .fade-in { animation: fadeIn 0.4s ease-out; }
    </style>
  </head>

  <body class="bg-white text-gray-900 min-h-screen antialiased">

    <!-- LOADING BAR -->
    <div class="phx-loading fixed top-0 left-0 right-0 h-1 bg-gradient-to-r from-indigo-600 to-purple-600 z-[100] opacity-0 transition-opacity" phx-connected-class="opacity-100"></div>

    <!-- NAV BAR: ONLY SHOW WHEN LOGGED IN -->
    <%= if assigns[:current_scope] && assigns[:current_scope].user do %>
      <nav class="bg-white/95 backdrop-blur-sm border-b border-gray-200 sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="flex justify-between items-center h-16">

            <!-- LOGO + AMS -->
            <div class="flex items-center space-x-3">
              <.link navigate={~p"/dashboard"} class="flex items-center space-x-3 group">
                <img src={~p"/images/value8-logo.png"} alt="Value8" class="h-9 w-auto" />
                <div>
                  <span class="text-xl font-bold text-indigo-600">AMS</span>
                  <p class="text-xs text-gray-500 hidden sm:block">Attachment Management System</p>
                </div>
              </.link>

              <!-- Admin Links -->
              <%= if assigns[:current_scope].user.role == "admin" do %>
                <div class="hidden lg:flex items-center space-x-6 ml-10">
                  <.link navigate={~p"/dashboard"} class="text-sm font-medium text-gray-700 hover:text-indigo-600">Dashboard</.link>
                  <.link navigate={~p"/organizations"} class="text-sm font-medium text-gray-700 hover:text-indigo-600">Organizations</.link>
                  <.link navigate={~p"/users"} class="text-sm font-medium text-gray-700 hover:text-indigo-600">Users</.link>
                </div>
              <% end %>
            </div>

            <!-- USER MENU -->
            <div class="flex items-center space-x-4">
              <button @click="darkMode = !darkMode" class="p-2 text-gray-600 hover:bg-gray-100 rounded-lg">
                <svg x-show="!darkMode" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
                </svg>
                <svg x-show="darkMode" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
                </svg>
              </button>

              <div class="flex items-center space-x-3">
                <div class="text-right">
                  <p class="text-xs text-gray-500">Welcome back</p>
                  <p class="font-medium text-sm"><%= assigns[:current_scope].user.email %></p>
                </div>
                <div class="w-9 h-9 rounded-full bg-gradient-to-br from-indigo-500 to-purple-600 flex items-center justify-center text-white font-bold text-sm ring-2 ring-white">
                  <%= String.first(assigns[:current_scope].user.email) |> String.upcase() %>
                </div>
              </div>

              <.link navigate={~p"/users/settings"} class="text-gray-600 hover:text-indigo-600">
                Settings
              </.link>
              <.link navigate={~p"/users/logout"} class="text-red-600 hover:text-red-800 font-medium">
                Logout
              </.link>
            </div>

            <!-- Mobile Menu Button -->
            <button @click="mobileMenuOpen = !mobileMenuOpen" class="md:hidden p-2">
              <svg x-show="!mobileMenuOpen" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
              </svg>
              <svg x-show="mobileMenuOpen" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
              </svg>
            </button>
          </div>

          <!-- Mobile Menu -->
          <div x-show="mobileMenuOpen" class="md:hidden py-4 border-t">
            <div class="space-y-3 px-4">
              <.link navigate={~p"/dashboard"} class="block text-gray-700 hover:text-indigo-600">Dashboard</.link>
              <.link navigate={~p"/users/settings"} class="block text-gray-700 hover:text-indigo-600">Settings</.link>
              <.link navigate={~p"/users/logout"} class="block text-red-600">Logout</.link>
            </div>
          </div>
        </div>
      </nav>
    <% end %>

    <!-- MAIN CONTENT -->
    <main class="min-h-screen">
      <div class="fade-in">
        {@inner_content}
      </div>
    </main>

    <!-- FLASH -->
    <div id="flash-group" class="fixed top-20 right-4 z-50 space-y-2">
      <.flash kind={:info} flash={@flash} />
      <.flash kind={:error} flash={@flash} />
    </div>
  </body>
</html>