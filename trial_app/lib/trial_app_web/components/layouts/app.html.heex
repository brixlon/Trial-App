<div x-data="{ sidebarOpen: true, mobileMenuOpen: false }">
  <!-- Sidebar Component (Fixed Left) -->
  <.live_component
    module={TrialAppWeb.SidebarComponent}
    id="sidebar"
    current_scope={@current_scope}
    current_path={assigns[:current_path]}
  />
  
<!-- TOP NAVBAR (fixed full width, non-interactive) -->
  <nav class="bg-white/95 backdrop-blur-sm border-b border-gray-200 fixed top-0 left-0 right-0 z-50 h-16">
    <div class="w-full px-6 h-full">
      <div class="flex items-center justify-between h-full">
        <!-- LOGO + AMS (Non-clickable) -->
        <div class="flex items-center space-x-3">
          <img src={~p"/images/value8-logo.png"} alt="Value8" class="h-9 w-auto" />
          <div>
            <span class="text-xl font-bold text-indigo-600">AMS</span>
            <p class="text-xs text-gray-500 hidden sm:block">Attachment Management System</p>
          </div>
        </div>
        
<!-- User Info (Right Side) -->
        <%= if @current_scope && @current_scope.user do %>
          <div class="flex items-center space-x-3">
            <div class="text-right hidden sm:block">
              <p class="font-medium text-sm text-gray-700">{@current_scope.user.email}</p>
              <p class="text-xs text-gray-500">{String.capitalize(@current_scope.active_role)}</p>
            </div>
            <div class="w-9 h-9 rounded-full bg-gradient-to-br from-indigo-500 to-purple-600 flex items-center justify-center text-white font-bold text-sm ring-2 ring-white shadow-sm">
              {String.first(@current_scope.user.email) |> String.upcase()}
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </nav>
  
<!-- Main Content Area -->
  <main
    class="ml-64 pt-16 min-h-screen bg-gray-50 transition-all duration-300"
    x-bind:class="!sidebarOpen && '!ml-0'"
  >
    <!-- Flash Messages -->
    <%= if assigns[:flash] do %>
      <div class="sticky top-16 z-30">
        <.flash_group flash={@flash} />
      </div>
    <% end %>
    
<!-- Page Content -->
    <div class="p-6">
      <%= if assigns[:inner_content] do %>
        {@inner_content}
      <% else %>
        {render_slot(@inner_block)}
      <% end %>
    </div>
  </main>
</div>
