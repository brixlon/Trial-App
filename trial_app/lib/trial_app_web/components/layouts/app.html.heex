<div class="flex min-h-screen bg-gray-50">
  <!-- Sidebar Component -->
  <.live_component 
    module={TrialAppWeb.SidebarComponent} 
    id="sidebar" 
    current_scope={@current_scope}
  />

  <!-- Main Content Area -->
  <main class={"flex-1 transition-all duration-300 ml-64"}>
    <!-- Flash Messages -->
    <%= if assigns[:flash] do %>
      <div class="sticky top-0 z-30">
        <.flash_group flash={@flash} />
      </div>
    <% end %>

    <!-- Page Content -->
    <div class="p-8">
      <%= if assigns[:inner_content] do %>
        <%= @inner_content %>
      <% else %>
        <%= render_slot(@inner_block) %>
      <% end %>
    </div>
  </main>
</div>