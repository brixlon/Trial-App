<div x-data="{ sidebarOpen: true, mobileMenuOpen: false }">
  <!-- Sidebar Component (Fixed Left) -->
  <.live_component
    module={TrialAppWeb.SidebarComponent}
    id="sidebar"
    current_scope={@current_scope}
    current_path={assigns[:current_path]}
  />
  
<!-- TOP NAVBAR (spans full width, accounting for sidebar) -->
  <nav
    class="bg-white/95 backdrop-blur-sm border-b border-gray-200 fixed top-0 left-64 right-0 z-50 transition-all duration-300"
    x-bind:class="!sidebarOpen && '!left-0'"
  >
    <div class="w-full px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between items-center h-16">
        
<!-- LOGO + AMS -->
        <div class="flex items-center space-x-3">
          <.link navigate={~p"/dashboard"} class="flex items-center space-x-3 group">
            <img src={~p"/images/value8-logo.png"} alt="Value8" class="h-9 w-auto" />
            <div>
              <span class="text-xl font-bold text-indigo-600">AMS</span>
              <p class="text-xs text-gray-500 hidden sm:block">Attachment Management System</p>
            </div>
          </.link>
          
<!-- Admin Quick Links -->
          <%= if @current_scope && @current_scope.user && @current_scope.user.role == "admin" do %>
            <div class="hidden lg:flex items-center space-x-6 ml-10">
              <.link
                navigate={~p"/dashboard"}
                class="text-sm font-medium text-gray-700 hover:text-indigo-600"
              >
                Dashboard
              </.link>
              <.link
                navigate={~p"/organizations"}
                class="text-sm font-medium text-gray-700 hover:text-indigo-600"
              >
                Organizations
              </.link>
              <.link
                navigate={~p"/admin/users"}
                class="text-sm font-medium text-gray-700 hover:text-indigo-600"
              >
                Users
              </.link>
            </div>
          <% end %>
        </div>
        
<!-- USER MENU -->
        <div class="flex items-center space-x-4">
          <!-- User Info -->
          <%= if @current_scope && @current_scope.user do %>
            <div class="flex items-center space-x-3">
              <div class="text-right hidden sm:block">
                <p class="font-medium text-sm">{@current_scope.user.email}</p>
              </div>
              <div class="w-9 h-9 rounded-full bg-gradient-to-br from-indigo-500 to-purple-600 flex items-center justify-center text-white font-bold text-sm ring-2 ring-white">
                {String.first(@current_scope.user.email) |> String.upcase()}
              </div>
            </div>

            <.link
              navigate={~p"/users/settings"}
              class="text-gray-600 hover:text-indigo-600 hidden sm:block"
            >
              Settings
            </.link>
          <% end %>
          
<!-- Mobile Menu Button -->
          <button @click="mobileMenuOpen = !mobileMenuOpen" class="lg:hidden p-2">
            <svg
              x-show="!mobileMenuOpen"
              class="w-6 h-6"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M4 6h16M4 12h16M4 18h16"
              />
            </svg>
            <svg
              x-show="mobileMenuOpen"
              class="w-6 h-6"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M6 18L18 6M6 6l12 12"
              />
            </svg>
          </button>
        </div>
      </div>
      
<!-- Mobile Menu -->
      <div x-show="mobileMenuOpen" class="lg:hidden py-4 border-t" x-transition>
        <div class="space-y-3 px-4">
          <.link navigate={~p"/dashboard"} class="block text-gray-700 hover:text-indigo-600">
            Dashboard
          </.link>
          <.link navigate={~p"/users/settings"} class="block text-gray-700 hover:text-indigo-600">
            Settings
          </.link>
          <%= if @current_scope && @current_scope.user && @current_scope.user.role == "admin" do %>
            <.link navigate={~p"/organizations"} class="block text-gray-700 hover:text-indigo-600">
              Organizations
            </.link>
            <.link navigate={~p"/admin/users"} class="block text-gray-700 hover:text-indigo-600">
              Users
            </.link>
          <% end %>
        </div>
      </div>
    </div>
  </nav>
  
<!-- Main Content Area -->
  <main
    class="ml-64 pt-16 min-h-screen bg-gray-50 transition-all duration-300"
    x-bind:class="!sidebarOpen && '!ml-0'"
  >
    <!-- Flash Messages -->
    <%= if assigns[:flash] do %>
      <div class="sticky top-16 z-30">
        <.flash_group flash={@flash} />
      </div>
    <% end %>
    
<!-- Page Content -->
    <div class="p-6">
      <%= if assigns[:inner_content] do %>
        {@inner_content}
      <% else %>
        {render_slot(@inner_block)}
      <% end %>
    </div>
  </main>
</div>
