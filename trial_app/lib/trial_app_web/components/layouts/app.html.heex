<div x-data="{ mobileMenuOpen: false, darkMode: localStorage.getItem('theme') === 'dark' }">
  <!-- TOP NAVBAR -->
  <nav class="bg-white/95 backdrop-blur-sm border-b border-gray-200 fixed top-0 left-0 right-0 z-50">
    <div class="w-full px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between items-center h-16">
        
        <!-- LOGO + AMS -->
        <div class="flex items-center space-x-3">
          <.link navigate={~p"/dashboard"} class="flex items-center space-x-3 group">
            <img src={~p"/images/value8-logo.png"} alt="Value8" class="h-9 w-auto" />
            <div>
              <span class="text-xl font-bold text-indigo-600">AMS</span>
              <p class="text-xs text-gray-500 hidden sm:block">Attachment Management System</p>
            </div>
          </.link>

          <!-- Admin Quick Links -->
          <%= if @current_scope && @current_scope.user && @current_scope.user.role == "admin" do %>
            <div class="hidden lg:flex items-center space-x-6 ml-10">
              <.link navigate={~p"/dashboard"} class="text-sm font-medium text-gray-700 hover:text-indigo-600">Dashboard</.link>
              <.link navigate={~p"/organizations"} class="text-sm font-medium text-gray-700 hover:text-indigo-600">Organizations</.link>
              <.link navigate={~p"/admin/users"} class="text-sm font-medium text-gray-700 hover:text-indigo-600">Users</.link>
            </div>
          <% end %>
        </div>

        <!-- USER MENU -->
        <div class="flex items-center space-x-4">
          <!-- Dark Mode Toggle -->
          <button @click="darkMode = !darkMode; localStorage.setItem('theme', darkMode ? 'dark' : 'light'); document.documentElement.setAttribute('data-theme', darkMode ? 'dark' : 'light');" class="p-2 text-gray-600 hover:bg-gray-100 rounded-lg transition-colors">
            <svg x-show="!darkMode" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
            </svg>
            <svg x-show="darkMode" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
            </svg>
          </button>

          <!-- User Info -->
          <%= if @current_scope && @current_scope.user do %>
            <div class="flex items-center space-x-3">
              <div class="text-right hidden sm:block">
                <p class="text-xs text-gray-500">Welcome back</p>
                <p class="font-medium text-sm"><%= @current_scope.user.email %></p>
              </div>
              <div class="w-9 h-9 rounded-full bg-gradient-to-br from-indigo-500 to-purple-600 flex items-center justify-center text-white font-bold text-sm ring-2 ring-white">
                <%= String.first(@current_scope.user.email) |> String.upcase() %>
              </div>
            </div>

            <.link navigate={~p"/users/settings"} class="text-gray-600 hover:text-indigo-600 hidden sm:block">
              Settings
            </.link>
          <% end %>

          <!-- Mobile Menu Button -->
          <button @click="mobileMenuOpen = !mobileMenuOpen" class="lg:hidden p-2">
            <svg x-show="!mobileMenuOpen" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
            <svg x-show="mobileMenuOpen" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
      </div>

      <!-- Mobile Menu -->
      <div x-show="mobileMenuOpen" class="lg:hidden py-4 border-t" x-transition>
        <div class="space-y-3 px-4">
          <.link navigate={~p"/dashboard"} class="block text-gray-700 hover:text-indigo-600">Dashboard</.link>
          <.link navigate={~p"/users/settings"} class="block text-gray-700 hover:text-indigo-600">Settings</.link>
          <%= if @current_scope && @current_scope.user && @current_scope.user.role == "admin" do %>
            <.link navigate={~p"/organizations"} class="block text-gray-700 hover:text-indigo-600">Organizations</.link>
            <.link navigate={~p"/admin/users"} class="block text-gray-700 hover:text-indigo-600">Users</.link>
          <% end %>
        </div>
      </div>
    </div>
  </nav>

  <!-- LAYOUT: SIDEBAR + CONTENT -->
  <div class="flex min-h-screen bg-gray-50">
    <!-- Sidebar Component -->
    <.live_component 
      module={TrialAppWeb.SidebarComponent} 
      id="sidebar" 
      current_scope={@current_scope}
    />

    <!-- Main Content Area -->
    <main class="flex-1 transition-all duration-300 ml-64 pt-16">
      <!-- Flash Messages -->
      <%= if assigns[:flash] do %>
        <div class="sticky top-16 z-30">
          <.flash_group flash={@flash} />
        </div>
      <% end %>

      <!-- Page Content -->
      <div class="p-8">
        <%= if assigns[:inner_content] do %>
          <%= @inner_content %>
        <% else %>
          <%= render_slot(@inner_block) %>
        <% end %>
      </div>
    </main>
  </div>
</div>