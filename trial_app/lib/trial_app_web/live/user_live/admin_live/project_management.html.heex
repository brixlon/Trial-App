<div class="min-h-screen bg-gray-50">
  <main class="ml-45 p-8">
    <div class="max-w-7xl mx-auto space-y-8">

      <!-- Breadcrumb -->
      <div class="text-sm breadcrumbs">
        <.link navigate={~p"/admin/eams/projects"} class="text-purple-600 hover:underline">
          Projects
        </.link>
        <%= if @show_detail_view do %>
          <span class="mx-2 text-gray-400">/</span>
          <span class="text-gray-700"><%= @selected_project.name %></span>
        <% end %>
      </div>

      <%= if @show_detail_view && @selected_project do %>
        <div class="space-y-8">

          <!-- Hero Header Card -->
          <div class="bg-gradient-to-r from-purple-600 to-indigo-600 rounded-2xl shadow-xl p-8 text-white">
            <div class="flex items-start justify-between">
              <div>
                <h1 class="text-4xl font-bold mb-2"><%= @selected_project.name %></h1>
                <%= if @selected_project.code do %>
                  <span class="inline-block px-4 py-1.5 bg-white/20 rounded-full text-sm font-semibold">
                    <%= @selected_project.code %>
                  </span>
                <% end %>
              </div>
              <button phx-click="back_to_projects" class="text-white hover:text-white/80 transition">
                <.icon name="hero-x-mark" class="w-8 h-8" />
              </button>
            </div>
            <%= if @selected_project.description do %>
              <p class="mt-4 text-purple-100"><%= @selected_project.description %></p>
            <% end %>

            <!-- Program Info -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mt-4">
              <%= if Ecto.assoc_loaded?(@selected_project.program) && @selected_project.program do %>
                <div class="flex items-center gap-3 bg-white/10 rounded-lg p-2">
                  <.icon name="hero-folder" class="w-5 h-5" />
                  <div>
                    <div class="text-xs text-purple-200">Program</div>
                    <div class="font-medium"><%= @selected_project.program.name %></div>
                  </div>
                </div>
              <% end %>

              <%= if Ecto.assoc_loaded?(@selected_project.supervisor) && @selected_project.supervisor do %>
                <div class="flex items-center gap-3 bg-white/10 rounded-lg p-3">
                  <.icon name="hero-user" class="w-5 h-5" />
                  <div>
                    <div class="text-xs text-purple-200">Supervisor</div>
                    <div class="font-medium"><%= @selected_project.supervisor.username || @selected_project.supervisor.email %></div>
                  </div>
                </div>
              <% end %>

              <%= if @selected_project.starts_on do %>
                <div class="flex items-center gap-3 bg-white/10 rounded-lg p-3">
                  <.icon name="hero-calendar" class="w-5 h-5" />
                  <div>
                    <div class="text-xs text-violet-200">Start Date</div>
                    <div class="font-medium"><%= Calendar.strftime(@selected_project.starts_on, "%b %d, %Y") %></div>
                  </div>
                </div>
              <% end %>

              <%= if @selected_project.ends_on do %>
                <div class="flex items-center gap-3 bg-white/10 rounded-lg p-3">
                  <.icon name="hero-calendar" class="w-5 h-5" />
                  <div>
                    <div class="text-xs text-violet-200">End Date</div>
                    <div class="font-medium"><%= Calendar.strftime(@selected_project.ends_on, "%b %d, %Y") %></div>
                  </div>
                </div>
              <% end %>
            </div>
          </div>

          <!-- Stats Cards -->
          <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
            <div class="bg-white shadow rounded-xl p-4 border border-gray-200">
              <div class="flex items-center justify-between">
                <div class="w-12 h-12 rounded-xl bg-purple-50 flex items-center justify-center">
                  <.icon name="hero-user-group" class="w-3 h-3 text-purple-300" />
                </div>
                <span class="text-2xl font-bold text-gray-900"><%= @selected_project.stats.total_attachees %></span>
              </div>
              <p class="text-sm text-gray-600">Total Attachees</p>
            </div>

            <div class="bg-white shadow rounded-xl p-6 border border-gray-200">
              <div class="flex items-center justify-between">
                <div class="w-12 h-12 rounded-xl bg-blue-100 flex items-center justify-center">
                  <.icon name="hero-clipboard-document-list" class="w-6 h-6 text-blue-600" />
                </div>
                <span class="text-2xl font-bold text-gray-900"><%= @selected_project.stats.total_tasks %></span>
              </div>
              <p class="text-sm text-gray-600">Total Tasks</p>
            </div>

            <div class="bg-white shadow rounded-xl p-6 border border-gray-200">
              <div class="flex items-center justify-between">
                <div class="w-12 h-12 rounded-xl bg-green-100 flex items-center justify-center">
                  <.icon name="hero-check-circle" class="w-6 h-6 text-green-600" />
                </div>
                <span class="text-2xl font-bold text-gray-900"><%= @selected_project.stats.completion_rate %>%</span>
              </div>
              <p class="text-sm text-gray-600">Completion Rate</p>
            </div>

            <div class="bg-white shadow rounded-xl p-6 border border-gray-200">
              <div class="flex items-center justify-between">
                <div class="w-12 h-12 rounded-xl bg-amber-100 flex items-center justify-center">
                  <.icon name="hero-clock" class="w-6 h-6 text-amber-600" />
                </div>
                <span class="text-2xl font-bold text-gray-900"><%= @selected_project.stats.active_attachees %></span>
              </div>
              <p class="text-sm text-gray-600">Active Attachees</p>
            </div>
          </div>

          <!-- Tabs -->
          <div class="bg-white shadow rounded-xl border border-gray-200">
            <div class="border-b border-gray-200">
              <div class="flex">
                <button phx-click="switch_tab" phx-value-tab="attachees" class={["px-6 py-4 text-sm font-medium", if(@active_tab == "attachees", do: "border-b-2 border-purple-600 text-purple-600", else: "text-gray-600 hover:bg-gray-50")]}>
                  Attachees (<%= length(@project_attachees) %>)
                </button>
                <button phx-click="switch_tab" phx-value-tab="tasks" class={["px-6 py-4 text-sm font-medium", if(@active_tab == "tasks", do: "border-b-2 border-purple-600 text-purple-600", else: "text-gray-600 hover:bg-gray-50")]}>
                  Tasks (<%= length(@project_tasks) %>)
                </button>
              </div>
            </div>

            <div class="p-6">
              <%= if @active_tab == "attachees" do %>
                <%= if @project_attachees == [] do %>
                  <div class="text-center py-16">
                    <div class="w-20 h-20 mx-auto mb-4 rounded-full bg-gray-100 flex items-center justify-center">
                      <.icon name="hero-user-group" class="w-10 h-10 text-gray-400" />
                    </div>
                    <h3 class="text-lg font-semibold text-gray-900">No attachees assigned</h3>
                    <p class="text-gray-600 mt-1">Assign attachees to this project to get started.</p>
                </div>
                <% else %>
                  <div class="grid gap-4">
                    <%= for attachee <- @project_attachees do %>
                      <.link phx-click="view_attachee_detail" phx-value-id={attachee.id} class="block bg-white shadow rounded-xl border border-gray-200 hover:shadow-lg hover:border-purple-300 transition">
                        <div class="p-6">
                          <div class="flex items-start justify-between">
                            <div class="flex-1">
                              <div class="flex items-center gap-3 mb-3">
                                <div class="w-12 h-12 rounded-xl bg-purple-100 flex items-center justify-center text-purple-700 font-bold text-lg">
                                  <%= String.first(attachee_name(attachee)) |> String.upcase() %>
                                </div>
                                <div>
                                  <h3 class="text-lg font-semibold text-gray-900"><%= attachee_name(attachee) %></h3>
                                  <span class="text-sm text-purple-700 font-medium"><%= attachee.position %></span>
                                </div>
                              </div>

                              <div class="flex items-center gap-6 text-sm text-gray-600">
                                <span class={["inline-flex items-center gap-1.5", if(attachee.status == "active", do: "text-green-800", else: "text-gray-600")]}>
                                  <.icon name="hero-check-circle" class={["w-4 h-4", if(attachee.status == "active", do: "text-green-600", else: "text-gray-600")]} />
                                  <%= String.capitalize(attachee.status) %>
                                </span>
                              </div>
                            </div>
                            <.icon name="hero-chevron-right" class="w-6 h-6 text-gray-400" />
                          </div>
                        </div>
                      </.link>
                    <% end %>
                  </div>
                <% end %>
              <% else %>
                <div class="flex justify-end mb-4">
                  <button phx-click="open_task_modal" class="bg-purple-600 text-white px-5 py-2.5 rounded-lg text-sm font-medium hover:bg-purple-700 transition shadow flex items-center gap-2">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                    </svg>
                    Add Task
                  </button>
                </div>
                <%= if @project_tasks == [] do %>
                  <div class="text-center py-16">
                    <div class="w-20 h-20 mx-auto mb-4 rounded-full bg-gray-100 flex items-center justify-center">
                      <.icon name="hero-clipboard-document" class="w-10 h-10 text-gray-400" />
                    </div>
                    <h3 class="text-lg font-semibold text-gray-900">No tasks yet</h3>
                    <p class="text-gray-600 mt-1">Create tasks for this project.</p>
                  </div>
                <% else %>
                  <div class="space-y-4">
                    <%= for task <- @project_tasks do %>
                      <div class="block bg-white shadow rounded-xl border border-gray-200 p-6">
                        <div class="flex items-start justify-between">
                          <div class="flex-1">
                            <h3 class="text-lg font-semibold text-gray-900"><%= task.title %></h3>
                            <%= if task.description do %>
                              <p class="text-sm text-gray-600 mt-1 line-clamp-2"><%= task.description %></p>
                            <% end %>
                            <div class="flex flex-wrap items-center gap-6 text-sm text-gray-600 mt-4">
                              <span class="flex items-center gap-1.5">
                                <.icon name="hero-user" class="w-4 h-4" />
                                <%= attachee_name(task.assignee) %>
                              </span>
                              <%= if task.due_on do %>
                                <span class="flex items-center gap-1.5">
                                  <.icon name="hero-calendar" class="w-4 h-4" />
                                  <%= Calendar.strftime(task.due_on, "%b %d, %Y") %>
                                </span>
                              <% end %>
                            </div>
                          </div>
                          <span class={["inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-medium", task_status_color(task.status)]}>
                            <%= String.capitalize(String.replace(task.status, "_", " ")) %>
                          </span>
                        </div>
                      </div>
                    <% end %>
                  </div>
                <% end %>
              <% end %>
            </div>
          </div>
        </div>
      <% else %>
        <!-- Header -->
        <div class="flex items-center justify-between">
          <div>
            <h1 class="text-3xl font-bold text-gray-900">Project Management</h1>
            <p class="text-gray-600 mt-1">Browse and manage your projects</p>
          </div>
          <div class="flex items-center gap-3">
            <button
              phx-click="refresh"
              class="flex items-center gap-2 px-4 py-2 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 transition"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
              </svg>
              Refresh
            </button>
            <button
              phx-click="new"
              class="flex items-center gap-2 px-4 py-2 bg-purple-600 text-white rounded-lg hover:bg-purple-700 transition shadow"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
              </svg>
              New Project
            </button>
          </div>
        </div>
        <!-- Search Bar -->
        <div class="bg-white rounded-xl shadow-sm p-4">
          <.form for={%{}} as={:search} phx-change="search">
            <div class="relative">
              <svg class="absolute left-3 top-1/2 transform -translate-y-1/2 w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
              </svg>
              <input
                type="text"
                name="query"
                value={@search_query}
                placeholder="Search projects..."
                class="w-full pl-10 pr-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-purple-500"
                phx-debounce="300"
              />
            </div>
          </.form>
        </div>
        <!-- Stats Overview -->
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
          <div class="bg-white rounded-xl shadow-sm p-6 border-l-4 border-purple-500">
            <div class="text-sm font-medium text-gray-600">Total Projects</div>
            <div class="text-3xl font-bold text-gray-900 mt-2"><%= length(@projects) %></div>
          </div>
          <div class="bg-white rounded-xl shadow-sm p-6 border-l-4 border-green-500">
            <div class="text-sm font-medium text-gray-600">Active Projects</div>
            <div class="text-3xl font-bold text-gray-900 mt-2">
              <%= Enum.count(@projects, fn p -> project_status(p) == :active end) %>
            </div>
          </div>
          <div class="bg-white rounded-xl shadow-sm p-6 border-l-4 border-blue-500">
            <div class="text-sm font-medium text-gray-600">Total Attachees</div>
            <div class="text-3xl font-bold text-gray-900 mt-2">
              <%= Enum.sum(Enum.map(@projects, fn p -> Map.get(p.stats || %{}, :total_attachees, 0) end)) %>
            </div>
          </div>
          <div class="bg-white rounded-xl shadow-sm p-6 border-l-4 border-amber-500">
            <div class="text-sm font-medium text-gray-600">Total Tasks</div>
            <div class="text-3xl font-bold text-gray-900 mt-2">
              <%= Enum.sum(Enum.map(@projects, fn p -> Map.get(p.stats || %{}, :total_tasks, 0) end)) %>
            </div>
          </div>
        </div>
        <!-- Projects Grid -->
        <%= if filtered_projects(@projects, @search_query) == [] do %>
          <div class="bg-white rounded-xl shadow-sm p-12 text-center">
            <svg class="w-16 h-16 mx-auto text-gray-400 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
            </svg>
            <h3 class="text-lg font-medium text-gray-900 mb-2">No projects found</h3>
            <p class="text-gray-600 mb-4">
              <%= if @search_query != "", do: "Try adjusting your search", else: "Get started by creating your first project" %>
            </p>
            <%= if @search_query == "" do %>
              <button
                phx-click="new"
                class="px-4 py-2 bg-purple-600 text-white rounded-lg hover:bg-purple-700 transition"
              >
                Create Your First Project
              </button>
            <% end %>
          </div>
        <% else %>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            <%= for project <- filtered_projects(@projects, @search_query) do %>
              <div class="relative group">
                <button
                  phx-click="view_project"
                  phx-value-id={project.id}
                  class="w-full bg-white rounded-xl shadow-sm hover:shadow-lg transition-all duration-200 overflow-hidden border border-gray-200 hover:border-purple-300 text-left"
                >
                  <!-- Card Header -->
                  <div class="bg-gradient-to-r from-indigo-600 to-purple-600 p-6">
                    <h3 class="text-xl font-bold text-white group-hover:scale-105 transition-transform">
                      <%= project.name %>
                    </h3>
                    <div class="flex items-center gap-2 mt-2 flex-wrap">
                      <%= if project.code do %>
                        <span class="inline-block px-3 py-1 bg-white/20 backdrop-blur-sm text-white text-xs font-medium rounded-full">
                          <%= project.code %>
                        </span>
                      <% end %>
                      <!-- Status Badge -->
                      <%= cond do %>
                        <% project.ends_on && Date.compare(project.ends_on, Date.utc_today()) == :lt -> %>
                          <span class="inline-block px-3 py-1 bg-blue-400/30 backdrop-blur-sm text-white text-xs font-medium rounded-full border border-white/20">Completed</span>
                        <% project.starts_on && Date.compare(project.starts_on, Date.utc_today()) == :lt -> %>
                          <span class="inline-block px-3 py-1 bg-amber-400/30 backdrop-blur-sm text-white text-xs font-medium rounded-full border border-white/20">In Progress</span>
                        <% true -> %>
                          <span class="inline-block px-3 py-1 bg-green-400/30 backdrop-blur-sm text-white text-xs font-medium rounded-full border border-white/20">Active</span>
                    <% end %>
                    </div>
                  </div>
                  <!-- Card Body -->
                  <div class="p-6 space-y-4">
                    <%= if project.description do %>
                      <p class="text-sm text-gray-600 line-clamp-2"><%= project.description %></p>
                    <% end %>
                    <!-- Project Details -->
                    <div class="space-y-2 text-sm">
                      <%= if Ecto.assoc_loaded?(project.program) && project.program do %>
                        <div class="flex items-center gap-2 text-gray-700">
                          <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"/>
                          </svg>
                          <span><%= project.program.name %></span>
                        </div>
                      <% end %>
                      <%= if Ecto.assoc_loaded?(project.supervisor) && project.supervisor do %>
                        <div class="flex items-center gap-2 text-gray-700">
                          <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                          </svg>
                          <span><%= project.supervisor.username || project.supervisor.email %></span>
                        </div>
                      <% end %>
                      <%= if Ecto.assoc_loaded?(project.organization) && project.organization do %>
                        <div class="flex items-center gap-2 text-gray-700">
                          <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h10"/>
                          </svg>
                          <span><%= project.organization.name %></span>
                        </div>
                      <% end %>
                      <%= if Ecto.assoc_loaded?(project.department) && project.department do %>
                        <div class="flex items-center gap-2 text-gray-700">
                          <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2M7 7h10"/>
                          </svg>
                          <span><%= project.department.name %></span>
                        </div>
                      <% end %>
                    </div>
                    <!-- Timeline -->
                    <%= if project.starts_on || project.ends_on do %>
                      <div class="pt-3 border-t border-gray-100">
                        <div class="flex items-center gap-2 text-sm text-gray-600">
                          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                          </svg>
                          <%= if project.starts_on do %>
                            <span><%= Calendar.strftime(project.starts_on, "%b %d, %Y") %></span>
                          <% end %>
                          <%= if project.starts_on && project.ends_on do %>
                            <span>-</span>
                          <% end %>
                          <%= if project.ends_on do %>
                            <span><%= Calendar.strftime(project.ends_on, "%b %d, %Y") %></span>
                          <% end %>
                        </div>
                      </div>
                    <% end %>
                  </div>
                  <!-- Card Footer -->
                  <div class="px-6 py-4 bg-gray-50 border-t border-gray-100">
                    <span class="text-purple-600 font-medium group-hover:translate-x-1 transition-transform inline-flex items-center gap-1 text-sm">
                      View Details
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                      </svg>
                    </span>
                  </div>
                </button>
                <!-- Quick Actions (Hover) -->
                <div class="absolute top-4 right-4 opacity-0 group-hover:opacity-100 transition-opacity flex gap-2 pointer-events-none group-hover:pointer-events-auto">
                  <button
                    type="button"
                    phx-click="edit_project"
                    phx-value-id={project.id}
                    class="p-2 bg-white rounded-lg shadow-lg hover:bg-purple-50 text-purple-600 transition z-10 pointer-events-auto"
                    title="Edit"
                  >
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                    </svg>
                  </button>
                  <button
                    type="button"
                    phx-click="delete_project"
                    phx-value-id={project.id}
                    data-confirm="Are you sure you want to delete this project?"
                    class="p-2 bg-white rounded-lg shadow-lg hover:bg-red-50 text-red-600 transition z-10 pointer-events-auto"
                    title="Delete"
                  >
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                    </svg>
                  </button>
                </div>
              </div>
            <% end %>
          </div>
        <% end %>
      <% end %>
    </div>
  </main>
</div>

<!-- Task Modal -->
<%= if @show_task_modal do %>
  <div class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4">
    <div class="bg-white rounded-xl shadow-xl max-w-2xl w-full max-h-[90vh] overflow-y-auto">
      <div class="px-6 py-4 border-b border-gray-200 flex items-center justify-between">
        <h2 class="text-xl font-bold text-gray-900">New Task</h2>
        <button phx-click="close_task_modal" class="text-gray-400 hover:text-gray-600 transition">
          <.icon name="hero-x-mark" class="w-6 h-6" />
        </button>
      </div>

      <form phx-submit="create_task" class="px-6 py-6 space-y-6">
        <%= if map_size(@task_errors) > 0 do %>
          <div class="bg-red-50 p-4 rounded-lg border border-red-200">
            <p class="text-sm text-red-600">Please fix the errors below</p>
          </div>
        <% end %>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">Title <span class="text-red-500">*</span></label>
          <input type="text" name="task[title]" value={@task_form["title"]} class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500" required />
          <%= if @task_errors[:title] do %>
            <p class="mt-1 text-sm text-red-600"><%= elem(@task_errors[:title], 0) %></p>
          <% end %>
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">Description</label>
          <textarea name="task[description]" rows="4" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500"><%= @task_form["description"] %></textarea>
          <%= if @task_errors[:description] do %>
            <p class="mt-1 text-sm text-red-600"><%= elem(@task_errors[:description], 0) %></p>
          <% end %>
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">Assign to <span class="text-red-500">*</span></label>
          <select name="task[assignee_id]" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500" required>
            <option value="">Select attachee</option>
            <%= for attachee <- @project_attachees do %>
              <option value={attachee.id} selected={@task_form["assignee_id"] == to_string(attachee.id)}>
                <%= attachee_name(attachee) %>
              </option>
            <% end %>
          </select>
          <%= if @task_errors[:assignee_id] do %>
            <p class="mt-1 text-sm text-red-600"><%= elem(@task_errors[:assignee_id], 0) %></p>
          <% end %>
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">Due Date</label>
          <input type="date" name="task[due_on]" value={@task_form["due_on"]} class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500" />
          <%= if @task_errors[:due_on] do %>
            <p class="mt-1 text-sm text-red-600"><%= elem(@task_errors[:due_on], 0) %></p>
          <% end %>
        </div>

        <div class="flex justify-end gap-3 pt-4 border-t border-gray-200">
          <button type="button" phx-click="close_task_modal" class="px-4 py-2 text-gray-700 border border-gray-300 rounded-lg hover:bg-gray-50">
            Cancel
          </button>
          <button type="submit" class="px-4 py-2 bg-purple-600 text-white rounded-lg hover:bg-purple-700">
            Create Task
          </button>
        </div>
      </form>
    </div>
  </div>
<% end %>

<!-- Attachee Modal -->
<%= if @show_attachee_modal && @selected_attachee do %>
  <div class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4">
    <div class="bg-white rounded-xl shadow-xl max-w-4xl w-full max-h-[90vh] overflow-y-auto">
      <div class="px-6 py-4 border-b border-gray-200 flex items-center justify-between">
        <h2 class="text-xl font-bold text-gray-900"><%= attachee_name(@selected_attachee) %> Profile</h2>
        <button phx-click="close_attachee_modal" class="text-gray-400 hover:text-gray-600 transition">
          <.icon name="hero-x-mark" class="w-6 h-6" />
        </button>
      </div>

      <div class="px-6 py-6 space-y-6">
        <!-- Compact Attachee Profile Card -->
        <div class="bg-white shadow rounded-xl overflow-hidden border border-gray-200">
          <div class="p-6">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-4">
                <!-- Avatar -->
                <div class="w-16 h-16 rounded-full bg-purple-600 flex items-center justify-center text-white text-2xl font-bold">
                  <%= if Ecto.assoc_loaded?(@selected_attachee.user) && @selected_attachee.user && @selected_attachee.user.username do %>
                    <%= String.first(@selected_attachee.user.username) |> String.upcase() %>
                  <% else %>
                    A
                  <% end %>
                </div>

                <div>
                  <h1 class="text-2xl font-bold text-gray-900"><%= attachee_name(@selected_attachee) %></h1>
                  <p class="text-sm text-gray-500 mt-1"><%= @selected_attachee.position %></p>
                  <div class="flex items-center gap-3 mt-2">
                    <span class={"inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium #{if @selected_attachee.status == "active", do: "bg-green-100 text-green-800", else: "bg-gray-100 text-gray-800"}"}>
                      <%= String.capitalize(@selected_attachee.status) %>
                    </span>
                    <%= if @attachee_eval_summary.total_evaluations > 0 do %>
                      <div class="flex items-center gap-2 text-sm text-gray-600">
                        <svg class="w-4 h-4 text-amber-500" fill="currentColor" viewBox="0 0 20 20">
                          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                        </svg>
                        <span class="font-semibold text-purple-600"><%= @attachee_eval_summary.average_score %></span>
                        <span class="text-gray-500">avg score</span>
                      </div>
                    <% end %>
                  </div>
                </div>
              </div>

              <button
                phx-click="open_attachee_eval_modal"
                class="bg-purple-600 text-white px-5 py-2.5 rounded-lg text-sm font-medium hover:bg-purple-700 transition shadow flex items-center gap-2"
              >
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                </svg>
                Evaluate
              </button>
            </div>

            <!-- Quick Stats -->
            <div class="grid grid-cols-4 gap-4 mt-6 pt-6 border-t border-gray-200">
              <div class="text-center">
                <div class="text-2xl font-bold text-gray-900"><%= @attachee_stats.total_projects %></div>
                <div class="text-xs text-gray-500 uppercase mt-1">Projects</div>
              </div>
              <div class="text-center">
                <div class="text-2xl font-bold text-gray-900"><%= @attachee_stats.completed_tasks %>/<%= @attachee_stats.total_tasks %></div>
                <div class="text-xs text-gray-500 uppercase mt-1">Tasks Done</div>
              </div>
              <div class="text-center">
                <div class="text-2xl font-bold text-green-600"><%= @attachee_stats.completion_rate %>%</div>
                <div class="text-xs text-gray-500 uppercase mt-1">Completion</div>
              </div>
              <div class="text-center">
                <div class="text-2xl font-bold text-purple-600"><%= @attachee_eval_summary.total_evaluations %></div>
                <div class="text-xs text-gray-500 uppercase mt-1">Evaluations</div>
              </div>
            </div>
          </div>
        </div>

        <!-- Tabs -->
        <div class="bg-white shadow rounded-xl overflow-hidden border border-gray-200">
          <div class="border-b border-gray-200">
            <div class="flex gap-1 p-2">
              <button
                phx-click="switch_attachee_tab"
                phx-value-tab="overview"
                class={[
                  "px-4 py-2 text-sm font-medium rounded-lg transition",
                  @attachee_active_tab == "overview" && "bg-purple-600 text-white",
                  @attachee_active_tab != "overview" && "text-gray-600 hover:bg-gray-100"
                ]}
              >
                Overview
              </button>
              <button
                phx-click="switch_attachee_tab"
                phx-value-tab="tasks"
                class={[
                  "px-4 py-2 text-sm font-medium rounded-lg transition",
                  @attachee_active_tab == "tasks" && "bg-purple-600 text-white",
                  @attachee_active_tab != "tasks" && "text-gray-600 hover:bg-gray-100"
                ]}
              >
                Tasks (<%= length(@attachee_tasks) %>)
              </button>
              <button
                phx-click="switch_attachee_tab"
                phx-value-tab="evaluations"
                class={[
                  "px-4 py-2 text-sm font-medium rounded-lg transition",
                  @attachee_active_tab == "evaluations" && "bg-purple-600 text-white",
                  @attachee_active_tab != "evaluations" && "text-gray-600 hover:bg-gray-100"
                ]}
              >
                Evaluations (<%= length(@attachee_evaluations) %>)
              </button>
            </div>
          </div>

          <!-- Tab Content -->
          <div class="p-6">
            <%= case @attachee_active_tab do %>
              <% "overview" -> %>
                <div class="space-y-6">
                  <!-- Personal Information -->
                  <div>
                    <h3 class="text-lg font-semibold text-gray-900 mb-4">Personal Information</h3>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                      <%= if Ecto.assoc_loaded?(@selected_attachee.user) && @selected_attachee.user do %>
                        <div class="bg-gray-50 rounded-lg p-4 border border-gray-200">
                          <div class="text-xs text-gray-500 font-medium uppercase mb-1">Email</div>
                          <div class="text-sm font-semibold text-gray-900"><%= @selected_attachee.user.email %></div>
                        </div>
                      <% end %>

                      <div class="bg-gray-50 rounded-lg p-4 border border-gray-200">
                        <div class="text-xs text-gray-500 font-medium uppercase mb-1">Position</div>
                        <div class="text-sm font-semibold text-gray-900"><%= @selected_attachee.position %></div>
                      </div>

                      <%= if @selected_attachee.starts_on do %>
                        <div class="bg-gray-50 rounded-lg p-4 border border-gray-200">
                          <div class="text-xs text-gray-500 font-medium uppercase mb-1">Start Date</div>
                          <div class="text-sm font-semibold text-gray-900">
                            <%= Calendar.strftime(@selected_attachee.starts_on, "%B %d, %Y") %>
                          </div>
                        </div>
                      <% end %>

                      <%= if @selected_attachee.ends_on do %>
                        <div class="bg-gray-50 rounded-lg p-4 border border-gray-200">
                          <div class="text-xs text-gray-500 font-medium uppercase mb-1">End Date</div>
                          <div class="text-sm font-semibold text-gray-900">
                            <%= Calendar.strftime(@selected_attachee.ends_on, "%B %d, %Y") %>
                          </div>
                        </div>
                      <% end %>

                      <%= if Ecto.assoc_loaded?(@selected_attachee.department) && @selected_attachee.department do %>
                        <div class="bg-gray-50 rounded-lg p-4 border border-gray-200">
                          <div class="text-xs text-gray-500 font-medium uppercase mb-1">Department</div>
                          <div class="text-sm font-semibold text-gray-900"><%= @selected_attachee.department.name %></div>
                        </div>
                      <% end %>

                      <%= if Ecto.assoc_loaded?(@selected_attachee.organization) && @selected_attachee.organization do %>
                        <div class="bg-gray-50 rounded-lg p-4 border border-gray-200">
                          <div class="text-xs text-gray-500 font-medium uppercase mb-1">Organization</div>
                          <div class="text-sm font-semibold text-gray-900"><%= @selected_attachee.organization.name %></div>
                        </div>
                      <% end %>
                    </div>
                  </div>

                  <!-- Performance Overview -->
                  <%= if @attachee_eval_summary.total_evaluations > 0 do %>
                    <div>
                      <h3 class="text-lg font-semibold text-gray-900 mb-4">Performance Overview</h3>
                      <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
                        <div class="bg-purple-50 p-4 rounded-lg border border-purple-200">
                          <div class="text-xs text-purple-600 font-medium uppercase">Average Score</div>
                          <div class={"text-3xl font-bold mt-2 #{score_color(@attachee_eval_summary.average_score)}"}><%= @attachee_eval_summary.average_score %></div>
                        </div>
                        <div class="bg-green-50 p-4 rounded-lg border border-green-200">
                          <div class="text-xs text-green-600 font-medium uppercase">Highest Score</div>
                          <div class="text-3xl font-bold text-green-600 mt-2"><%= @attachee_eval_summary.highest_score %></div>
                        </div>
                        <div class="bg-blue-50 p-4 rounded-lg border border-blue-200">
                          <div class="text-xs text-blue-600 font-medium uppercase">Latest Score</div>
                          <div class={"text-3xl font-bold mt-2 #{score_color(@attachee_eval_summary.latest_score)}"}><%= @attachee_eval_summary.latest_score %></div>
                        </div>
                        <div class="bg-amber-50 p-4 rounded-lg border border-amber-200">
                          <div class="text-xs text-amber-600 font-medium uppercase">Trend</div>
                          <div class="flex items-center gap-2 mt-2">
                            <%= Phoenix.HTML.raw(trend_icon(@attachee_eval_summary.trend)) %>
                            <span class="text-lg font-bold capitalize"><%= @attachee_eval_summary.trend %></span>
                          </div>
                        </div>
                      </div>
                    </div>
                  <% end %>
                </div>

              <% "tasks" -> %>
                <%= if @attachee_tasks == [] do %>
                  <div class="text-center py-12">
                    <svg class="w-16 h-16 mx-auto text-gray-300 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                    </svg>
                    <h3 class="text-lg font-medium text-gray-900 mb-2">No tasks yet</h3>
                    <p class="text-gray-500">Tasks will appear here when assigned</p>
                  </div>
                <% else %>
                  <div class="space-y-3">
                    <%= for task <- @attachee_tasks do %>
                      <div class="border border-gray-200 rounded-lg p-4 hover:bg-gray-50 transition">
                        <div class="flex items-start justify-between mb-2">
                          <div class="flex-1">
                            <h4 class="font-semibold text-gray-900 mb-1"><%= task.title %></h4>
                            <%= if task.description do %>
                              <p class="text-sm text-gray-600 mb-2"><%= task.description %></p>
                            <% end %>
                          </div>
                          <span class={"inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium #{task_status_color(task.status)}"}>
                            <%= String.capitalize(String.replace(task.status, "_", " ")) %>
                          </span>
                        </div>

                        <div class="flex items-center gap-4 text-sm text-gray-500">
                          <%= if Ecto.assoc_loaded?(task.project) && task.project do %>
                            <div class="flex items-center gap-1">
                              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"/>
                              </svg>
                              <span><%= task.project.name %></span>
                            </div>
                          <% end %>

                          <%= if task.due_on do %>
                            <div class="flex items-center gap-1">
                              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                              </svg>
                              <span>Due: <%= Calendar.strftime(task.due_on, "%b %d, %Y") %></span>
                            </div>
                          <% end %>
                        </div>
                      </div>
                    <% end %>
                  </div>
                <% end %>

              <% "evaluations" -> %>
                <%= if @attachee_evaluations == [] do %>
                  <div class="text-center py-12">
                    <svg class="w-16 h-16 mx-auto text-gray-300 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    <h3 class="text-lg font-medium text-gray-900 mb-2">No evaluations yet</h3>
                    <p class="text-gray-500 mb-4">Start by submitting the first evaluation</p>
                    <button
                      phx-click="open_attachee_eval_modal"
                      class="bg-purple-600 text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-purple-700 transition"
                    >
                      Submit Evaluation
                    </button>
                  </div>
                <% else %>
                  <!-- Evaluation Summary Stats -->
                  <div class="flex items-center justify-end gap-6 mb-6">
                    <div class="text-center">
                      <div class="text-2xl font-bold text-purple-600"><%= @attachee_eval_summary.average_score %></div>
                      <div class="text-xs text-gray-500 uppercase">Average Score</div>
                    </div>
                    <div class="text-center">
                      <div class="text-2xl font-bold text-gray-900"><%= @attachee_eval_summary.total_evaluations %></div>
                      <div class="text-xs text-gray-500 uppercase">Total Evaluations</div>
                    </div>
                  </div>

                  <!-- Evaluation List -->
                  <div class="space-y-4 max-h-[600px] overflow-y-auto">
                    <%= for evaluation <- @attachee_evaluations do %>
                      <div class="border border-gray-200 rounded-lg p-4 hover:bg-gray-50 transition">
                        <div class="flex justify-between items-start mb-3">
                          <div class="flex items-center gap-3">
                            <div class={"w-12 h-12 rounded-full flex items-center justify-center text-xl font-bold #{score_bg_color(evaluation.score)}"}>
                              <%= evaluation.score %>
                            </div>
                            <div>
                              <p class="font-semibold text-gray-900">
                                Score: <%= evaluation.score %>/100
                              </p>
                              <p class="text-sm text-gray-500">
                                <%= Calendar.strftime(evaluation.inserted_at, "%B %d, %Y at %I:%M %p") %>
                              </p>
                              <%= if Ecto.assoc_loaded?(evaluation.evaluator) && evaluation.evaluator do %>
                                <p class="text-sm text-gray-500">
                                  By: <%= evaluation.evaluator.username || evaluation.evaluator.email %>
                                </p>
                              <% end %>
                            </div>
                          </div>

                          <button
                            phx-click="view_evaluation"
                            phx-value-id={evaluation.id}
                            class="text-purple-600 hover:text-purple-700 text-sm font-medium"
                          >
                            View Details →
                          </button>
                        </div>

                        <%= if evaluation.comments do %>
                          <div class="bg-gray-50 p-3 rounded-lg border border-gray-200">
                            <p class="text-xs font-semibold text-gray-600 uppercase mb-1">Comments:</p>
                            <p class="text-sm text-gray-800"><%= evaluation.comments %></p>
                          </div>
                        <% end %>

                        <div class="flex justify-end mt-3">
                          <span class={"inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium #{score_bg_color(evaluation.score)}"}>
                            <%= score_label(evaluation.score) %>
                          </span>
                        </div>
                      </div>
                    <% end %>
                  </div>
                <% end %>
            <% end %>
          </div>
        </div>
      </div>

      <div class="px-6 py-4 border-t border-gray-200 flex justify-end">
        <button phx-click="close_attachee_modal" class="px-4 py-2 bg-purple-600 text-white rounded-lg hover:bg-purple-700">
          Close
        </button>
      </div>
    </div>
  </div>
<% end %>

<!-- Attachee Evaluation Modal -->
<%= if @show_attachee_eval_modal do %>
  <div class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4">
    <div class="bg-white rounded-xl shadow-xl max-w-2xl w-full max-h-[90vh] overflow-y-auto">
      <!-- Modal Header -->
      <div class="px-6 py-4 border-b border-gray-200 flex items-center justify-between">
        <div>
          <h2 class="text-xl font-bold text-gray-900">Evaluate <%= attachee_name(@selected_attachee) %></h2>
          <p class="text-sm text-gray-500 mt-1">Provide a score and detailed feedback</p>
        </div>
        <button phx-click="close_attachee_eval_modal" class="text-gray-400 hover:text-gray-600 transition">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>

      <!-- Modal Body -->
      <form phx-submit="submit_attachee_evaluation" phx-change="update_attachee_eval_form">
        <div class="px-6 py-4 space-y-6">
          <!-- Error Alert -->
          <%= if @attachee_eval_errors != %{} do %>
            <div class="bg-red-50 border border-red-200 rounded-lg p-4">
              <div class="flex items-start gap-3">
                <svg class="w-5 h-5 text-red-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <div>
                  <h3 class="text-sm font-semibold text-red-800">There were errors with your submission</h3>
                  <ul class="list-disc list-inside text-sm text-red-700 mt-2">
                    <%= for {field, message} <- @attachee_eval_errors do %>
                      <li><%= Phoenix.Naming.humanize(field) %>: <%= message %></li>
                    <% end %>
                  </ul>
                </div>
              </div>
            </div>
          <% end %>

          <!-- Score Input -->
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">
              Score <span class="text-red-600">*</span>
            </label>
            <input
              type="number"
              name="eval[score]"
              value={@attachee_eval_form["score"]}
              min="0"
              max="100"
              required
              placeholder="Enter score (0-100)"
              class={"w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent #{if @attachee_eval_errors[:score], do: "border-red-500", else: "border-gray-300"}"}
            />
            <%= if error = @attachee_eval_errors[:score] do %>
              <p class="text-sm text-red-600 mt-1"><%= error %></p>
            <% else %>
              <p class="text-sm text-gray-500 mt-1">Rate the attachee's performance from 0 to 100</p>
            <% end %>
          </div>

          <!-- Comments Textarea -->
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">
              Comments
            </label>
            <textarea
              name="eval[comments]"
              rows="6"
              placeholder="Provide detailed feedback about the attachee's performance, strengths, and areas for improvement..."
              class={"w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent #{if @attachee_eval_errors[:comments], do: "border-red-500", else: "border-gray-300"}"}
            ><%= @attachee_eval_form["comments"] %></textarea>
            <%= if error = @attachee_eval_errors[:comments] do %>
              <p class="text-sm text-red-600 mt-1"><%= error %></p>
            <% else %>
              <p class="text-sm text-gray-500 mt-1">Optional: Add specific feedback and observations</p>
            <% end %>
          </div>

          <!-- Score Guide -->
          <div class="bg-gray-50 rounded-lg p-4 border border-gray-200">
            <h4 class="text-sm font-semibold text-gray-900 mb-3">Scoring Guide</h4>
            <div class="space-y-2 text-sm">
              <div class="flex items-center gap-3">
                <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-green-100 text-green-800 w-20">81-100</span>
                <span class="text-gray-700">Excellent - Exceeds expectations</span>
              </div>
              <div class="flex items-center gap-3">
                <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-blue-100 text-blue-800 w-20">61-80</span>
                <span class="text-gray-700">Good - Meets expectations</span>
              </div>
              <div class="flex items-center gap-3">
                <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-amber-100 text-amber-800 w-20">41-60</span>
                <span class="text-gray-700">Satisfactory - Needs improvement</span>
              </div>
              <div class="flex items-center gap-3">
                <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-red-100 text-red-800 w-20">0-40</span>
                <span class="text-gray-700">Needs Improvement - Requires attention</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Modal Footer -->
        <div class="px-6 py-4 border-t border-gray-200 flex justify-end gap-3">
          <button
            type="button"
            phx-click="close_attachee_eval_modal"
            class="px-4 py-2 rounded-lg text-sm font-medium text-gray-700 hover:bg-gray-100 transition border border-gray-300"
          >
            Cancel
          </button>
          <button
            type="submit"
            class="bg-purple-600 text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-purple-700 transition shadow"
          >
            Submit Evaluation
          </button>
        </div>
      </form>
    </div>
  </div>
<% end %>

<!-- Evaluation Details Modal -->
<%= if @viewing_evaluation do %>
  <div class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4">
    <div class="bg-white rounded-xl shadow-xl max-w-3xl w-full max-h-[90vh] overflow-y-auto">
      <!-- Modal Header -->
      <div class="px-6 py-4 border-b border-gray-200 flex items-center justify-between">
        <div>
          <h2 class="text-xl font-bold text-gray-900">Evaluation Details</h2>
          <p class="text-sm text-gray-500 mt-1">
            Submitted <%= Calendar.strftime(@viewing_evaluation.inserted_at, "%B %d, %Y at %I:%M %p") %>
          </p>
        </div>
        <button phx-click="close_eval_view" class="text-gray-400 hover:text-gray-600 transition">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>

      <!-- Modal Body -->
      <div class="px-6 py-6 space-y-6">
        <!-- Score Display -->
        <div class="flex items-center justify-center">
          <div class="text-center">
            <div class={"w-32 h-32 rounded-full flex items-center justify-center text-5xl font-bold mx-auto #{score_bg_color(@viewing_evaluation.score)}"}>
              <%= @viewing_evaluation.score %>
            </div>
            <div class="text-2xl font-bold text-gray-900 mt-4">
              <%= @viewing_evaluation.score %> out of 100
            </div>
            <div class={"text-sm font-medium mt-2 #{score_color(@viewing_evaluation.score)}"}>
              <%= score_label(@viewing_evaluation.score) %>
            </div>
          </div>
        </div>

        <!-- Evaluator Info -->
        <div class="bg-gray-50 rounded-lg p-6 border border-gray-200">
          <h3 class="text-sm font-semibold text-gray-600 uppercase mb-4">Evaluator Information</h3>
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-full bg-purple-600 flex items-center justify-center text-white text-xl font-bold">
              <%= if @viewing_evaluation.evaluator && @viewing_evaluation.evaluator.username do %>
                <%= String.first(@viewing_evaluation.evaluator.username) |> String.upcase() %>
              <% else %>
                E
              <% end %>
            </div>
            <div>
              <div class="font-semibold text-gray-900">
                <%= if @viewing_evaluation.evaluator do %>
                  <%= @viewing_evaluation.evaluator.username || @viewing_evaluation.evaluator.email %>
                <% else %>
                  Unknown Evaluator
                <% end %>
              </div>
              <%= if @viewing_evaluation.evaluator && @viewing_evaluation.evaluator.email do %>
                <div class="text-sm text-gray-600"><%= @viewing_evaluation.evaluator.email %></div>
              <% end %>
            </div>
          </div>
        </div>

        <!-- Comments -->
        <%= if @viewing_evaluation.comments do %>
          <div class="bg-gray-50 rounded-lg p-6 border border-gray-200">
            <h3 class="text-sm font-semibold text-gray-600 uppercase mb-3">Feedback & Comments</h3>
            <div class="text-gray-800 whitespace-pre-wrap">
              <%= @viewing_evaluation.comments %>
            </div>
          </div>
        <% else %>
          <div class="bg-gray-50 rounded-lg p-6 text-center border border-gray-200">
            <svg class="w-12 h-12 mx-auto text-gray-300 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"/>
            </svg>
            <p class="text-sm text-gray-500">No comments provided for this evaluation</p>
          </div>
        <% end %>

        <!-- Metadata -->
        <div class="grid grid-cols-2 gap-4">
          <div class="bg-blue-50 p-4 rounded-lg border border-blue-200">
            <div class="text-xs text-blue-600 font-medium uppercase">Submitted On</div>
            <div class="text-lg font-bold text-blue-900 mt-1">
              <%= Calendar.strftime(@viewing_evaluation.inserted_at, "%B %d, %Y") %>
            </div>
            <div class="text-sm text-blue-700 mt-1">
              <%= Calendar.strftime(@viewing_evaluation.inserted_at, "%I:%M %p") %>
            </div>
          </div>

          <div class="bg-purple-50 p-4 rounded-lg border border-purple-200">
            <div class="text-xs text-purple-600 font-medium uppercase">Evaluation ID</div>
            <div class="text-lg font-bold text-purple-900 mt-1 font-mono">
              #<%= @viewing_evaluation.id %>
            </div>
          </div>
        </div>
      </div>

      <!-- Modal Footer -->
      <div class="px-6 py-4 border-t border-gray-200 flex justify-end">
        <button
          type="button"
          phx-click="close_eval_view"
          class="bg-purple-600 text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-purple-700 transition shadow"
        >
          Close
        </button>
      </div>
    </div>
  </div>

<% end %>

<%!-- Project Form Modal --%>
<%= if @show_form do %>
  <div class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4">
    <div class="bg-white rounded-xl shadow-xl max-w-2xl w-full max-h-[90vh] overflow-y-auto">
      <div class="px-6 py-4 border-b border-gray-200 flex items-center justify-between">
        <div>
          <h2 class="text-xl font-semibold text-gray-900">
            <%= if @editing_project, do: "Edit Project", else: "New Project" %>
          </h2>
          <%= if @editing_project do %>

            <p class="text-sm text-gray-500 mt-1">
              Editing: <%= @editing_project.name %>
            </p>
          <% end %>
        </div>
        <button
          phx-click="close"
          class="text-gray-400 hover:text-gray-600 transition-colors"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
      <%!-- Modal Body --%>
      <div class="px-6 py-4">
        <.form for={%{}} as={:project} phx-change="update" phx-submit="save">
          <div class="space-y-4">
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">
                Project Name <span class="text-red-500">*</span>
              </label>
              <input
                type="text"
                name="project[name]"
                value={@form_data["name"]}
                placeholder="Enter project name"
                required
                class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-purple-500"
              />
              <%= if @errors[:name] do %>
                <p class="mt-1 text-sm text-red-600"><%= elem(@errors[:name], 0) %></p>
              <% end %>
            </div>
            <%!-- Project Code --%>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">
                Project Code
              </label>
              <input
                type="text"
                name="project[code]"
                value={@form_data["code"]}
                placeholder="e.g., PROJ-001"
                class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-purple-500"
              />
              <p class="mt-1 text-xs text-gray-500">Optional unique identifier for this project</p>
              <%= if @errors[:code] do %>
                <p class="mt-1 text-sm text-red-600"><%= elem(@errors[:code], 0) %></p>
              <% end %>
            </div>
            <%!-- Description --%>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">
                Description
              </label>
              <textarea
                name="project[description]"
                rows="3"
                placeholder="Describe the project goals and objectives"
                class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-purple-500"
              ><%= @form_data["description"] %></textarea>
              <%= if @errors[:description] do %>
                <p class="mt-1 text-sm text-red-600"><%= elem(@errors[:description], 0) %></p>
              <% end %>
            </div>
            <%!-- Organization Selection --%>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">
                Organization <span class="text-red-500">*</span>
              </label>
              <select
                name="project[organization_id]"
                required
                class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-purple-500"
              >
                <option value="">Select an organization</option>
                <%= for org <- @orgs do %>
                  <option value={org.id} selected={@form_data["organization_id"] == to_string(org.id)}>
                    <%= org.name %>
                  </option>
                <% end %>
              </select>
              <%= if @errors[:organization_id] do %>
                <p class="mt-1 text-sm text-red-600"><%= elem(@errors[:organization_id], 0) %></p>
              <% end %>
            </div>
            <%!-- Department Selection --%>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">
                Department <span class="text-red-500">*</span>
              </label>
              <select
                name="project[department_id]"
                required
                class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-purple-500"
                disabled={@departments == []}
              >
                <option value="">
                  <%= if @departments == [], do: "Select organization first", else: "Select a department" %>
                </option>
                <%= for dept <- @departments do %>
                  <option value={dept.id} selected={@form_data["department_id"] == to_string(dept.id)}>
                    <%= dept.name %>
                  </option>
                <% end %>
              </select>
              <%= if @errors[:department_id] do %>
                <p class="mt-1 text-sm text-red-600"><%= elem(@errors[:department_id], 0) %></p>
              <% end %>
            </div>
            <%!-- Program Selection --%>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">
                Program <span class="text-red-500">*</span>
              </label>
              <select
                name="project[program_id]"
                required
                class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-purple-500"
                disabled={@programs == []}
              >
                <option value="">
                  <%= if @programs == [], do: "Select department first", else: "Select a program" %>
                </option>
                <%= for program <- @programs do %>
                  <option value={program.id} selected={@form_data["program_id"] == to_string(program.id)}>
                    <%= program.name %>
                  </option>
                <% end %>
              </select>
              <%= if @errors[:program_id] do %>
                <p class="mt-1 text-sm text-red-600"><%= elem(@errors[:program_id], 0) %></p>
              <% end %>
            </div>
            <%!-- Supervisor Selection --%>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">
                Supervisor
              </label>
              <select
                name="project[supervisor_id]"
                class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-purple-500"
              >
                <option value="">Select a supervisor</option>
                <%= for supervisor <- @supervisors do %>
                  <option value={supervisor.id} selected={@form_data["supervisor_id"] == to_string(supervisor.id)}>
                    <%= supervisor.username || supervisor.email %>
                  </option>
                <% end %>
              </select>
              <%= if @errors[:supervisor_id] do %>
                <p class="mt-1 text-sm text-red-600"><%= elem(@errors[:supervisor_id], 0) %></p>
              <% end %>
            </div>
            <%!-- Date Range --%>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">
                  Start Date
                </label>
                <input
                  type="date"
                  name="project[starts_on]"
                  value={@form_data["starts_on"]}
                  class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-purple-500"
                />
                <%= if @errors[:starts_on] do %>
                  <p class="mt-1 text-sm text-red-600"><%= elem(@errors[:starts_on], 0) %></p>
                <% end %>
              </div>
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">
                  End Date
                </label>
                <input
                  type="date"
                  name="project[ends_on]"
                  value={@form_data["ends_on"]}
                  class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-purple-500"
                />
                <%= if @errors[:ends_on] do %>
                  <p class="mt-1 text-sm text-red-600"><%= elem(@errors[:ends_on], 0) %></p>
                <% end %>
              </div>
            </div>
            <%!-- Date Range Error --%>
            <%= if @errors[:date_range] do %>
              <div class="p-3 bg-red-50 border border-red-200 rounded-lg">
                <p class="text-sm text-red-600"><%= @errors[:date_range] %></p>
              </div>
            <% end %>
          </div>

          <div class="flex items-center justify-end space-x-3 pt-4 border-t border-gray-200 px-6 py-4">
            <button
              type="button"
              phx-click="close"
              class="px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-purple-500 transition-colors"
            >
              Cancel
            </button>
            <button
              type="submit"
              class="px-4 py-2 text-sm font-medium text-white bg-purple-600 rounded-lg hover:bg-purple-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-purple-500 transition-colors"
            >
              <%= if @editing_project, do: "Update Project", else: "Create Project" %>
            </button>
          </div>
        </.form>
      </div>
    </div>
  </div>
<% end %>