<.live_component module={TrialAppWeb.SidebarComponent} id="sidebar" current_scope={@current_scope} />

<!-- Main Content -->
<main class="ml-64 w-full p-8">
  <div class="max-w-7xl mx-auto space-y-8">

    <!-- Header -->
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-2xl font-semibold text-gray-800">Project Management</h1>
        <p class="text-sm text-gray-500 mt-1">Manage and track all your organization's projects</p>
      </div>
      <button
        phx-click="new"
        class="bg-purple-600 text-white px-4 py-2 rounded-lg shadow hover:bg-purple-700 transition flex items-center gap-2"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
        </svg>
        Add Project
      </button>
    </div>

    <!-- Filter Tabs -->
    <div class="flex gap-2 border-b border-gray-200">
      <%= for {label, status} <- [
            {"All", "all"},
            {"Active", "active"},
            {"Inactive", "inactive"},
            {"Completed", "completed"}
          ] do %>
        <button
          phx-click="filter"
          phx-value-status={status}
          class={"px-4 py-2 text-sm font-medium border-b-2 transition #{if @filter_status == status, do: "border-purple-600 text-purple-600", else: "border-transparent text-gray-500 hover:text-gray-700"}"}
        >
          <%= label %>
          <span class="ml-1 text-xs bg-gray-100 px-2 py-0.5 rounded-full">
            <%= count_by_status(@projects, status) %>
          </span>
        </button>
      <% end %>
    </div>

    <!-- Stats Summary -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
      <div class="bg-purple-50 p-4 rounded-lg border border-purple-100">
        <div class="text-sm text-purple-600 font-medium">Total</div>
        <div class="text-2xl font-bold text-purple-700 mt-1"><%= length(@projects) %></div>
      </div>
      <div class="bg-green-50 p-4 rounded-lg border border-green-100">
        <div class="text-sm text-green-600 font-medium">Active</div>
        <div class="text-2xl font-bold text-green-700 mt-1">
          <%= Enum.count(@projects, & &1.is_active) %>
        </div>
      </div>
      <div class="bg-amber-50 p-4 rounded-lg border border-amber-100">
        <div class="text-sm text-amber-600 font-medium">In Progress</div>
        <div class="text-2xl font-bold text-amber-700 mt-1">
          <%= Enum.count(@projects, fn p ->
            p.starts_on && Date.compare(p.starts_on, Date.utc_today()) == :lt &&
            (!p.ends_on || Date.compare(p.ends_on, Date.utc_today()) != :lt)
          end) %>
        </div>
      </div>
      <div class="bg-blue-50 p-4 rounded-lg border border-blue-100">
        <div class="text-sm text-blue-600 font-medium">Completed</div>
        <div class="text-2xl font-bold text-blue-700 mt-1">
          <%= Enum.count(@projects, fn p -> p.ends_on && Date.compare(p.ends_on, Date.utc_today()) == :lt end) %>
        </div>
      </div>
    </div>

    <!-- Projects List -->
    <div class="bg-white shadow rounded-xl overflow-hidden">
      <%= if filtered_projects(@projects, @filter_status) == [] do %>
        <div class="py-12 text-center">
          <p class="text-gray-500 text-lg mb-2">No projects found</p>
          <p class="text-sm text-gray-400">
            <%= if @filter_status == "all" do %>
              Get started by adding your first project
            <% else %>
              Try changing the filter or add a new project
            <% end %>
          </p>
        </div>
      <% else %>
        <table class="min-w-full text-sm text-left text-gray-700">
          <thead class="bg-gray-100 text-xs uppercase">
            <tr>
              <th class="px-4 py-3">Project</th>
              <th class="px-4 py-3">Code</th>
              <th class="px-4 py-3">Organization</th>
              <th class="px-4 py-3">Department</th>
              <th class="px-4 py-3">Program</th>
              <th class="px-4 py-3">Supervisor</th>
              <th class="px-4 py-3">Timeline</th>
              <th class="px-4 py-3">Status</th>
              <th class="px-4 py-3 text-right">Actions</th>
            </tr>
          </thead>
          <tbody>
            <%= for project <- filtered_projects(@projects, @filter_status) do %>
              <tr class="border-t hover:bg-gray-50 transition">
                <td class="px-4 py-3">
                  <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-full bg-purple-100 flex items-center justify-center text-purple-700 font-bold text-sm">
                      <%= String.first(project.name || "?") |> String.upcase() %>
                    </div>
                    <div>
                      <div class="font-medium text-gray-900"><%= project.name %></div>
                      <%= if project.description do %>
                        <div class="text-xs text-gray-500 line-clamp-1"><%= project.description %></div>
                      <% end %>
                    </div>
                  </div>
                </td>
                <td class="px-4 py-3">
                  <span class="inline-flex items-center px-2 py-1 text-xs rounded-full bg-purple-100 text-purple-800">
                    <%= project.code %>
                  </span>
                </td>
                <td class="px-4 py-3"><%= get_assoc_name(project.organization) %></td>
                <td class="px-4 py-3"><%= get_assoc_name(project.department) %></td>
                <td class="px-4 py-3"><%= get_assoc_name(project.program) %></td>
                <td class="px-4 py-3">
                  <%= if project.supervisor do %>
                    <div class="flex items-center gap-2">
                      <div class="w-7 h-7 rounded-full bg-green-100 flex items-center justify-center text-green-700 text-xs font-bold">
                        <%= String.first(project.supervisor.username || project.supervisor.email || "?") |> String.upcase() %>
                      </div>
                      <span class="text-sm"><%= project.supervisor.username || project.supervisor.email %></span>
                    </div>
                  <% else %>
                    <span class="text-gray-400">Unassigned</span>
                  <% end %>
                </td>
                <td class="px-4 py-3">
                  <%= if project.starts_on do %>
                    <div class="text-sm">
                      <%= Calendar.strftime(project.starts_on, "%b %d, %Y") %>
                      <%= if project.ends_on do %>
                        <div class="text-xs text-gray-500">
                          to <%= Calendar.strftime(project.ends_on, "%b %d, %Y") %>
                        </div>
                      <% end %>
                    </div>
                  <% else %>
                    <span class="text-gray-400">Not set</span>
                  <% end %>
                </td>
                <td class="px-4 py-3">
                  <span class={"inline-flex items-center px-2 py-1 text-xs rounded-full font-medium #{status_color(project)}"}>
                    <%= status_label(project) %>
                  </span>
                </td>
                <td class="px-4 py-3">
                  <div class="flex items-center justify-end gap-2">
                    <button
                      phx-click="view_project"
                      phx-value-id={project.id}
                      class="p-1.5 hover:bg-purple-50 rounded text-purple-600"
                      title="View"
                    >
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                      </svg>
                    </button>
                    <button
                      phx-click="edit_project"
                      phx-value-id={project.id}
                      class="p-1.5 hover:bg-purple-50 rounded text-purple-600"
                      title="Edit"
                    >
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                      </svg>
                    </button>
                    <button
                      phx-click="delete_project"
                      phx-value-id={project.id}
                      data-confirm="Are you sure?"
                      class="p-1.5 hover:bg-red-50 rounded text-red-600"
                      title="Delete"
                    >
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                      </svg>
                    </button>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% end %>
    </div>
  </div>
</main>

<!-- VIEW MODAL -->
<%= if @show_view_modal && @viewing_project do %>
  <div class="fixed inset-0 z-50 overflow-y-auto" phx-click-away="close">
    <div class="fixed inset-0 bg-black bg-opacity-50"></div>
    <div class="flex min-h-full items-center justify-center p-4">
      <div
        class="relative bg-white rounded-xl shadow-2xl max-w-2xl w-full max-h-[90vh] overflow-y-auto"
        phx-click="stop_propagation"
      >
        <div class="sticky top-0 bg-white border-b border-gray-200 px-6 py-4 flex items-center justify-between rounded-t-xl">
          <h2 class="text-xl font-semibold text-gray-800"><%= @viewing_project.name %></h2>
          <button phx-click="close" class="text-gray-400 hover:text-gray-600">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
            </svg>
          </button>
        </div>
        <div class="px-6 py-4 space-y-4">
          <div class="grid grid-cols-2 gap-4 text-sm">
            <div><strong>Code:</strong> <%= @viewing_project.code %></div>
            <div><strong>Status:</strong> <span class={status_color(@viewing_project)}><%= status_label(@viewing_project) %></span></div>
            <div><strong>Org:</strong> <%= get_assoc_name(@viewing_project.organization) %></div>
            <div><strong>Dept:</strong> <%= get_assoc_name(@viewing_project.department) %></div>
            <div><strong>Program:</strong> <%= get_assoc_name(@viewing_project.program) %></div>
            <div><strong>Supervisor:</strong> <%= get_supervisor_name(@viewing_project.supervisor) %></div>
            <div><strong>Start:</strong> <%= format_date(@viewing_project.starts_on) %></div>
            <div><strong>End:</strong> <%= format_date(@viewing_project.ends_on) %></div>
          </div>
          <%= if @viewing_project.description do %>
            <div>
              <strong>Description:</strong>
              <p class="mt-1 text-gray-600"><%= @viewing_project.description %></p>
            </div>
          <% end %>
        </div>
        <div class="px-6 py-4 border-t flex justify-end gap-2">
          <button
            phx-click="edit_project"
            phx-value-id={@viewing_project.id}
            class="px-4 py-2 border border-purple-600 text-purple-600 rounded-lg hover:bg-purple-50"
          >Edit</button>
          <button phx-click="close" class="px-4 py-2 bg-purple-600 text-white rounded-lg hover:bg-purple-700">Close</button>
        </div>
      </div>
    </div>
  </div>
<% end %>

<!-- FORM MODAL -->
<%= if @show_form do %>
  <div class="fixed inset-0 z-50 overflow-y-auto" phx-click-away="close">
    <div class="fixed inset-0 bg-black bg-opacity-50"></div>
    <div class="flex min-h-full items-center justify-center p-4">
      <div
        class="relative bg-white rounded-xl shadow-2xl max-w-2xl w-full max-h-[90vh] overflow-y-auto"
        phx-click="stop_propagation"
      >
        <div class="sticky top-0 bg-white border-b border-gray-200 px-6 py-4 flex items-center justify-between rounded-t-xl">
          <h2 class="text-xl font-semibold text-gray-800">
            <%= if @editing_project, do: "Edit Project", else: "Add New Project" %>
          </h2>
          <button phx-click="close" class="text-gray-400 hover:text-gray-600">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
            </svg>
          </button>
        </div>
        <div class="px-6 py-4">
          <.form for={@form} phx-submit="save" phx-change="validate">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <.input field={@form[:name]} label="Project Name" required />
              <.input field={@form[:code]} label="Project Code" />
              <.input field={@form[:organization_id]} type="select" label="Organization" options={org_options(@orgs)} required />
              <.input field={@form[:department_id]} type="select" label="Department" options={dept_options(@departments)} required />
              <.input field={@form[:program_id]} type="select" label="Program" options={prog_options(@programs)} required />
              <.input field={@form[:supervisor_id]} type="select" label="Supervisor" options={sup_options(@supervisors)} required />
              <.input field={@form[:starts_on]} type="date" label="Start Date" />
              <.input field={@form[:ends_on]} type="date" label="End Date" />
              <.input field={@form[:description]} type="textarea" label="Description" rows="3" />
            </div>
            <div class="mt-6 flex justify-end gap-3">
              <button type="button" phx-click="close" class="px-4 py-2 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50">
                Cancel
              </button>
              <button type="submit" class="px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700">
                <%= if @editing_project, do: "Update", else: "Create" %>
              </button>
            </div>
          </.form>
        </div>
      </div>
    </div>
  </div>
<% end %>