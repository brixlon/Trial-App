<.live_component module={TrialAppWeb.SidebarComponent} id="sidebar" current_scope={@current_scope} />

<div class="ml-64 p-8">
  <div class="space-y-8">
    <!-- Header Section -->
    <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
      <div>
        <h1 class="text-3xl font-bold text-[#3B3B98]">Project Management</h1>
        <p class="text-sm text-gray-500 mt-1">Manage and track all your organization's projects</p>
      </div>
      <div class="flex gap-3">
        <button phx-click="new" class="px-4 py-2 rounded-lg bg-[#6C63FF] text-white hover:bg-[#5A52E8] transition flex items-center gap-2">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
          </svg>
          New Project
        </button>
      </div>
    </div>

    <!-- Stats Cards -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
      <div class="bg-gradient-to-br from-[#6C63FF] to-[#5A52E8] rounded-2xl p-5 text-white shadow-lg">
        <div class="flex items-center justify-between mb-2">
          <div class="w-12 h-12 rounded-xl bg-white/20 flex items-center justify-center">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
          </div>
          <span class="text-2xl font-bold"><%= length(@projects) %></span>
        </div>
        <p class="text-sm opacity-90">Total Projects</p>
      </div>

      <div class="bg-gradient-to-br from-emerald-500 to-emerald-600 rounded-2xl p-5 text-white shadow-lg">
        <div class="flex items-center justify-between mb-2">
          <div class="w-12 h-12 rounded-xl bg-white/20 flex items-center justify-center">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <span class="text-2xl font-bold"><%= Enum.count(@projects, & &1.is_active == true) %></span>
        </div>
        <p class="text-sm opacity-90">Active</p>
      </div>

      <div class="bg-gradient-to-br from-amber-500 to-amber-600 rounded-2xl p-5 text-white shadow-lg">
        <div class="flex items-center justify-between mb-2">
          <div class="w-12 h-12 rounded-xl bg-white/20 flex items-center justify-center">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <span class="text-2xl font-bold"><%= Enum.count(@projects, fn p -> p.starts_on && Date.compare(p.starts_on, Date.utc_today()) == :lt && (!p.ends_on || Date.compare(p.ends_on, Date.utc_today()) != :lt) end) %></span>
        </div>
        <p class="text-sm opacity-90">In Progress</p>
      </div>

      <div class="bg-gradient-to-br from-pink-500 to-pink-600 rounded-2xl p-5 text-white shadow-lg">
        <div class="flex items-center justify-between mb-2">
          <div class="w-12 h-12 rounded-xl bg-white/20 flex items-center justify-center">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
            </svg>
          </div>
          <span class="text-2xl font-bold"><%= Enum.count(@projects, fn p -> p.ends_on && Date.compare(p.ends_on, Date.utc_today()) == :lt end) %></span>
        </div>
        <p class="text-sm opacity-90">Completed</p>
      </div>
    </div>

    <!-- Projects Table -->
    <div class="bg-white shadow-lg rounded-2xl border border-gray-100 overflow-hidden">
      <%= if @projects == [] do %>
        <div class="py-12 text-center">
          <div class="flex flex-col items-center gap-3">
            <div class="w-20 h-20 rounded-full bg-[#F0EEFF] flex items-center justify-center">
              <svg class="w-10 h-10 text-[#6C63FF]/60" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
              </svg>
            </div>
            <div>
              <p class="font-semibold text-gray-700 text-lg">No projects yet</p>
              <p class="text-sm text-gray-500 mt-1">Get started by creating your first project</p>
            </div>
            <button phx-click="new" class="mt-2 px-5 py-2.5 rounded-lg bg-[#6C63FF] text-white font-medium hover:bg-[#5A52E8] transition">
              Create Your First Project
            </button>
          </div>
        </div>
      <% else %>
        <div class="overflow-x-auto">
          <table class="min-w-full text-left">
            <thead class="bg-[#6C63FF] text-white">
              <tr>
                <th class="px-6 py-4 text-sm font-semibold">PROJECT</th>
                <th class="px-6 py-4 text-sm font-semibold">CODE</th>
                <th class="px-6 py-4 text-sm font-semibold">ORGANIZATION</th>
                <th class="px-6 py-4 text-sm font-semibold">DEPARTMENT</th>
                <th class="px-6 py-4 text-sm font-semibold">PROGRAM</th>
                <th class="px-6 py-4 text-sm font-semibold">SUPERVISOR</th>
                <th class="px-6 py-4 text-sm font-semibold">TIMELINE</th>
                <th class="px-6 py-4 text-sm font-semibold">STATUS</th>
                <th class="px-6 py-4 text-sm font-semibold text-right">ACTIONS</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
              <%= for project <- @projects do %>
                <tr class="hover:bg-[#F8F8FF] transition group">
                  <td class="px-6 py-4">
                    <div class="flex items-center gap-3">
                      <div class="w-11 h-11 flex items-center justify-center rounded-full bg-gradient-to-br from-[#6C63FF] to-[#5A52E8] text-white font-bold shadow-md">
                        <%= String.first(project.name || "?") |> String.upcase() %>
                      </div>
                      <div>
                        <span class="text-gray-800 font-semibold block"><%= project.name %></span>
                        <%= if project.description do %>
                          <span class="text-xs text-gray-500 line-clamp-1"><%= project.description %></span>
                        <% end %>
                      </div>
                    </div>
                  </td>
                  <td class="px-6 py-4">
                    <span class="inline-flex items-center px-3 py-1.5 text-sm rounded-full bg-[#E8E7FF] text-[#3B3B98] font-medium">
                      <%= project.code %>
                    </span>
                  </td>
                  <td class="px-6 py-4">
                    <span class="text-gray-700 font-medium">
                      <%= if Ecto.assoc_loaded?(project.organization) && project.organization, do: project.organization.name, else: "—" %>
                    </span>
                  </td>
                  <td class="px-6 py-4">
                    <span class="text-gray-700 font-medium">
                      <%= if Ecto.assoc_loaded?(project.department) && project.department, do: project.department.name, else: "—" %>
                    </span>
                  </td>
                  <td class="px-6 py-4">
                    <span class="text-gray-700 font-medium">
                      <%= if Ecto.assoc_loaded?(project.program) && project.program, do: project.program.name, else: "—" %>
                    </span>
                  </td>
                  <td class="px-6 py-4">
                    <div class="flex items-center gap-2">
                      <%= if Ecto.assoc_loaded?(project.supervisor) && project.supervisor do %>
                        <div class="w-8 h-8 flex items-center justify-center rounded-full bg-gradient-to-br from-emerald-400 to-emerald-500 text-white text-xs font-bold">
                          <%= String.first(project.supervisor.username || project.supervisor.email || "?") |> String.upcase() %>
                        </div>
                        <span class="text-gray-700 text-sm">
                          <%= project.supervisor.username || project.supervisor.email %>
                        </span>
                      <% else %>
                        <div class="w-8 h-8 flex items-center justify-center rounded-full bg-gray-300 text-white text-xs font-bold">
                          ?
                        </div>
                        <span class="text-gray-500 text-sm">
                          Unassigned
                        </span>
                      <% end %>
                    </div>
                  </td>
                  <td class="px-6 py-4">
                    <div class="text-sm text-gray-600">
                      <%= if project.starts_on do %>
                        <div class="flex items-center gap-1.5">
                          <svg class="w-3.5 h-3.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                          </svg>
                          <%= Calendar.strftime(project.starts_on, "%b %d, %Y") %>
                        </div>
                      <% end %>
                      <%= if project.ends_on do %>
                        <div class="flex items-center gap-1.5 mt-1">
                          <svg class="w-3.5 h-3.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
                          </svg>
                          <%= Calendar.strftime(project.ends_on, "%b %d, %Y") %>
                        </div>
                      <% end %>
                      <%= if !project.starts_on && !project.ends_on do %>
                        <span class="text-gray-400">Not set</span>
                      <% end %>
                    </div>
                  </td>
                  <td class="px-6 py-4">
                    <%= cond do %>
                      <% project.is_active == false -> %>
                        <span class="inline-flex items-center gap-1.5 px-3 py-1.5 text-sm rounded-full font-medium bg-gray-100 text-gray-600">
                          <span class="w-1.5 h-1.5 rounded-full bg-gray-400"></span>
                          Inactive
                        </span>
                      <% project.ends_on && Date.compare(project.ends_on, Date.utc_today()) == :lt -> %>
                        <span class="inline-flex items-center gap-1.5 px-3 py-1.5 text-sm rounded-full font-medium bg-blue-50 text-blue-700">
                          <span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span>
                          Completed
                        </span>
                      <% project.starts_on && Date.compare(project.starts_on, Date.utc_today()) == :lt -> %>
                        <span class="inline-flex items-center gap-1.5 px-3 py-1.5 text-sm rounded-full font-medium bg-amber-50 text-amber-700">
                          <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
                          In Progress
                        </span>
                      <% true -> %>
                        <span class="inline-flex items-center gap-1.5 px-3 py-1.5 text-sm rounded-full font-medium bg-emerald-50 text-emerald-700">
                          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                          Active
                        </span>
                    <% end %>
                  </td>
                  <td class="px-6 py-4">
                    <div class="flex items-center justify-end gap-2 opacity-0 group-hover:opacity-100 transition">
                      <button
                        phx-click="view_project"
                        phx-value-id={project.id}
                        class="p-2 hover:bg-[#E8E7FF] rounded-lg transition"
                        title="View Details"
                      >
                        <svg class="w-4 h-4 text-[#6C63FF]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                        </svg>
                      </button>
                      <button
                        phx-click="edit_project"
                        phx-value-id={project.id}
                        class="p-2 hover:bg-[#E8E7FF] rounded-lg transition"
                        title="Edit"
                      >
                        <svg class="w-4 h-4 text-[#6C63FF]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                        </svg>
                      </button>
                      <button
                        phx-click="delete_project"
                        phx-value-id={project.id}
                        data-confirm="Are you sure you want to delete this project?"
                        class="p-2 hover:bg-red-50 rounded-lg transition"
                        title="Delete"
                      >
                        <svg class="w-4 h-4 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                        </svg>
                      </button>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>
    </div>
  </div>
</div>

<!-- ========== VIEW MODAL ========== -->
<%= if @show_view_modal && @viewing_project do %>
  <div class="fixed inset-0 bg-black/60 backdrop-blur-sm flex items-center justify-center p-4 z-50">
    <div class="bg-white rounded-2xl w-full max-w-3xl shadow-2xl">
      <!-- Modal Header -->
      <div class="flex items-center justify-between p-6 border-b border-gray-200">
        <div class="flex items-center gap-4">
          <div class="w-16 h-16 flex items-center justify-center rounded-full bg-gradient-to-br from-[#6C63FF] to-[#5A52E8] text-white font-bold text-2xl shadow-lg">
            <%= String.first(@viewing_project.name || "?") |> String.upcase() %>
          </div>
          <div>
            <h2 class="text-2xl font-bold text-[#3B3B98]"><%= @viewing_project.name %></h2>
            <p class="text-sm text-gray-500 mt-1">Project Details</p>
          </div>
        </div>
        <button phx-click="close" class="p-2 hover:bg-gray-100 rounded-lg transition-colors">
          <svg class="w-6 h-6 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>

      <!-- Modal Body -->
      <div class="p-6 max-h-[calc(100vh-200px)] overflow-y-auto">
        <div class="space-y-6">
          <!-- Status Badge -->
          <div class="flex items-center gap-3">
            <span class="text-sm font-semibold text-gray-500">Status:</span>
            <%= cond do %>
              <% @viewing_project.is_active == false -> %>
                <span class="inline-flex items-center gap-1.5 px-3 py-1.5 text-sm rounded-full font-medium bg-gray-100 text-gray-600">
                  <span class="w-1.5 h-1.5 rounded-full bg-gray-400"></span>
                  Inactive
                </span>
              <% @viewing_project.ends_on && Date.compare(@viewing_project.ends_on, Date.utc_today()) == :lt -> %>
                <span class="inline-flex items-center gap-1.5 px-3 py-1.5 text-sm rounded-full font-medium bg-blue-50 text-blue-700">
                  <span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span>
                  Completed
                </span>
              <% @viewing_project.starts_on && Date.compare(@viewing_project.starts_on, Date.utc_today()) == :lt -> %>
                <span class="inline-flex items-center gap-1.5 px-3 py-1.5 text-sm rounded-full font-medium bg-amber-50 text-amber-700">
                  <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
                  In Progress
                </span>
              <% true -> %>
                <span class="inline-flex items-center gap-1.5 px-3 py-1.5 text-sm rounded-full font-medium bg-emerald-50 text-emerald-700">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                  Active
                </span>
            <% end %>
          </div>

          <!-- Project Details Grid -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- Project Code -->
            <div class="bg-gray-50 rounded-xl p-4">
              <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1">Project Code</p>
              <p class="text-lg font-bold text-[#3B3B98]"><%= @viewing_project.code || "—" %></p>
            </div>

            <!-- Organization -->
            <div class="bg-gray-50 rounded-xl p-4">
              <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1">Organization</p>
              <p class="text-lg font-semibold text-gray-800">
                <%= if Ecto.assoc_loaded?(@viewing_project.organization) && @viewing_project.organization do %>
                  <%= @viewing_project.organization.name %>
                <% else %>
                  —
                <% end %>
              </p>
            </div>

            <!-- Department -->
            <div class="bg-gray-50 rounded-xl p-4">
              <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1">Department</p>
              <p class="text-lg font-semibold text-gray-800">
                <%= if Ecto.assoc_loaded?(@viewing_project.department) && @viewing_project.department do %>
                  <%= @viewing_project.department.name %>
                <% else %>
                  —
                <% end %>
              </p>
            </div>

            <!-- Program -->
            <div class="bg-gray-50 rounded-xl p-4">
              <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1">Program</p>
              <p class="text-lg font-semibold text-gray-800">
                <%= if Ecto.assoc_loaded?(@viewing_project.program) && @viewing_project.program do %>
                  <%= @viewing_project.program.name %>
                <% else %>
                  —
                <% end %>
              </p>
            </div>

            <!-- Start Date -->
            <div class="bg-gray-50 rounded-xl p-4">
              <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1">Start Date</p>
              <p class="text-lg font-semibold text-gray-800">
                <%= if @viewing_project.starts_on do %>
                  <%= Calendar.strftime(@viewing_project.starts_on, "%B %d, %Y") %>
                <% else %>
                  Not set
                <% end %>
              </p>
            </div>

            <!-- End Date -->
            <div class="bg-gray-50 rounded-xl p-4">
              <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1">End Date</p>
              <p class="text-lg font-semibold text-gray-800">
                <%= if @viewing_project.ends_on do %>
                  <%= Calendar.strftime(@viewing_project.ends_on, "%B %d, %Y") %>
                <% else %>
                  Not set
                <% end %>
              </p>
            </div>
          </div>

          <!-- Supervisor -->
          <div class="bg-gradient-to-r from-emerald-50 to-emerald-100 rounded-xl p-4 border border-emerald-200">
            <p class="text-xs font-semibold text-emerald-700 uppercase tracking-wide mb-2">Supervisor</p>
            <%= if Ecto.assoc_loaded?(@viewing_project.supervisor) && @viewing_project.supervisor do %>
              <div class="flex items-center gap-3">
                <div class="w-12 h-12 flex items-center justify-center rounded-full bg-gradient-to-br from-emerald-400 to-emerald-500 text-white font-bold shadow-md">
                  <%= String.first(@viewing_project.supervisor.username || @viewing_project.supervisor.email || "?") |> String.upcase() %>
                </div>
                <div>
                  <p class="font-bold text-gray-800"><%= @viewing_project.supervisor.username || @viewing_project.supervisor.email %></p>
                  <%= if @viewing_project.supervisor.email do %>
                    <p class="text-sm text-gray-600"><%= @viewing_project.supervisor.email %></p>
                  <% end %>
                </div>
              </div>
            <% else %>
              <p class="text-gray-600">No supervisor assigned</p>
            <% end %>
          </div>

          <!-- Description -->
          <%= if @viewing_project.description do %>
            <div>
              <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-2">Description</p>
              <div class="bg-gray-50 rounded-xl p-4 border border-gray-200">
                <p class="text-gray-700 leading-relaxed"><%= @viewing_project.description %></p>
              </div>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Modal Footer -->
      <div class="flex items-center justify-end gap-3 p-6 border-t border-gray-200">
        <button 
          phx-click="edit_project"
          phx-value-id={@viewing_project.id}
          class="px-6 py-2.5 rounded-lg border border-[#6C63FF] text-[#6C63FF] font-medium hover:bg-[#F0EEFF] transition-colors"
        >
          Edit Project
        </button>
        <button 
          phx-click="close"
          class="px-6 py-2.5 rounded-lg bg-[#6C63FF] text-white font-medium hover:bg-[#5A52E8] transition-colors"
        >
          Close
        </button>
      </div>
    </div>
  </div>
<% end %>

<!-- ========== FORM MODAL ========== -->
<%= if @show_form do %>
  <div class="fixed inset-0 bg-black/60 backdrop-blur-sm flex items-center justify-center p-4 z-50">
    <div class="bg-white rounded-2xl w-full max-w-2xl shadow-2xl">
      <!-- Modal Header -->
      <div class="flex items-center justify-between p-6 border-b border-gray-200">
        <div>
          <h2 class="text-2xl font-bold text-[#3B3B98]">
            <%= if @editing_project, do: "Edit Project", else: "Create New Project" %>
          </h2>
          <p class="text-sm text-gray-500 mt-1">
            <%= if @editing_project, do: "Update project details", else: "Fill in the details to get started" %>
          </p>
        </div>
        <button phx-click="close" class="p-2 hover:bg-gray-100 rounded-lg transition-colors">
          <svg class="w-6 h-6 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>

      <!-- Modal Body -->
      <div class="p-6 max-h-[calc(100vh-200px)] overflow-y-auto">
        <!-- Global Error Display -->
        <%= if @errors != %{} do %>
          <div class="mb-4 bg-red-50 border border-red-200 rounded-lg p-4">
            <div class="flex items-start gap-2">
              <svg class="w-5 h-5 text-red-500 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
              <div class="flex-1">
                <h3 class="text-sm font-semibold text-red-800 mb-1">Please fix the following errors:</h3>
                <ul class="list-disc list-inside text-sm text-red-700 space-y-1">
                  <%= for {field, error} <- @errors do %>
                    <li>
                      <strong><%= field |> to_string() |> String.replace("_", " ") |> String.capitalize() %>:</strong>
                      <%= if is_tuple(error), do: elem(error, 0), else: error %>
                    </li>
                  <% end %>
                </ul>
              </div>
            </div>
          </div>
        <% end %>

        <.form for={to_form(@form_data, as: :project)} id="project-form" phx-submit="save" phx-change="update">
          <div class="space-y-5">
            <!-- Project Name -->
            <div class="space-y-2">
              <label class="block text-sm font-semibold text-gray-700">
                Project Name <span class="text-red-500">*</span>
              </label>
              <input 
                name="project[name]" 
                value={@form_data["name"]} 
                class={"w-full border rounded-lg px-4 py-2.5 focus:ring-2 focus:ring-[#6C63FF] focus:border-transparent transition-all #{if @errors[:name], do: "border-red-500", else: "border-gray-300"}"} 
                placeholder="Enter project name"
                required 
              />
              <%= if @errors[:name] do %>
                <p class="text-sm text-red-600 mt-1"><%= if is_tuple(@errors[:name]), do: elem(@errors[:name], 0), else: @errors[:name] %></p>
              <% end %>
            </div>

            <!-- Date Range with Validation -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div class="space-y-2">
                <label class="block text-sm font-semibold text-gray-700">
                  Start Date
                  <span class="text-xs font-normal text-gray-500 ml-2">(Optional)</span>
                </label>
                <input 
                  type="date" 
                  name="project[starts_on]" 
                  value={@form_data["starts_on"]} 
                  class={"w-full border rounded-lg px-4 py-2.5 focus:ring-2 focus:ring-[#6C63FF] focus:border-transparent transition-all #{if @errors[:starts_on] || @errors[:date_range], do: "border-red-500", else: "border-gray-300"}"} 
                />
                <%= if @errors[:starts_on] do %>
                  <p class="text-sm text-red-600 mt-1"><%= elem(@errors[:starts_on], 0) %></p>
                <% end %>
              </div>
              <div class="space-y-2">
                <label class="block text-sm font-semibold text-gray-700">
                  End Date
                  <span class="text-xs font-normal text-gray-500 ml-2">(Optional)</span>
                </label>
                <input 
                  type="date" 
                  name="project[ends_on]" 
                  value={@form_data["ends_on"]} 
                  class={"w-full border rounded-lg px-4 py-2.5 focus:ring-2 focus:ring-[#6C63FF] focus:border-transparent transition-all #{if @errors[:ends_on] || @errors[:date_range], do: "border-red-500", else: "border-gray-300"}"} 
                />
                <%= if @errors[:ends_on] do %>
                  <p class="text-sm text-red-600 mt-1"><%= elem(@errors[:ends_on], 0) %></p>
                <% end %>
              </div>
            </div>

            <!-- Date Range Error (if any) -->
            <%= if @errors[:date_range] do %>
              <div class="bg-red-50 border border-red-200 rounded-lg p-3 flex items-start gap-2">
                <svg class="w-5 h-5 text-red-500 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
                <p class="text-sm text-red-700"><%= @errors[:date_range] %></p>
              </div>
            <% end %>

            <!-- Project Code -->
            <div class="space-y-2">
              <label class="block text-sm font-semibold text-gray-700">Project Code</label>
              <input 
                name="project[code]" 
                value={@form_data["code"]} 
                class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:ring-2 focus:ring-[#6C63FF] focus:border-transparent transition-all" 
                placeholder="e.g., PROJ-2024-001"
              />
            </div>

            <!-- Supervisor -->
            <div class="space-y-2">
              <label class="block text-sm font-semibold text-gray-700">
                Supervisor <span class="text-red-500">*</span>
              </label>
              <select 
                name="project[supervisor_id]" 
                class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:ring-2 focus:ring-[#6C63FF] focus:border-transparent transition-all" 
                required
              >
                <option value="">Select a supervisor</option>
                <%= for s <- @supervisors do %>
                  <option value={s.id} selected={to_string(s.id) == @form_data["supervisor_id"]}>
                    <%= s.username || s.email %>
                  </option>
                <% end %>
              </select>
            </div>

            <!-- Organization -->
            <div class="space-y-2">
              <label class="block text-sm font-semibold text-gray-700">
                Organization <span class="text-red-500">*</span>
              </label>
              <select 
                name="project[organization_id]" 
                class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:ring-2 focus:ring-[#6C63FF] focus:border-transparent transition-all" 
                required
              >
                <option value="">Select organization</option>
                <%= for o <- @orgs do %>
                  <option value={o.id} selected={to_string(o.id) == @form_data["organization_id"]}>
                    <%= o.name %>
                  </option>
                <% end %>
              </select>
            </div>

            <!-- Department and Program -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div class="space-y-2">
                <label class="block text-sm font-semibold text-gray-700">
                  Department <span class="text-red-500">*</span>
                </label>
                <select 
                  name="project[department_id]" 
                  class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:ring-2 focus:ring-[#6C63FF] focus:border-transparent transition-all" 
                  required
                >
                  <option value="">Select department</option>
                  <%= for d <- @departments do %>
                    <option value={d.id} selected={to_string(d.id) == @form_data["department_id"]}>
                      <%= d.name %>
                    </option>
                  <% end %>
                </select>
              </div>

              <div class="space-y-2">
                <label class="block text-sm font-semibold text-gray-700">
                  Program <span class="text-red-500">*</span>
                </label>
                <select 
                  name="project[program_id]" 
                  class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:ring-2 focus:ring-[#6C63FF] focus:border-transparent transition-all" 
                  required
                >
                  <option value="">Select program</option>
                  <%= for p <- @programs do %>
                    <option value={p.id} selected={to_string(p.id) == @form_data["program_id"]}>
                      <%= p.name %>
                    </option>
                  <% end %>
                </select>
              </div>
            </div>

            <!-- Description -->
            <div class="space-y-2">
              <label class="block text-sm font-semibold text-gray-700">Description</label>
              <textarea 
                name="project[description]" 
                class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:ring-2 focus:ring-[#6C63FF] focus:border-transparent transition-all resize-none" 
                rows="4"
                placeholder="Describe the project goals and objectives..."
              ><%= @form_data["description"] %></textarea>
            </div>
          </div>

          <!-- Modal Footer -->
          <div class="flex items-center justify-end gap-3 mt-6 pt-6 border-t border-gray-200">
            <button 
              type="button" 
              phx-click="close" 
              class="px-6 py-2.5 rounded-lg border border-gray-300 text-gray-700 font-medium hover:bg-gray-50 transition-colors"
            >
              Cancel
            </button>
            <button 
              type="submit" 
              class="px-6 py-2.5 rounded-lg bg-[#6C63FF] text-white font-medium hover:bg-[#5A52E8] transition-colors"
            >
              <%= if @editing_project, do: "Update Project", else: "Create Project" %>
            </button>
          </div>
        </.form>
      </div>
    </div>
  </div>
<% end %>