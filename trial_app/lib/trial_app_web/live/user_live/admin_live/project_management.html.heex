<div class="min-h-screen bg-white text-gray-900">
  <div class="flex">
    <!-- Sidebar -->
    <.live_component
      module={TrialAppWeb.SidebarComponent}
      id="sidebar"
      current_scope={@current_scope}
    />

    <!-- Main content -->
    <main class="ml-64 w-full p-8">
      <div class="max-w-7xl mx-auto space-y-8">
        <!-- Header -->
        <div class="flex items-center justify-between">
          <div>
            <h1 class="text-2xl font-semibold text-gray-800">Project Management</h1>
            <p class="text-sm text-gray-500 mt-1">Manage and track all your organization's projects</p>
          </div>
          <button
            phx-click="new"
            class="bg-purple-600 text-white px-4 py-2 rounded-lg shadow hover:bg-purple-700 transition"
          >
            <%= if @show_form, do: "Close Form", else: "New Project" %>
          </button>
        </div>

        <!-- Stats Summary -->
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
          <div class="bg-purple-50 p-4 rounded-lg border border-purple-100">
            <div class="text-sm text-purple-600 font-medium">Total Projects</div>
            <div class="text-2xl font-bold text-purple-700 mt-1"><%= length(@projects) %></div>
          </div>
          <div class="bg-green-50 p-4 rounded-lg border border-green-100">
            <div class="text-sm text-green-600 font-medium">Active</div>
            <div class="text-2xl font-bold text-green-700 mt-1">
              <%= Enum.count(@projects, & &1.is_active == true) %>
            </div>
          </div>
          <div class="bg-amber-50 p-4 rounded-lg border border-amber-100">
            <div class="text-sm text-amber-600 font-medium">In Progress</div>
            <div class="text-2xl font-bold text-amber-700 mt-1">
              <%= Enum.count(@projects, fn p -> p.starts_on && Date.compare(p.starts_on, Date.utc_today()) == :lt && (!p.ends_on || Date.compare(p.ends_on, Date.utc_today()) != :lt) end) %>
            </div>
          </div>
          <div class="bg-blue-50 p-4 rounded-lg border border-blue-100">
            <div class="text-sm text-blue-600 font-medium">Completed</div>
            <div class="text-2xl font-bold text-blue-700 mt-1">
              <%= Enum.count(@projects, fn p -> p.ends_on && Date.compare(p.ends_on, Date.utc_today()) == :lt end) %>
            </div>
          </div>
        </div>

        <!-- Project Form Modal -->
        <%= if @show_form do %>
          <div class="fixed inset-0 bg-black/60 backdrop-blur-sm flex items-center justify-center p-4 z-50">
            <div class="bg-white rounded-2xl w-full max-w-3xl shadow-2xl max-h-[90vh] flex flex-col">
              <!-- Modal Header -->
              <div class="flex items-center justify-between px-8 py-6 border-b border-gray-200 flex-shrink-0">
                <div>
                  <h2 class="text-2xl font-bold text-gray-900">
                    <%= if @editing_project, do: "Edit Project", else: "Create New Project" %>
                  </h2>
                  <p class="text-sm text-gray-500 mt-1">
                    <%= if @editing_project, do: "Update project details", else: "Fill in the details to get started" %>
                  </p>
                </div>
                <button phx-click="close" class="p-2 hover:bg-gray-100 rounded-lg transition-colors group">
                  <svg class="w-6 h-6 text-gray-400 group-hover:text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                  </svg>
                </button>
              </div>

              <!-- Modal Body -->
              <div class="px-8 py-6 overflow-y-auto flex-1">
                <!-- Global Error Banner -->
                <%= if @errors != %{} and map_size(@errors) > 0 do %>
                  <div class="mb-6 bg-red-50 border-l-4 border-red-500 rounded-lg p-4">
                    <div class="flex items-start gap-3">
                      <svg class="w-5 h-5 text-red-500 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
                      </svg>
                      <div class="flex-1">
                        <h3 class="text-sm font-semibold text-red-800 mb-1">Please fix the following errors:</h3>
                        <ul class="text-sm text-red-700 space-y-1">
                          <%= for {field, error} <- @errors do %>
                            <li class="flex items-start gap-1">
                              <span class="mt-1">•</span>
                              <span>
                                <strong class="font-medium"><%= field |> to_string() |> String.replace("_", " ") |> String.capitalize() %>:</strong>
                                <%= if is_tuple(error), do: elem(error, 0), else: error %>
                              </span>
                            </li>
                          <% end %>
                        </ul>
                      </div>
                    </div>
                  </div>
                <% end %>

                <form id="project-form" phx-submit="save" phx-change="update">
                  <div class="space-y-6">
                    <!-- Project Name -->
                    <div>
                      <label class="block text-sm font-semibold text-gray-700 mb-2">
                        Project Name <span class="text-red-500">*</span>
                      </label>
                      <input
                        name="project[name]"
                        value={@form_data["name"]}
                        class="w-full border border-gray-300 rounded-lg px-4 py-3 text-sm focus:ring-2 focus:ring-purple-500 focus:border-purple-500 transition-all"
                        placeholder="Enter project name"
                        required
                      />
                      <%= if @errors[:name] do %>
                        <p class="mt-2 text-sm text-red-600 flex items-center gap-1">
                          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
                          </svg>
                          <%= if is_tuple(@errors[:name]), do: elem(@errors[:name], 0), else: @errors[:name] %>
                        </p>
                      <% end %>
                    </div>

                    <!-- Project Code -->
                    <div>
                      <label class="block text-sm font-semibold text-gray-700 mb-2">
                        Project Code
                      </label>
                      <input
                        name="project[code]"
                        value={@form_data["code"]}
                        class={"w-full border rounded-lg px-4 py-3 text-sm focus:ring-2 focus:border-purple-500 transition-all #{if @errors[:code], do: "border-red-300 bg-red-50 focus:ring-red-500", else: "border-gray-300 focus:ring-purple-500"}"}
                        placeholder="e.g., PROJ-001, P-2024-001, or any unique code"
                      />
                      <%= if @errors[:code] do %>
                        <p class="mt-2 text-sm text-red-600 flex items-center gap-1">
                          <svg class="w-4 h-4 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
                          </svg>
                          <%= if is_tuple(@errors[:code]), do: elem(@errors[:code], 0), else: @errors[:code] %>
                        </p>
                      <% else %>
                        <p class="mt-1.5 text-xs text-gray-500">Must be unique within this organization</p>
                      <% end %>
                    </div>

                    <!-- Organization, Department, Program Row -->
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                      <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-2">
                          Organization <span class="text-red-500">*</span>
                        </label>
                        <select
                          name="project[organization_id]"
                          class="w-full border border-gray-300 rounded-lg px-4 py-3 text-sm focus:ring-2 focus:ring-purple-500 focus:border-purple-500 transition-all bg-white"
                          required
                        >
                          <option value="">Select organization</option>
                          <%= for org <- @orgs do %>
                            <option value={org.id} selected={to_string(org.id) == @form_data["organization_id"]}>
                              <%= org.name %>
                            </option>
                          <% end %>
                        </select>
                      </div>

                      <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-2">
                          Department <span class="text-red-500">*</span>
                        </label>
                        <select
                          name="project[department_id]"
                          class="w-full border border-gray-300 rounded-lg px-4 py-3 text-sm focus:ring-2 focus:ring-purple-500 focus:border-purple-500 transition-all bg-white"
                          required
                        >
                          <option value="">Select department</option>
                          <%= for dept <- @departments do %>
                            <option value={dept.id} selected={to_string(dept.id) == @form_data["department_id"]}>
                              <%= dept.name %>
                            </option>
                          <% end %>
                        </select>
                      </div>

                      <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-2">
                          Program <span class="text-red-500">*</span>
                        </label>
                        <select
                          name="project[program_id]"
                          class="w-full border border-gray-300 rounded-lg px-4 py-3 text-sm focus:ring-2 focus:ring-purple-500 focus:border-purple-500 transition-all bg-white"
                          required
                        >
                          <option value="">Select program</option>
                          <%= for prog <- @programs do %>
                            <option value={prog.id} selected={to_string(prog.id) == @form_data["program_id"]}>
                              <%= prog.name %>
                            </option>
                          <% end %>
                        </select>
                      </div>
                    </div>

                    <!-- Supervisor -->
                    <div>
                      <label class="block text-sm font-semibold text-gray-700 mb-2">
                        Supervisor <span class="text-red-500">*</span>
                      </label>
                      <select
                        name="project[supervisor_id]"
                        class="w-full border border-gray-300 rounded-lg px-4 py-3 text-sm focus:ring-2 focus:ring-purple-500 focus:border-purple-500 transition-all bg-white"
                        required
                      >
                        <option value="">Select supervisor</option>
                        <%= for sup <- @supervisors do %>
                          <option value={sup.id} selected={to_string(sup.id) == @form_data["supervisor_id"]}>
                            <%= sup.username || sup.email %>
                          </option>
                        <% end %>
                      </select>
                    </div>

                    <!-- Start & End Date -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                      <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-2">Start Date</label>
                        <input
                          type="date"
                          name="project[starts_on]"
                          value={@form_data["starts_on"]}
                          class="w-full border border-gray-300 rounded-lg px-4 py-3 text-sm focus:ring-2 focus:ring-purple-500 focus:border-purple-500 transition-all"
                        />
                      </div>

                      <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-2">End Date</label>
                        <input
                          type="date"
                          name="project[ends_on]"
                          value={@form_data["ends_on"]}
                          class="w-full border border-gray-300 rounded-lg px-4 py-3 text-sm focus:ring-2 focus:ring-purple-500 focus:border-purple-500 transition-all"
                        />
                      </div>
                    </div>

                    <!-- Description -->
                    <div>
                      <label class="block text-sm font-semibold text-gray-700 mb-2">Description</label>
                      <textarea
                        name="project[description]"
                        class="w-full border border-gray-300 rounded-lg px-4 py-3 text-sm resize-none focus:ring-2 focus:ring-purple-500 focus:border-purple-500 transition-all"
                        rows="4"
                        placeholder="Describe the project goals and objectives..."
                      ><%= @form_data["description"] %></textarea>
                    </div>
                  </div>
                </form>
              </div>

              <!-- Modal Footer -->
              <div class="flex items-center justify-end gap-3 px-8 py-6 border-t border-gray-200 bg-gray-50 rounded-b-2xl flex-shrink-0">
                <button
                  type="button"
                  phx-click="close"
                  class="px-6 py-2.5 rounded-lg border-2 border-gray-300 text-gray-700 font-medium hover:bg-gray-100 transition-colors"
                >
                  Cancel
                </button>
                <button
                  type="submit"
                  form="project-form"
                  class="px-6 py-2.5 rounded-lg bg-purple-600 text-white font-medium hover:bg-purple-700 shadow-lg shadow-purple-500/30 transition-all"
                >
                  <%= if @editing_project, do: "Update Project", else: "Save Project" %>
                </button>
              </div>
            </div>
          </div>
        <% end %>

        <!-- Projects Table -->
        <div class="bg-white shadow rounded-xl overflow-hidden">
          <%= if @projects == [] do %>
            <div class="py-12 text-center">
              <p class="text-gray-500 text-lg mb-2">No projects yet</p>
              <p class="text-sm text-gray-400 mb-4">Get started by creating your first project</p>
              <button
                phx-click="new"
                class="px-4 py-2 rounded-lg bg-purple-600 text-white hover:bg-purple-700 transition"
              >
                Create Your First Project
              </button>
            </div>
          <% else %>
            <table class="min-w-full text-sm text-left text-gray-700">
              <thead class="bg-gray-100 text-xs uppercase">
                <tr>
                  <th class="px-4 py-3">Project</th>
                  <th class="px-4 py-3">Code</th>
                  <th class="px-4 py-3">Organization</th>
                  <th class="px-4 py-3">Department</th>
                  <th class="px-4 py-3">Program</th>
                  <th class="px-4 py-3">Supervisor</th>
                  <th class="px-4 py-3">Timeline</th>
                  <th class="px-4 py-3">Status</th>
                  <th class="px-4 py-3 text-right">Actions</th>
                </tr>
              </thead>
              <tbody>
                <%= for project <- @projects do %>
                  <tr class="border-t hover:bg-gray-50 transition">
                    <td class="px-4 py-3">
                      <div class="font-medium text-gray-900"><%= project.name %></div>
                      <%= if project.description do %>
                        <div class="text-xs text-gray-500 line-clamp-1"><%= project.description %></div>
                      <% end %>
                    </td>
                    <td class="px-4 py-3">
                      <%= if project.code do %>
                        <span class="inline-flex items-center px-2 py-1 text-xs rounded-full bg-purple-100 text-purple-800">
                          <%= project.code %>
                        </span>
                      <% else %>
                        <span class="text-gray-400">—</span>
                      <% end %>
                    </td>
                    <td class="px-4 py-3">
                      <%= if Ecto.assoc_loaded?(project.organization) && project.organization do %>
                        <%= project.organization.name %>
                      <% else %>
                        <span class="text-gray-400">—</span>
                      <% end %>
                    </td>
                    <td class="px-4 py-3">
                      <%= if Ecto.assoc_loaded?(project.department) && project.department do %>
                        <span class="inline-flex items-center px-2 py-1 text-xs rounded-full bg-purple-100 text-purple-800">
                          <%= project.department.name %>
                        </span>
                      <% else %>
                        <span class="text-gray-400">—</span>
                      <% end %>
                    </td>
                    <td class="px-4 py-3">
                      <%= if Ecto.assoc_loaded?(project.program) && project.program do %>
                        <%= project.program.name %>
                      <% else %>
                        <span class="text-gray-400">—</span>
                      <% end %>
                    </td>
                    <td class="px-4 py-3">
                      <%= if Ecto.assoc_loaded?(project.supervisor) && project.supervisor do %>
                        <%= project.supervisor.username || project.supervisor.email %>
                      <% else %>
                        <span class="text-gray-400">—</span>
                      <% end %>
                    </td>
                    <td class="px-4 py-3">
                      <%= if project.starts_on do %>
                        <div class="text-sm">
                          <%= Calendar.strftime(project.starts_on, "%b %d, %Y") %>
                          <%= if project.ends_on do %>
                            <div class="text-xs text-gray-500">
                              to <%= Calendar.strftime(project.ends_on, "%b %d, %Y") %>
                            </div>
                          <% end %>
                        </div>
                      <% else %>
                        <span class="text-gray-400">Not set</span>
                      <% end %>
                    </td>
                    <td class="px-4 py-3">
                      <%= cond do %>
                        <% project.is_active == false -> %>
                          <span class="inline-flex items-center px-2 py-1 text-xs rounded-full font-medium bg-gray-100 text-gray-800">
                            Inactive
                          </span>
                        <% project.ends_on && Date.compare(project.ends_on, Date.utc_today()) == :lt -> %>
                          <span class="inline-flex items-center px-2 py-1 text-xs rounded-full font-medium bg-blue-100 text-blue-800">
                            Completed
                          </span>
                        <% project.starts_on && Date.compare(project.starts_on, Date.utc_today()) == :lt -> %>
                          <span class="inline-flex items-center px-2 py-1 text-xs rounded-full font-medium bg-amber-100 text-amber-800">
                            In Progress
                          </span>
                        <% true -> %>
                          <span class="inline-flex items-center px-2 py-1 text-xs rounded-full font-medium bg-green-100 text-green-800">
                            Active
                          </span>
                      <% end %>
                    </td>
                    <td class="px-4 py-3">
                      <div class="flex items-center justify-end gap-2">
                        <button
                          phx-click="view_project"
                          phx-value-id={project.id}
                          class="p-1.5 hover:bg-purple-50 rounded text-purple-600"
                          title="View"
                        >
                          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                          </svg>
                        </button>
                        <button
                          phx-click="edit_project"
                          phx-value-id={project.id}
                          class="p-1.5 hover:bg-purple-50 rounded text-purple-600"
                          title="Edit"
                        >
                          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                          </svg>
                        </button>
                        <button
                          phx-click="delete_project"
                          phx-value-id={project.id}
                          data-confirm="Are you sure you want to delete this project?"
                          class="p-1.5 hover:bg-red-50 rounded text-red-600"
                          title="Delete"
                        >
                          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                          </svg>
                        </button>
                      </div>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          <% end %>
        </div>
      </div>
    </main>
  </div>

<!-- View Modal -->
<%= if @show_view_modal && @viewing_project do %>
  <div class="fixed inset-0 bg-black/50 flex items-center justify-center p-4 z-50">
    <div class="bg-white rounded-xl w-full max-w-2xl shadow-xl">
      <!-- Modal Header -->
      <div class="flex items-center justify-between p-6 border-b border-gray-200">
        <div>
          <h2 class="text-xl font-semibold text-gray-800"><%= @viewing_project.name %></h2>
          <p class="text-sm text-gray-500 mt-1">Project Details</p>
        </div>
        <button phx-click="close" class="p-2 hover:bg-gray-100 rounded-lg">
          <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>

      <!-- Modal Body -->
      <div class="p-6 space-y-4">
        <!-- Status -->
        <div>
          <span class="text-sm font-medium text-gray-500">Status: </span>
          <%= cond do %>
            <% @viewing_project.is_active == false -> %>
              <span class="inline-flex items-center px-2 py-1 text-xs rounded-full font-medium bg-gray-100 text-gray-800">
                Inactive
              </span>
            <% @viewing_project.ends_on && Date.compare(@viewing_project.ends_on, Date.utc_today()) == :lt -> %>
              <span class="inline-flex items-center px-2 py-1 text-xs rounded-full font-medium bg-blue-100 text-blue-800">
                Completed
              </span>
            <% @viewing_project.starts_on && Date.compare(@viewing_project.starts_on, Date.utc_today()) == :lt -> %>
              <span class="inline-flex items-center px-2 py-1 text-xs rounded-full font-medium bg-amber-100 text-amber-800">
                In Progress
              </span>
            <% true -> %>
              <span class="inline-flex items-center px-2 py-1 text-xs rounded-full font-medium bg-green-100 text-green-800">
                Active
              </span>
          <% end %>
        </div>

        <!-- Details Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="bg-gray-50 rounded-lg p-3">
            <p class="text-xs text-gray-500 font-medium mb-1">Project Code</p>
            <p class="text-sm font-semibold text-gray-800">
              <%= @viewing_project.code || "—" %>
            </p>
          </div>

          <div class="bg-gray-50 rounded-lg p-3">
            <p class="text-xs text-gray-500 font-medium mb-1">Organization</p>
            <p class="text-sm font-semibold text-gray-800">
              <%= if Ecto.assoc_loaded?(@viewing_project.organization) && @viewing_project.organization do %>
                <%= @viewing_project.organization.name %>
              <% else %>
                —
              <% end %>
            </p>
          </div>

          <div class="bg-gray-50 rounded-lg p-3">
            <p class="text-xs text-gray-500 font-medium mb-1">Department</p>
            <p class="text-sm font-semibold text-gray-800">
              <%= if Ecto.assoc_loaded?(@viewing_project.department) && @viewing_project.department do %>
                <%= @viewing_project.department.name %>
              <% else %>
                —
              <% end %>
            </p>
          </div>

          <div class="bg-gray-50 rounded-lg p-3">
            <p class="text-xs text-gray-500 font-medium mb-1">Program</p>
            <p class="text-sm font-semibold text-gray-800">
              <%= if Ecto.assoc_loaded?(@viewing_project.program) && @viewing_project.program do %>
                <%= @viewing_project.program.name %>
              <% else %>
                —
              <% end %>
            </p>
          </div>

          <div class="bg-gray-50 rounded-lg p-3">
            <p class="text-xs text-gray-500 font-medium mb-1">Supervisor</p>
            <p class="text-sm font-semibold text-gray-800">
              <%= if Ecto.assoc_loaded?(@viewing_project.supervisor) && @viewing_project.supervisor do %>
                <%= @viewing_project.supervisor.username || @viewing_project.supervisor.email %>
              <% else %>
                —
              <% end %>
            </p>
          </div>

          <div class="bg-gray-50 rounded-lg p-3">
            <p class="text-xs text-gray-500 font-medium mb-1">Start Date</p>
            <p class="text-sm font-semibold text-gray-800">
              <%= if @viewing_project.starts_on do %>
                <%= Calendar.strftime(@viewing_project.starts_on, "%B %d, %Y") %>
              <% else %>
                Not set
              <% end %>
            </p>
          </div>

          <div class="bg-gray-50 rounded-lg p-3">
            <p class="text-xs text-gray-500 font-medium mb-1">End Date</p>
            <p class="text-sm font-semibold text-gray-800">
              <%= if @viewing_project.ends_on do %>
                <%= Calendar.strftime(@viewing_project.ends_on, "%B %d, %Y") %>
              <% else %>
                Not set
              <% end %>
            </p>
          </div>
        </div>

        <!-- Description -->
        <%= if @viewing_project.description do %>
          <div>
            <p class="text-xs text-gray-500 font-medium mb-2">Description</p>
            <div class="bg-gray-50 rounded-lg p-3 border border-gray-200">
              <p class="text-sm text-gray-700"><%= @viewing_project.description %></p>
            </div>
          </div>
        <% end %>
      </div>

      <!-- Modal Footer -->
      <div class="flex items-center justify-end gap-3 p-6 border-t border-gray-200">
        <button
          phx-click="edit_project"
          phx-value-id={@viewing_project.id}
          class="px-4 py-2 rounded-lg border border-purple-600 text-purple-600 hover:bg-purple-50 transition"
        >
          Edit Project
        </button>
        <button
          phx-click="close"
          class="px-4 py-2 rounded-lg bg-purple-600 text-white hover:bg-purple-700 transition"
        >
          Close
        </button>
      </div>
    </div>
  </div>
<% end %>
</div>