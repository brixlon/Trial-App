<div class="min-h-screen bg-gray-50">
  <div class="flex">
    <!-- Sidebar -->
    <.live_component
      module={TrialAppWeb.SidebarComponent}
      id="sidebar"
      current_scope={@current_scope}
    />

    <!-- Main Content -->
    <main class="ml-64 w-full p-8">
      <div class="max-w-7xl mx-auto space-y-6">
        
        <%= if @show_detail_view do %>
          <%!-- DETAIL VIEW: Hierarchical Drill-Down --%>
          
          <%!-- Breadcrumb Navigation --%>
          <div class="flex items-center gap-2 text-sm">
            <button
              phx-click="back_to_projects"
              class="text-purple-600 hover:text-purple-700 font-medium flex items-center gap-1"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
              </svg>
              Projects
            </button>
            
            <%= if @selected_project do %>
              <span class="text-gray-400">/</span>
              <%= if @detail_level == "attachees" do %>
                <span class="text-gray-700 font-medium"><%= @selected_project.name %></span>
              <% else %>
                <button
                  phx-click="back_to_attachees"
                  class="text-purple-600 hover:text-purple-700 font-medium"
                >
                  <%= @selected_project.name %>
                </button>
              <% end %>
            <% end %>
            
            <%= if @detail_level == "tasks" && @selected_attachee do %>
              <span class="text-gray-400">/</span>
              <span class="text-gray-700 font-medium"><%= attachee_name(@selected_attachee) %></span>
            <% end %>
          </div>

          <%= cond do %>
            <%!-- LEVEL 1: Project Detail with Attachees --%>
            <% @detail_level == "attachees" -> %>
              <%!-- Project Header --%>
              <div class="bg-gradient-to-r from-indigo-600 to-purple-600 rounded-2xl shadow-xl p-8 text-white">
                <div class="flex items-start justify-between">
                  <div class="flex-1">
                    <h1 class="text-4xl font-bold mb-2"><%= @selected_project.name %></h1>
                    <div class="flex items-center gap-3 mb-4">
                      <%= if @selected_project.code do %>
                        <span class="inline-block px-3 py-1 bg-white/20 backdrop-blur-sm text-sm font-medium rounded-full">
                          <%= @selected_project.code %>
                        </span>
                      <% end %>
                      
                      <%!-- Status Badge --%>
                      <%= case project_status(@selected_project) do %>
                        <% :active -> %>
                          <span class="inline-block px-3 py-1 bg-green-400/30 backdrop-blur-sm text-white text-sm font-medium rounded-full border border-white/30">
                            Active
                          </span>
                        <% :upcoming -> %>
                          <span class="inline-block px-3 py-1 bg-blue-400/30 backdrop-blur-sm text-white text-sm font-medium rounded-full border border-white/30">
                            Upcoming
                          </span>
                        <% :completed -> %>
                          <span class="inline-block px-3 py-1 bg-gray-400/30 backdrop-blur-sm text-white text-sm font-medium rounded-full border border-white/30">
                            Completed
                          </span>
                        <% :inactive -> %>
                          <span class="inline-block px-3 py-1 bg-red-400/30 backdrop-blur-sm text-white text-sm font-medium rounded-full border border-white/30">
                            Inactive
                          </span>
                      <% end %>
                    </div>
                    
                    <%= if @selected_project.description do %>
                      <p class="mt-4 text-purple-100 text-lg"><%= @selected_project.description %></p>
                    <% end %>
                    
                    <%!-- Project Details --%>
                    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-6">
                      <%= if Ecto.assoc_loaded?(@selected_project.program) && @selected_project.program do %>
                        <div class="bg-white/10 backdrop-blur-sm rounded-lg p-3">
                          <div class="text-xs text-purple-200">Program</div>
                          <div class="font-medium"><%= @selected_project.program.name %></div>
                        </div>
                      <% end %>
                      
                      <%= if Ecto.assoc_loaded?(@selected_project.supervisor) && @selected_project.supervisor do %>
                        <div class="bg-white/10 backdrop-blur-sm rounded-lg p-3">
                          <div class="text-xs text-purple-200">Supervisor</div>
                          <div class="font-medium"><%= @selected_project.supervisor.username || @selected_project.supervisor.email %></div>
                        </div>
                      <% end %>
                      
                      <%= if @selected_project.starts_on do %>
                        <div class="bg-white/10 backdrop-blur-sm rounded-lg p-3">
                          <div class="text-xs text-purple-200">Start Date</div>
                          <div class="font-medium"><%= Calendar.strftime(@selected_project.starts_on, "%b %d, %Y") %></div>
                        </div>
                      <% end %>
                      
                      <%= if @selected_project.ends_on do %>
                        <div class="bg-white/10 backdrop-blur-sm rounded-lg p-3">
                          <div class="text-xs text-purple-200">End Date</div>
                          <div class="font-medium"><%= Calendar.strftime(@selected_project.ends_on, "%b %d, %Y") %></div>
                        </div>
                      <% end %>
                    </div>
                  </div>
                </div>
              </div>

              <%!-- Project Stats --%>
              <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div class="bg-white rounded-xl shadow-sm p-6 border-l-4 border-purple-500">
                  <div class="flex items-center justify-between">
                    <div>
                      <div class="text-sm font-medium text-gray-600">Total Attachees</div>
                      <div class="text-3xl font-bold text-gray-900 mt-2">
                        <%= Map.get(@selected_project.stats || %{}, :total_attachees, 0) %>
                      </div>
                    </div>
                    <div class="w-12 h-12 bg-purple-100 rounded-full flex items-center justify-center">
                      <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
                      </svg>
                    </div>
                  </div>
                </div>
                
                <div class="bg-white rounded-xl shadow-sm p-6 border-l-4 border-blue-500">
                  <div class="flex items-center justify-between">
                    <div>
                      <div class="text-sm font-medium text-gray-600">Total Tasks</div>
                      <div class="text-3xl font-bold text-gray-900 mt-2">
                        <%= Map.get(@selected_project.stats || %{}, :total_tasks, 0) %>
                      </div>
                    </div>
                    <div class="w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center">
                      <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                      </svg>
                    </div>
                  </div>
                </div>
                
                <div class="bg-white rounded-xl shadow-sm p-6 border-l-4 border-green-500">
                  <div class="flex items-center justify-between">
                    <div>
                      <div class="text-sm font-medium text-gray-600">Completion Rate</div>
                      <div class="text-3xl font-bold text-gray-900 mt-2">
                        <%= Map.get(@selected_project.stats || %{}, :completion_rate, 0) %>%
                      </div>
                    </div>
                    <div class="w-12 h-12 bg-green-100 rounded-full flex items-center justify-center">
                      <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                      </svg>
                    </div>
                  </div>
                </div>
              </div>

              <%!-- Attachees List --%>
              <div class="bg-white rounded-xl shadow-sm overflow-hidden">
                <div class="px-6 py-4 border-b border-gray-200 bg-gray-50">
                  <h2 class="text-xl font-bold text-gray-900">Project Attachees</h2>
                  <p class="text-sm text-gray-600 mt-1">Click on an attachee to view their tasks and evaluations</p>
                </div>

                <%= if @project_attachees == [] do %>
                  <div class="p-12 text-center">
                    <svg class="w-16 h-16 mx-auto text-gray-400 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
                    </svg>
                    <h3 class="text-lg font-medium text-gray-900 mb-2">No attachees yet</h3>
                    <p class="text-gray-600">No attachees have been assigned to this project</p>
                  </div>
                <% else %>
                  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 p-6">
                    <%= for attachee <- @project_attachees do %>
                      <button
                        phx-click="view_attachee_detail"
                        phx-value-id={attachee.id}
                        class="group bg-white border-2 border-gray-200 hover:border-purple-400 rounded-xl p-6 text-left transition-all hover:shadow-lg"
                      >
                        <div class="flex items-start gap-4">
                          <div class="w-12 h-12 rounded-full bg-gradient-to-br from-purple-500 to-pink-500 flex items-center justify-center text-white font-bold text-lg flex-shrink-0">
                            <%= if Ecto.assoc_loaded?(attachee.user) && attachee.user && attachee.user.username do %>
                              <%= String.first(attachee.user.username) |> String.upcase() %>
                            <% else %>
                              A
                            <% end %>
                          </div>
                          
                          <div class="flex-1 min-w-0">
                            <h3 class="font-semibold text-gray-900 group-hover:text-purple-600 transition">
                              <%= attachee_name(attachee) %>
                            </h3>
                            <p class="text-sm text-gray-600 mt-1"><%= attachee.position %></p>
                            
                            <div class="mt-3 flex items-center gap-2">
                              <span class={"inline-flex items-center px-2 py-1 rounded-full text-xs font-medium #{if attachee.status == "active", do: "bg-green-100 text-green-800", else: "bg-gray-100 text-gray-800"}"}>
                                <%= String.capitalize(attachee.status) %>
                              </span>
                            </div>
                          </div>
                          
                          <svg class="w-5 h-5 text-gray-400 group-hover:text-purple-600 transition flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                          </svg>
                        </div>
                      </button>
                    <% end %>
                  </div>
                <% end %>
              </div>

            <%!-- LEVEL 2: Attachee Detail with Tasks --%>
            <% @detail_level == "tasks" && @selected_attachee -> %>
              <%!-- Attachee Header --%>
              <div class="bg-gradient-to-r from-purple-600 to-pink-600 rounded-2xl shadow-xl p-8 text-white">
                <div class="flex items-start gap-6">
                  <div class="w-24 h-24 rounded-full bg-white/20 backdrop-blur-sm flex items-center justify-center text-4xl font-bold flex-shrink-0 border-4 border-white/30">
                    <%= if Ecto.assoc_loaded?(@selected_attachee.user) && @selected_attachee.user && @selected_attachee.user.username do %>
                      <%= String.first(@selected_attachee.user.username) |> String.upcase() %>
                    <% else %>
                      A
                    <% end %>
                  </div>

                  <div class="flex-1">
                    <h1 class="text-4xl font-bold mb-2"><%= attachee_name(@selected_attachee) %></h1>
                    <p class="text-xl text-purple-100 mb-1"><%= @selected_attachee.position %></p>
                    <p class="text-sm text-purple-200">
                      <%= if @selected_project do %>
                        <%= @selected_project.name %>
                      <% end %>
                    </p>
                    
                    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-6">
                      <div class="bg-white/10 backdrop-blur-sm rounded-lg p-4">
                        <div class="text-sm text-purple-100">Total Tasks</div>
                        <div class="text-2xl font-bold"><%= @attachee_stats.total_tasks %></div>
                      </div>
                      <div class="bg-white/10 backdrop-blur-sm rounded-lg p-4">
                        <div class="text-sm text-purple-100">Completed</div>
                        <div class="text-2xl font-bold"><%= @attachee_stats.completed_tasks %></div>
                      </div>
                      <div class="bg-white/10 backdrop-blur-sm rounded-lg p-4">
                        <div class="text-sm text-purple-100">Completion Rate</div>
                        <div class="text-2xl font-bold"><%= @attachee_stats.completion_rate %>%</div>
                      </div>
                      <div class="bg-white/10 backdrop-blur-sm rounded-lg p-4">
                        <div class="text-sm text-purple-100">Evaluations</div>
                        <div class="text-2xl font-bold"><%= length(@attachee_evaluations) %></div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <%!-- Tasks Section --%>
              <div class="bg-white rounded-xl shadow-sm overflow-hidden">
                <div class="px-6 py-4 border-b border-gray-200 bg-gray-50">
                  <h2 class="text-xl font-bold text-gray-900">Tasks</h2>
                  <p class="text-sm text-gray-600 mt-1">All tasks assigned to this attachee</p>
                </div>

                <%= if @attachee_tasks == [] do %>
                  <div class="p-12 text-center">
                    <svg class="w-16 h-16 mx-auto text-gray-400 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                    </svg>
                    <h3 class="text-lg font-medium text-gray-900 mb-2">No tasks yet</h3>
                    <p class="text-gray-600">No tasks have been assigned yet</p>
                  </div>
                <% else %>
                  <div class="divide-y divide-gray-200">
                    <%= for task <- @attachee_tasks do %>
                      <div class="p-6 hover:bg-gray-50 transition">
                        <div class="flex items-start justify-between mb-2">
                          <div class="flex-1">
                            <h4 class="font-semibold text-gray-900 mb-1"><%= task.title %></h4>
                            <%= if task.description do %>
                              <p class="text-sm text-gray-600 mb-2"><%= task.description %></p>
                            <% end %>
                          </div>
                          <span class={"inline-flex items-center px-3 py-1 rounded-full text-xs font-medium #{task_status_color(task.status)}"}>
                            <%= String.capitalize(String.replace(task.status, "_", " ")) %>
                          </span>
                        </div>
                        
                        <div class="flex items-center gap-4 text-sm text-gray-600">
                          <%= if Ecto.assoc_loaded?(task.project) && task.project do %>
                            <div class="flex items-center gap-1">
                              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"/>
                              </svg>
                              <span><%= task.project.name %></span>
                            </div>
                          <% end %>
                          
                          <%= if task.due_on do %>
                            <div class="flex items-center gap-1">
                              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                              </svg>
                              <span>Due: <%= Calendar.strftime(task.due_on, "%b %d, %Y") %></span>
                            </div>
                          <% end %>
                        </div>
                      </div>
                    <% end %>
                  </div>
                <% end %>
              </div>

              <%!-- Evaluations Section --%>
              <div class="bg-white rounded-xl shadow-sm overflow-hidden">
                <div class="px-6 py-4 border-b border-gray-200 bg-gray-50">
                  <h2 class="text-xl font-bold text-gray-900">Evaluation History</h2>
                  <p class="text-sm text-gray-600 mt-1">Performance evaluations over time</p>
                </div>

                <%= if @attachee_evaluations == [] do %>
                  <div class="p-12 text-center">
                    <svg class="w-16 h-16 mx-auto text-gray-400 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                    </svg>
                    <h3 class="text-lg font-medium text-gray-900 mb-2">No evaluations yet</h3>
                    <p class="text-gray-600">No evaluations have been submitted</p>
                  </div>
                <% else %>
                  <div class="divide-y divide-gray-200">
                    <%= for evaluation <- @attachee_evaluations do %>
                      <div class="p-6">
                        <div class="flex items-start gap-4">
                          <div class={"w-16 h-16 rounded-full flex items-center justify-center text-2xl font-bold #{if evaluation.score >= 70, do: "bg-green-100 text-green-600", else: "bg-amber-100 text-amber-600"}"}>
                            <%= evaluation.score %>
                          </div>
                          <div class="flex-1">
                            <div class="flex items-center justify-between mb-2">
                              <div>
                                <div class="font-semibold text-gray-900">Score: <%= evaluation.score %>/100</div>
                                <div class="text-sm text-gray-600">
                                  <%= Calendar.strftime(evaluation.inserted_at, "%B %d, %Y at %I:%M %p") %>
                                </div>
                                <%= if Ecto.assoc_loaded?(evaluation.evaluator) && evaluation.evaluator do %>
                                  <div class="text-sm text-gray-600">
                                    By: <%= evaluation.evaluator.username || evaluation.evaluator.email %>
                                  </div>
                                <% end %>
                              </div>
                            </div>
                            <%= if evaluation.comments do %>
                              <div class="bg-gray-50 rounded-lg p-4 border border-gray-200 mt-3">
                                <div class="text-sm font-medium text-gray-700 mb-2">Comments:</div>
                                <p class="text-sm text-gray-600"><%= evaluation.comments %></p>
                              </div>
                            <% end %>
                          </div>
                        </div>
                      </div>
                    <% end %>
                  </div>
                <% end %>
              </div>
          <% end %>

        <% else %>
          <%!-- DEFAULT VIEW: Project Cards List --%>
          
          <!-- Header -->
          <div class="flex items-center justify-between">
            <div>
              <h1 class="text-3xl font-bold text-gray-900">Project Management</h1>
              <p class="text-gray-600 mt-1">Browse and manage your projects</p>
            </div>
            <div class="flex items-center gap-3">
              <button
                phx-click="refresh"
                class="flex items-center gap-2 px-4 py-2 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 transition"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
                </svg>
                Refresh
              </button>
              <button
                phx-click="new"
                class="flex items-center gap-2 px-4 py-2 bg-purple-600 text-white rounded-lg hover:bg-purple-700 transition shadow"
              >
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                </svg>
                New Project
              </button>
            </div>
          </div>

          <!-- Search Bar -->
          <div class="bg-white rounded-xl shadow-sm p-4">
            <form phx-change="search" class="flex gap-4">
              <div class="flex-1">
                <div class="relative">
                  <svg class="absolute left-3 top-1/2 transform -translate-y-1/2 w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                  </svg>
                  <input
                    type="text"
                    name="query"
                    value={@search_query}
                    placeholder="Search projects..."
                    class="w-full pl-10 pr-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-purple-500"
                  />
                </div>
              </div>
            </form>
          </div>

          <!-- Stats Overview -->
          <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
            <div class="bg-white rounded-xl shadow-sm p-6 border-l-4 border-purple-500">
              <div class="text-sm font-medium text-gray-600">Total Projects</div>
              <div class="text-3xl font-bold text-gray-900 mt-2"><%= length(@projects) %></div>
            </div>
            <div class="bg-white rounded-xl shadow-sm p-6 border-l-4 border-green-500">
              <div class="text-sm font-medium text-gray-600">Active Projects</div>
              <div class="text-3xl font-bold text-gray-900 mt-2">
                <%= Enum.count(@projects, & &1.is_active == true) %>
              </div>
            </div>
            <div class="bg-white rounded-xl shadow-sm p-6 border-l-4 border-blue-500">
              <div class="text-sm font-medium text-gray-600">Total Attachees</div>
              <div class="text-3xl font-bold text-gray-900 mt-2">
                <%= Enum.sum(Enum.map(@projects, fn p -> Map.get(p.stats || %{}, :total_attachees, 0) end)) %>
              </div>
            </div>
            <div class="bg-white rounded-xl shadow-sm p-6 border-l-4 border-amber-500">
              <div class="text-sm font-medium text-gray-600">Total Tasks</div>
              <div class="text-3xl font-bold text-gray-900 mt-2">
                <%= Enum.sum(Enum.map(@projects, fn p -> Map.get(p.stats || %{}, :total_tasks, 0) end)) %>
              </div>
            </div>
          </div>

          <!-- Projects Grid -->
          <%= if filtered_projects(@projects, @search_query) == [] do %>
            <div class="bg-white rounded-xl shadow-sm p-12 text-center">
              <svg class="w-16 h-16 mx-auto text-gray-400 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
              </svg>
              <h3 class="text-lg font-medium text-gray-900 mb-2">No projects found</h3>
              <p class="text-gray-600 mb-4">
                <%= if @search_query != "", do: "Try adjusting your search", else: "Get started by creating your first project" %>
              </p>
              <%= if @search_query == "" do %>
                <button
                  phx-click="new"
                  class="px-4 py-2 bg-purple-600 text-white rounded-lg hover:bg-purple-700 transition"
                >
                  Create Your First Project
                </button>
              <% end %>
            </div>
          <% else %>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
              <%= for project <- filtered_projects(@projects, @search_query) do %>
                <div class="relative group">
                  <button
                    phx-click="view_project_detail"
                    phx-value-id={project.id}
                    class="w-full bg-white rounded-xl shadow-sm hover:shadow-lg transition-all duration-200 overflow-hidden border border-gray-200 hover:border-purple-300 text-left"
                  >
                    <!-- Card Header -->
                    <div class="bg-gradient-to-r from-indigo-600 to-purple-600 p-6">
                      <h3 class="text-xl font-bold text-white group-hover:scale-105 transition-transform">
                        <%= project.name %>
                      </h3>
                      <div class="flex items-center gap-2 mt-2 flex-wrap">
                        <%= if project.code do %>
                          <span class="inline-block px-3 py-1 bg-white/20 backdrop-blur-sm text-white text-xs font-medium rounded-full">
                            <%= project.code %>
                          </span>
                        <% end %>
                        <%!-- Status Badge --%>
                        <%= case project_status(project) do %>
                          <% :active -> %>
                            <span class="inline-block px-3 py-1 bg-green-400/30 backdrop-blur-sm text-white text-xs font-medium rounded-full border border-white/20">Active</span>
                          <% :upcoming -> %>
                            <span class="inline-block px-3 py-1 bg-blue-400/30 backdrop-blur-sm text-white text-xs font-medium rounded-full border border-white/20">Upcoming</span>
                          <% :completed -> %>
                            <span class="inline-block px-3 py-1 bg-gray-400/30 backdrop-blur-sm text-white text-xs font-medium rounded-full border border-white/20">Completed</span>
                          <% :inactive -> %>
                            <span class="inline-block px-3 py-1 bg-red-400/30 backdrop-blur-sm text-white text-xs font-medium rounded-full border border-white/20">Inactive</span>
                        <% end %>
                      </div>
                    </div>

                    <!-- Card Body -->
                    <div class="p-6 space-y-4">
                      <%= if project.description do %>
                        <p class="text-sm text-gray-600 line-clamp-2"><%= project.description %></p>
                      <% end %>

                      <!-- Project Details -->
                      <div class="space-y-2 text-sm">
                        <%= if Ecto.assoc_loaded?(project.program) && project.program do %>
                          <div class="flex items-center gap-2 text-gray-700">
                            <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"/>
                            </svg>
                            <span><%= project.program.name %></span>
                          </div>
                        <% end %>

                        <%= if Ecto.assoc_loaded?(project.supervisor) && project.supervisor do %>
                          <div class="flex items-center gap-2 text-gray-700">
                            <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                            </svg>
                            <span><%= project.supervisor.username || project.supervisor.email %></span>
                          </div>
                        <% end %>
                      </div>

                      <!-- Stats Grid -->
                      <div class="grid grid-cols-3 gap-3 pt-4 border-t">
                        <div class="text-center">
                          <div class="text-2xl font-bold text-purple-600"><%= Map.get(project.stats || %{}, :total_attachees, 0) %></div>
                          <div class="text-xs text-gray-600">Attachees</div>
                        </div>
                        <div class="text-center">
                          <div class="text-2xl font-bold text-blue-600"><%= Map.get(project.stats || %{}, :total_tasks, 0) %></div>
                          <div class="text-xs text-gray-600">Tasks</div>
                        </div>
                        <div class="text-center">
                          <div class="text-2xl font-bold text-green-600"><%= Map.get(project.stats || %{}, :completion_rate, 0) %>%</div>
                          <div class="text-xs text-gray-600">Complete</div>
                        </div>
                      </div>
                    </div>

                    <!-- Card Footer -->
                    <div class="px-6 py-4 bg-gray-50 border-t border-gray-100">
                      <span class="text-purple-600 font-medium group-hover:translate-x-1 transition-transform inline-flex items-center gap-1 text-sm">
                        View Attachees & Tasks
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                        </svg>
                      </span>
                    </div>
                  </button>

                  <!-- Quick Actions (Hover) -->
                  <div class="absolute top-4 right-4 opacity-0 group-hover:opacity-100 transition-opacity flex gap-2 pointer-events-none group-hover:pointer-events-auto">
                    <button
                      type="button"
                      phx-click="edit_project"
                      phx-value-id={project.id}
                      class="p-2 bg-white rounded-lg shadow-lg hover:bg-purple-50 text-purple-600 transition z-10 pointer-events-auto"
                      title="Edit"
                    >
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                      </svg>
                    </button>
                    <button
                      type="button"
                      phx-click="delete_project"
                      phx-value-id={project.id}
                      data-confirm="Are you sure you want to delete this project?"
                      class="p-2 bg-white rounded-lg shadow-lg hover:bg-red-50 text-red-600 transition z-10 pointer-events-auto"
                      title="Delete"
                    >
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                      </svg>
                    </button>
                  </div>
                </div>
              <% end %>
            </div>
          <% end %>
        <% end %>
      </div>
    </main>
  </div>
</div>

  <%!-- Form Modal (if needed) --%>
  <%= if @show_form do %>
    <div class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4">
      <div class="bg-white rounded-lg shadow-xl max-w-2xl w-full max-h-[90vh] overflow-y-auto">
        <%!-- Modal Header --%>
        <div class="sticky top-0 bg-white border-b border-gray-200 px-6 py-4 flex items-center justify-between">
          <div>
            <h2 class="text-xl font-semibold text-gray-900">
              <%= if @editing_project, do: "Edit Project", else: "New Project" %>
            </h2>
            <%= if @editing_project do %>
              <p class="text-sm text-gray-500 mt-1">
                Editing: <%= @editing_project.name %>
              </p>
            <% end %>
          </div>
          <button
            phx-click="close"
            class="text-gray-400 hover:text-gray-600 transition-colors"
          >
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>

        <%!-- Modal Body --%>
        <div class="px-6 py-4">
          <form phx-submit="save" phx-change="update">
            <%!-- Project Name --%>
            <div class="mb-4">
              <label class="block text-sm font-medium text-gray-700 mb-2">
                Project Name <span class="text-red-500">*</span>
              </label>
              <input
                type="text"
                name="project[name]"
                value={@form_data["name"]}
                placeholder="Enter project name"
                required
                class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
              />
              <%= if @errors[:name] do %>
                <p class="mt-1 text-sm text-red-600"><%= elem(@errors[:name], 0) %></p>
              <% end %>
            </div>

            <%!-- Project Code --%>
            <div class="mb-4">
              <label class="block text-sm font-medium text-gray-700 mb-2">
                Project Code
              </label>
              <input
                type="text"
                name="project[code]"
                value={@form_data["code"]}
                placeholder="e.g., PROJ-001"
                class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
              />
              <p class="mt-1 text-xs text-gray-500">Optional unique identifier for this project</p>
              <%= if @errors[:code] do %>
                <p class="mt-1 text-sm text-red-600"><%= elem(@errors[:code], 0) %></p>
              <% end %>
            </div>

            <%!-- Description --%>
            <div class="mb-4">
              <label class="block text-sm font-medium text-gray-700 mb-2">
                Description
              </label>
              <textarea
                name="project[description]"
                rows="3"
                placeholder="Describe the project goals and objectives"
                class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
              ><%= @form_data["description"] %></textarea>
              <%= if @errors[:description] do %>
                <p class="mt-1 text-sm text-red-600"><%= elem(@errors[:description], 0) %></p>
              <% end %>
            </div>

            <%!-- Organization Selection --%>
            <div class="mb-4">
              <label class="block text-sm font-medium text-gray-700 mb-2">
                Organization <span class="text-red-500">*</span>
              </label>
              <select
                name="project[organization_id]"
                required
                class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
              >
                <option value="">Select an organization</option>
                <%= for org <- @orgs do %>
                  <option value={org.id} selected={@form_data["organization_id"] == to_string(org.id)}>
                    <%= org.name %>
                  </option>
                <% end %>
              </select>
              <%= if @errors[:organization_id] do %>
                <p class="mt-1 text-sm text-red-600"><%= elem(@errors[:organization_id], 0) %></p>
              <% end %>
            </div>

            <%!-- Department Selection --%>
            <div class="mb-4">
              <label class="block text-sm font-medium text-gray-700 mb-2">
                Department <span class="text-red-500">*</span>
              </label>
              <select
                name="project[department_id]"
                required
                class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                disabled={@departments == []}
              >
                <option value="">
                  <%= if @departments == [], do: "Select organization first", else: "Select a department" %>
                </option>
                <%= for dept <- @departments do %>
                  <option value={dept.id} selected={@form_data["department_id"] == to_string(dept.id)}>
                    <%= dept.name %>
                  </option>
                <% end %>
              </select>
              <%= if @errors[:department_id] do %>
                <p class="mt-1 text-sm text-red-600"><%= elem(@errors[:department_id], 0) %></p>
              <% end %>
            </div>

            <%!-- Program Selection --%>
            <div class="mb-4">
              <label class="block text-sm font-medium text-gray-700 mb-2">
                Program <span class="text-red-500">*</span>
              </label>
              <select
                name="project[program_id]"
                required
                class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                disabled={@programs == []}
              >
                <option value="">
                  <%= if @programs == [], do: "Select department first", else: "Select a program" %>
                </option>
                <%= for program <- @programs do %>
                  <option value={program.id} selected={@form_data["program_id"] == to_string(program.id)}>
                    <%= program.name %>
                  </option>
                <% end %>
              </select>
              <%= if @errors[:program_id] do %>
                <p class="mt-1 text-sm text-red-600"><%= elem(@errors[:program_id], 0) %></p>
              <% end %>
            </div>

            <%!-- Supervisor Selection --%>
            <div class="mb-4">
              <label class="block text-sm font-medium text-gray-700 mb-2">
                Supervisor
              </label>
              <select
                name="project[supervisor_id]"
                class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
              >
                <option value="">Select a supervisor</option>
                <%= for supervisor <- @supervisors do %>
                  <option value={supervisor.id} selected={@form_data["supervisor_id"] == to_string(supervisor.id)}>
                    <%= supervisor.username || supervisor.email %>
                  </option>
                <% end %>
              </select>
              <%= if @errors[:supervisor_id] do %>
                <p class="mt-1 text-sm text-red-600"><%= elem(@errors[:supervisor_id], 0) %></p>
              <% end %>
            </div>

            <%!-- Date Range --%>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">
                  Start Date
                </label>
                <input
                  type="date"
                  name="project[starts_on]"
                  value={@form_data["starts_on"]}
                  class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                />
                <%= if @errors[:starts_on] do %>
                  <p class="mt-1 text-sm text-red-600"><%= elem(@errors[:starts_on], 0) %></p>
                <% end %>
              </div>
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">
                  End Date
                </label>
                <input
                  type="date"
                  name="project[ends_on]"
                  value={@form_data["ends_on"]}
                  class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                />
                <%= if @errors[:ends_on] do %>
                  <p class="mt-1 text-sm text-red-600"><%= elem(@errors[:ends_on], 0) %></p>
                <% end %>
              </div>
            </div>

            <%!-- Date Range Error --%>
            <%= if @errors[:date_range] do %>
              <div class="mb-4 p-3 bg-red-50 border border-red-200 rounded-lg">
                <p class="text-sm text-red-600"><%= @errors[:date_range] %></p>
              </div>
            <% end %>

            <%!-- Form Actions --%>
            <div class="flex items-center justify-end space-x-3 pt-4 border-t border-gray-200">
              <button
                type="button"
                phx-click="close"
                class="px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors"
              >
                Cancel
              </button>
              <button
                type="submit"
                class="px-4 py-2 text-sm font-medium text-white bg-blue-600 rounded-lg hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors"
              >
                <%= if @editing_project, do: "Update Project", else: "Create Project" %>
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  <% end %>
