<.live_component module={TrialAppWeb.SidebarComponent} id="sidebar" current_scope={@current_scope} />

<div class="ml-64 min-h-screen bg-gray-50 p-8">
  <div class="max-w-4xl mx-auto py-8 px-4">

    <!-- Header -->
    <div class="mb-8">
      <div class="flex items-center gap-3 mb-2">
        <.link navigate={~p"/admin"} class="p-2 hover:bg-gray-100 rounded-lg transition">
          <.icon name="hero-arrow-left" class="w-5 h-5 text-gray-600" />
        </.link>
        <h1 class="text-3xl font-bold text-[#3B3B98]">Program Management</h1>
      </div>
      <p class="text-sm text-gray-500 ml-14">Manage internship programs and their associated details</p>
    </div>

    <!-- Filters Section -->
    <div class="bg-white shadow-lg rounded-2xl border border-gray-100 overflow-hidden mb-8">
      <div class="p-8">
        <h2 class="text-lg font-semibold text-gray-800 mb-6">Attachee Filters</h2>

        <form id="attachee-filter" phx-change="filter_update" class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="space-y-2">
            <label class="block text-sm font-semibold text-gray-700">Organization</label>
            <select name="organization_id" class="w-full px-4 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-[#6C63FF] focus:outline-none">
              <option value="">Select organization</option>
              <%= for o <- @orgs do %>
                <option value={o.id} selected={to_string(o.id) == @filter_org_id}><%= o.name %></option>
              <% end %>
            </select>
          </div>

          <div class="space-y-2">
            <label class="block text-sm font-semibold text-gray-700">Department</label>
            <select name="department_id" class="w-full px-4 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-[#6C63FF] focus:outline-none">
              <option value="">Select department</option>
              <%= for d <- @filter_departments do %>
                <option value={d.id} selected={to_string(d.id) == @filter_department_id}><%= d.name %></option>
              <% end %>
            </select>
          </div>

          <div class="space-y-2">
            <label class="block text-sm font-semibold text-gray-700">Program</label>
            <select name="program_id" class="w-full px-4 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-[#6C63FF] focus:outline-none">
              <option value="">Select program</option>
              <%= for p <- @filter_programs do %>
                <option value={p.id} selected={to_string(p.id) == @filter_program_id}><%= p.name %></option>
              <% end %>
            </select>
          </div>
        </form>
      </div>
    </div>

    <!-- Filtered Results -->
    <div class="bg-white shadow-lg rounded-2xl border border-gray-100 overflow-hidden mb-8">
      <div class="p-8">
        <h2 class="text-lg font-semibold text-gray-800 mb-4">Filtered Attachees</h2>

        <%= if Enum.empty?(@filtered_attachees) do %>
          <p class="text-sm text-gray-500 italic">No attachees for the selected filters.</p>
        <% else %>
          <div class="overflow-hidden border border-gray-200 rounded-xl">
            <table class="min-w-full divide-y divide-gray-200">
              <thead class="bg-gray-100">
                <tr>
                  <th class="px-4 py-2 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Full Name</th>
                  <th class="px-4 py-2 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Email</th>
                  <th class="px-4 py-2 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Position</th>
                </tr>
              </thead>
              <tbody class="bg-white divide-y divide-gray-100">
                <%= for a <- @filtered_attachees do %>
                  <tr class="hover:bg-gray-50 transition">
                    <td class="px-4 py-2 text-sm text-gray-900">
                      <%= if a.user do %>
                        <%= a.user.username || a.user.email %>
                      <% else %>
                        Attachee <%= a.id %>
                      <% end %>
                    </td>
                    <td class="px-4 py-2 text-sm text-gray-600"><%= if a.user, do: a.user.email, else: "-" %></td>
                    <td class="px-4 py-2 text-sm text-gray-600">Attachee</td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Programs List -->
    <div class="bg-white shadow-lg rounded-2xl border border-gray-100 overflow-hidden">
      <div class="p-8">
        <div class="flex items-center justify-between mb-6">
          <h2 class="text-lg font-semibold text-gray-800">Available Programs</h2>
          <button
            type="button"
            phx-click="new"
            class="px-6 py-2.5 rounded-lg bg-[#6C63FF] text-white hover:bg-[#5A52E8] transition font-medium shadow-sm"
          >
            + New Program
          </button>
        </div>

        <%= if Enum.empty?(@programs) do %>
          <p class="text-sm text-gray-500 italic">No programs added yet.</p>
        <% else %>
          <ul class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
            <%= for prog <- @programs do %>
              <li class="border border-gray-200 rounded-lg bg-gray-50 p-4 hover:shadow-md hover:bg-white transition">
                <div class="font-semibold text-gray-900"><%= prog.name %></div>
                <div class="text-xs text-gray-500 mt-1"><%= prog.code %></div>
              </li>
            <% end %>
          </ul>
        <% end %>
      </div>
    </div>

    <!-- Modal -->
    <%= if @show_form do %>
      <div class="fixed inset-0 bg-black bg-opacity-40 backdrop-blur-sm flex items-center justify-center z-50 p-4" phx-click="close">
        <div
          class="bg-white rounded-2xl shadow-2xl w-full max-w-lg p-6 transform transition-all scale-100 hover:scale-[1.01]"
          phx-click="stop_propagation"
        >
          <h2 class="text-2xl font-bold text-[#3B3B98] mb-4">Create New Program</h2>

          <form id="program-form" phx-submit="save" phx-change="update_form" class="space-y-5">
            <div class="space-y-2">
              <label class="block text-sm font-semibold text-gray-700">Program Name</label>
              <input
                type="text"
                name="program[name]"
                value={@form_data["name"]}
                placeholder="Enter program name"
                class="w-full px-4 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-[#6C63FF] focus:outline-none"
                required
              />
              <%= if error = @errors[:name] do %>
                <p class="text-xs text-red-600"><%= error %></p>
              <% end %>
            </div>

            <div class="space-y-2">
              <label class="block text-sm font-semibold text-gray-700">Organization</label>
              <select
                name="program[organization_id]"
                class="w-full px-4 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-[#6C63FF] focus:outline-none"
                required
              >
                <option value="">Select organization</option>
                <%= for o <- @orgs do %>
                  <option value={o.id} selected={to_string(o.id) == @form_data["organization_id"]}><%= o.name %></option>
                <% end %>
              </select>
            </div>

            <div class="space-y-2">
              <label class="block text-sm font-semibold text-gray-700">Department</label>
              <select
                name="program[department_id]"
                class="w-full px-4 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-[#6C63FF] focus:outline-none"
                required
              >
                <option value=""><%= if Enum.empty?(@departments), do: "Select organization first", else: "Select department" %></option>
                <%= for d <- @departments do %>
                  <option value={d.id} selected={to_string(d.id) == @form_data["department_id"]}><%= d.name %></option>
                <% end %>
              </select>
            </div>

            <div class="grid grid-cols-2 gap-6">
              <div class="space-y-2">
                <label class="block text-sm font-semibold text-gray-700">Start Date</label>
                <input type="date" name="program[starts_on]" value={@form_data["starts_on"]}
                  class="w-full px-4 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-[#6C63FF] focus:outline-none" />
              </div>

              <div class="space-y-2">
                <label class="block text-sm font-semibold text-gray-700">End Date</label>
                <input type="date" name="program[ends_on]" value={@form_data["ends_on"]}
                  class="w-full px-4 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-[#6C63FF] focus:outline-none" />
              </div>
            </div>

            <div class="space-y-2">
              <label class="block text-sm font-semibold text-gray-700">Description</label>
              <textarea
                name="program[description]"
                rows="3"
                placeholder="Enter program description"
                class="w-full px-4 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-[#6C63FF] focus:outline-none"
              ><%= @form_data["description"] %></textarea>
            </div>

            <div class="flex justify-end gap-3 pt-6 border-t">
              <button type="button" phx-click="close" class="px-6 py-2.5 rounded-lg border border-gray-300 text-gray-700 hover:bg-gray-50 transition font-medium">
                Cancel
              </button>
              <button type="submit" class="px-6 py-2.5 rounded-lg bg-[#6C63FF] text-white hover:bg-[#5A52E8] transition font-medium shadow-sm">
                Save Program
              </button>
            </div>
          </form>
        </div>
      </div>
    <% end %>
  </div>
</div>
