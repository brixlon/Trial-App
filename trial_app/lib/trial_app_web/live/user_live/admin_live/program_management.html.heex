<div class="min-h-screen bg-gray-50">
  <div class="flex">
    <!-- Main content -->
    <main class="ml-45 w-full p-8">
      <div class="max-w-7xl mx-auto space-y-8">
        <!-- Header -->
        <div class="flex items-center justify-between">
          <div>
            <h1 class="text-2xl font-semibold text-gray-800">Program Management</h1>
            <p class="text-sm text-gray-500 mt-1">Manage and track all your organization's programs</p>
          </div>
          <button
            phx-click="new"
            class="bg-purple-600 text-white px-4 py-2 rounded-lg shadow hover:bg-purple-700 transition"
          >
            New Program
          </button>
        </div>

        <!-- Stats Summary -->
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
          <div class="bg-purple-50 p-4 rounded-lg border border-purple-100">
            <div class="text-sm text-purple-600 font-medium">Total Programs</div>
            <div class="text-2xl font-bold text-purple-700 mt-1"><%= length(@programs) %></div>
          </div>

          <div class="bg-green-50 p-4 rounded-lg border border-green-100">
            <div class="text-sm text-green-600 font-medium">Active</div>
            <div class="text-2xl font-bold text-green-700 mt-1">
              <%= Enum.count(@programs, fn p -> !p.starts_on || Date.compare(p.starts_on, Date.utc_today()) != :gt end) %>
            </div>
          </div>

          <div class="bg-amber-50 p-4 rounded-lg border border-amber-100">
            <div class="text-sm text-amber-600 font-medium">In Progress</div>
            <div class="text-2xl font-bold text-amber-700 mt-1">
              <%= Enum.count(@programs, fn p -> p.starts_on && Date.compare(p.starts_on, Date.utc_today()) == :lt && (!p.ends_on || Date.compare(p.ends_on, Date.utc_today()) != :lt) end) %>
            </div>
          </div>

          <div class="bg-blue-50 p-4 rounded-lg border border-blue-100">
            <div class="text-sm text-blue-600 font-medium">Completed</div>
            <div class="text-2xl font-bold text-blue-700 mt-1">
              <%= Enum.count(@programs, fn p -> p.ends_on && Date.compare(p.ends_on, Date.utc_today()) == :lt end) %>
            </div>
          </div>
        </div>

        <!-- Program Form Modal -->
        <%= if @show_form do %>
          <div class="fixed inset-0 bg-black/50 flex items-center justify-center p-4 z-50">
            <div class="bg-white rounded-xl w-full max-w-2xl shadow-xl max-h-[90vh] overflow-hidden flex flex-col">
              <!-- Modal Header -->
              <div class="flex items-center justify-between p-6 border-b border-gray-200">
                <div>
                  <h2 class="text-xl font-semibold text-gray-800">
                    <%= if @editing_program, do: "Edit Program", else: "Create New Program" %>
                  </h2>
                  <p class="text-sm text-gray-500 mt-1">
                    <%= if @editing_program, do: "Update program details", else: "Fill in the details to get started" %>
                  </p>
                </div>
                <button phx-click="close" class="p-2 hover:bg-gray-100 rounded-lg transition">
                  <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                  </svg>
                </button>
              </div>

              <!-- Modal Body -->
              <form id="program-form" phx-submit="save" phx-change="update_form" class="flex-1 overflow-y-auto">
                <div class="p-6 space-y-4">
                  <!-- Error Banner -->
                  <%= if @errors != %{} do %>
                    <div class="bg-red-50 border-l-4 border-red-500 rounded-lg p-4">
                      <div class="flex items-start gap-3">
                        <svg class="w-5 h-5 text-red-500 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
                        </svg>
                        <div>
                          <h3 class="text-sm font-medium text-red-800">There were errors with your submission</h3>
                          <div class="mt-2 text-sm text-red-700">
                            <ul class="list-disc list-inside space-y-1">
                              <%= for {field, message} <- @errors do %>
                                <li><%= Phoenix.Naming.humanize(field) %>: <%= message %></li>
                              <% end %>
                            </ul>
                          </div>
                        </div>
                      </div>
                    </div>
                  <% end %>

                  <!-- Program Name -->
                  <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">
                      Program Name <span class="text-red-500">*</span>
                    </label>
                    <input
                      type="text"
                      name="program[name]"
                      value={@form_data["name"]}
                      class={"w-full border rounded-lg px-3 py-2 focus:ring-2 focus:ring-purple-500 focus:border-transparent transition #{if @errors[:name], do: "border-red-500", else: "border-gray-300"}"}
                      placeholder="Enter program name"
                      required
                    />
                    <%= if error = @errors[:name] do %>
                      <p class="mt-1 text-sm text-red-600"><%= error %></p>
                    <% end %>
                  </div>

                  <!-- Organization & Department -->
                  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                      <label class="block text-sm font-medium text-gray-700 mb-1">
                        Organization <span class="text-red-500">*</span>
                      </label>
                      <select
                        name="program[organization_id]"
                        class={"w-full border rounded-lg px-3 py-2 focus:ring-2 focus:ring-purple-500 focus:border-transparent transition #{if @errors[:organization_id], do: "border-red-500", else: "border-gray-300"}"}
                        required
                      >
                        <option value="">Select organization</option>
                        <%= for org <- @orgs do %>
                          <option value={org.id} selected={to_string(org.id) == @form_data["organization_id"]}>
                            <%= org.name %>
                          </option>
                        <% end %>
                      </select>
                      <%= if error = @errors[:organization_id] do %>
                        <p class="mt-1 text-sm text-red-600"><%= error %></p>
                      <% end %>
                    </div>

                    <div>
                      <label class="block text-sm font-medium text-gray-700 mb-1">
                        Department <span class="text-red-500">*</span>
                      </label>
                      <select
                        name="program[department_id]"
                        class={"w-full border rounded-lg px-3 py-2 focus:ring-2 focus:ring-purple-500 focus:border-transparent transition #{if @errors[:department_id], do: "border-red-500", else: "border-gray-300"}"}
                        required
                        disabled={Enum.empty?(@departments)}
                      >
                        <option value="">
                          <%= if Enum.empty?(@departments), do: "Select organization first", else: "Select department" %>
                        </option>
                        <%= for dept <- @departments do %>
                          <option value={dept.id} selected={to_string(dept.id) == @form_data["department_id"]}>
                            <%= dept.name %>
                          </option>
                        <% end %>
                      </select>
                      <%= if error = @errors[:department_id] do %>
                        <p class="mt-1 text-sm text-red-600"><%= error %></p>
                      <% end %>
                    </div>
                  </div>

                  <!-- Program Code -->
                  <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">
                      Program Code
                    </label>
                    <input
                      type="text"
                      name="program[code]"
                      value={@form_data["code"]}
                      class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-purple-500 focus:border-transparent transition"
                      placeholder="e.g., PROG-2025-001"
                    />
                    <p class="mt-1 text-xs text-gray-500">Optional: Unique identifier for the program</p>
                  </div>

                  <!-- Start & End Date -->
                  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                      <label class="block text-sm font-medium text-gray-700 mb-1">Start Date</label>
                      <input
                        type="date"
                        name="program[starts_on]"
                        value={@form_data["starts_on"]}
                        class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-purple-500 focus:border-transparent transition"
                      />
                    </div>

                    <div>
                      <label class="block text-sm font-medium text-gray-700 mb-1">End Date</label>
                      <input
                        type="date"
                        name="program[ends_on]"
                        value={@form_data["ends_on"]}
                        class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-purple-500 focus:border-transparent transition"
                      />
                    </div>
                  </div>

                  <!-- Description -->
                  <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Description</label>
                    <textarea
                      name="program[description]"
                      class="w-full border border-gray-300 rounded-lg px-3 py-2 resize-none focus:ring-2 focus:ring-purple-500 focus:border-transparent transition"
                      rows="4"
                      placeholder="Describe the program goals, objectives, and key activities..."
                    ><%= @form_data["description"] %></textarea>
                    <p class="mt-1 text-xs text-gray-500">Provide details about the program's purpose and expected outcomes</p>
                  </div>
                </div>

                <!-- Modal Footer -->
                <div class="flex items-center justify-end gap-3 p-6 bg-gray-50 border-t border-gray-200">
                  <button
                    type="button"
                    phx-click="close"
                    class="px-4 py-2 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-100 transition"
                  >
                    Cancel
                  </button>
                  <button
                    type="submit"
                    class="px-4 py-2 bg-purple-600 text-white rounded-lg hover:bg-purple-700 transition shadow"
                  >
                    <%= if @editing_program, do: "Update Program", else: "Create Program" %>
                  </button>
                </div>
              </form>
            </div>
          </div>
        <% end %>

        <!-- Programs Table -->
        <div class="bg-white shadow rounded-xl overflow-hidden">
          <%= if @programs == [] do %>
            <div class="py-12 text-center">
              <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-purple-100 mb-4">
                <svg class="w-8 h-8 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
                </svg>
              </div>
              <h3 class="text-lg font-semibold text-gray-900 mb-1">No programs yet</h3>
              <p class="text-sm text-gray-500 mb-4">Get started by creating your first program</p>
              <button
                phx-click="new"
                class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-purple-600 text-white hover:bg-purple-700 transition shadow"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
                </svg>
                Create Your First Program
              </button>
            </div>
          <% else %>
            <div class="overflow-x-auto">
              <table class="min-w-full text-sm text-left text-gray-700">
                <thead class="bg-gray-100 text-xs uppercase">
                  <tr>
                    <th class="px-4 py-3">Program</th>
                    <th class="px-4 py-3">Organization</th>
                    <th class="px-4 py-3">Department</th>
                    <th class="px-4 py-3">Timeline</th>
                    <th class="px-4 py-3">Status</th>
                    <th class="px-4 py-3 text-right">Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <%= for program <- @programs do %>
                    <tr class="border-t hover:bg-gray-50 transition cursor-pointer group" phx-click="view_program" phx-value-id={program.id}>
                      <td class="px-4 py-3">
                        <div>
                          <div class="font-medium text-gray-900 group-hover:text-purple-600 transition-colors"><%= program.name %></div>
                          <%= if program.code do %>
                            <div class="text-xs text-gray-500 font-mono"><%= program.code %></div>
                          <% end %>
                          <%= if program.description do %>
                            <div class="text-xs text-gray-600 mt-1 line-clamp-2 max-w-md"><%= program.description %></div>
                          <% end %>
                        </div>
                      </td>
                      <td class="px-4 py-3">
                        <%= if Ecto.assoc_loaded?(program.organization) && program.organization do %>
                          <%= program.organization.name %>
                        <% else %>
                          <span class="text-gray-400">—</span>
                        <% end %>
                      </td>
                      <td class="px-4 py-3">
                        <%= if Ecto.assoc_loaded?(program.department) && program.department do %>
                          <span class="inline-flex items-center px-2 py-1 text-xs rounded-full bg-purple-100 text-purple-800">
                            <%= program.department.name %>
                          </span>
                        <% else %>
                          <span class="text-gray-400">—</span>
                        <% end %>
                      </td>
                      <td class="px-4 py-3">
                        <%= if program.starts_on do %>
                          <div class="text-sm">
                            <%= Calendar.strftime(program.starts_on, "%b %d, %Y") %>
                            <%= if program.ends_on do %>
                              <div class="text-xs text-gray-500">
                                to <%= Calendar.strftime(program.ends_on, "%b %d, %Y") %>
                              </div>
                            <% end %>
                          </div>
                        <% else %>
                          <span class="text-gray-400">Not set</span>
                        <% end %>
                      </td>
                      <td class="px-4 py-3">
                        <%= cond do %>
                          <% program.ends_on && Date.compare(program.ends_on, Date.utc_today()) == :lt -> %>
                            <span class="inline-flex items-center px-2 py-1 text-xs rounded-full font-medium bg-blue-100 text-blue-800">
                              Completed
                            </span>
                          <% program.starts_on && Date.compare(program.starts_on, Date.utc_today()) == :lt -> %>
                            <span class="inline-flex items-center px-2 py-1 text-xs rounded-full font-medium bg-amber-100 text-amber-800">
                              In Progress
                            </span>
                          <% true -> %>
                            <span class="inline-flex items-center px-2 py-1 text-xs rounded-full font-medium bg-green-100 text-green-800">
                              Active
                            </span>
                        <% end %>
                      </td>
                      <td class="px-4 py-3" phx-click="stop_propagation">
                        <div class="flex items-center justify-end gap-2">
                          <button
                            phx-click="edit_program"
                            phx-value-id={program.id}
                            class="p-1.5 hover:bg-purple-50 rounded text-purple-600"
                            title="Edit program"
                          >
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                            </svg>
                          </button>
                          <button
                            phx-click="delete_program"
                            phx-value-id={program.id}
                            data-confirm="Are you sure you want to delete this program? This action cannot be undone."
                            class="p-1.5 hover:bg-red-50 rounded text-red-600"
                            title="Delete program"
                          >
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                            </svg>
                          </button>
                        </div>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% end %>
        </div>
      </div>
    </main>
  </div>
</div>

<!-- View Modal -->
<%= if @show_view_modal && @viewing_program do %>
  <div class="fixed inset-0 bg-black/50 flex items-center justify-center p-4 z-50">
    <div class="bg-white rounded-xl w-full max-w-2xl shadow-xl max-h-[90vh] overflow-hidden flex flex-col">
      <!-- Modal Header -->
      <div class="flex items-center justify-between p-6 border-b border-gray-200">
        <div>
          <h2 class="text-xl font-semibold text-gray-800"><%= @viewing_program.name %></h2>
          <%= if @viewing_program.code do %>
            <p class="text-sm text-gray-600 mt-1 font-mono"><%= @viewing_program.code %></p>
          <% end %>
        </div>
        <button phx-click="close" class="p-2 hover:bg-gray-100 rounded-lg transition">
          <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>

      <!-- Modal Body -->
      <div class="flex-1 overflow-y-auto p-6 space-y-4">
        <!-- Status Badge -->
        <div>
          <%= cond do %>
            <% @viewing_program.ends_on && Date.compare(@viewing_program.ends_on, Date.utc_today()) == :lt -> %>
              <span class="inline-flex items-center px-3 py-1 text-sm rounded-full font-medium bg-blue-100 text-blue-800">
                Completed
              </span>
            <% @viewing_program.starts_on && Date.compare(@viewing_program.starts_on, Date.utc_today()) == :lt -> %>
              <span class="inline-flex items-center px-3 py-1 text-sm rounded-full font-medium bg-amber-100 text-amber-800">
                In Progress
              </span>
            <% true -> %>
              <span class="inline-flex items-center px-3 py-1 text-sm rounded-full font-medium bg-green-100 text-green-800">
                Active
              </span>
          <% end %>
        </div>

        <!-- Program Details Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="bg-gray-50 rounded-lg p-3 border border-gray-200">
            <p class="text-xs text-gray-500 font-medium mb-1">Organization</p>
            <p class="text-sm font-semibold text-gray-800">
              <%= if Ecto.assoc_loaded?(@viewing_program.organization) && @viewing_program.organization do %>
                <%= @viewing_program.organization.name %>
              <% else %>
                <span class="text-gray-400">Not assigned</span>
              <% end %>
            </p>
          </div>

          <div class="bg-gray-50 rounded-lg p-3 border border-gray-200">
            <p class="text-xs text-gray-500 font-medium mb-1">Department</p>
            <p class="text-sm font-semibold text-gray-800">
              <%= if Ecto.assoc_loaded?(@viewing_program.department) && @viewing_program.department do %>
                <%= @viewing_program.department.name %>
              <% else %>
                <span class="text-gray-400">Not assigned</span>
              <% end %>
            </p>
          </div>

          <div class="bg-gray-50 rounded-lg p-3 border border-gray-200">
            <p class="text-xs text-gray-500 font-medium mb-1">Start Date</p>
            <p class="text-sm font-semibold text-gray-800">
              <%= if @viewing_program.starts_on do %>
                <%= Calendar.strftime(@viewing_program.starts_on, "%B %d, %Y") %>
              <% else %>
                <span class="text-gray-400">Not set</span>
              <% end %>
            </p>
          </div>

          <div class="bg-gray-50 rounded-lg p-3 border border-gray-200">
            <p class="text-xs text-gray-500 font-medium mb-1">End Date</p>
            <p class="text-sm font-semibold text-gray-800">
              <%= if @viewing_program.ends_on do %>
                <%= Calendar.strftime(@viewing_program.ends_on, "%B %d, %Y") %>
              <% else %>
                <span class="text-gray-400">Not set</span>
              <% end %>
            </p>
          </div>
        </div>

        <!-- Duration -->
        <%= if @viewing_program.starts_on && @viewing_program.ends_on do %>
          <div class="bg-purple-50 rounded-lg p-3 border border-purple-200">
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
              </svg>
              <div>
                <p class="text-xs font-medium text-purple-600">Program Duration</p>
                <p class="text-sm font-semibold text-gray-900">
                  <%= Date.diff(@viewing_program.ends_on, @viewing_program.starts_on) %> days
                </p>
              </div>
            </div>
          </div>
        <% end %>

        <!-- Description -->
        <%= if @viewing_program.description && @viewing_program.description != "" do %>
          <div>
            <p class="text-xs text-gray-500 font-medium mb-2">Description</p>
            <div class="bg-gray-50 rounded-lg p-3 border border-gray-200">
              <p class="text-sm text-gray-700 whitespace-pre-wrap"><%= @viewing_program.description %></p>
            </div>
          </div>
        <% else %>
          <div class="text-center py-6">
            <svg class="w-10 h-10 mx-auto text-gray-400 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
            <p class="text-sm text-gray-500">No description provided for this program</p>
          </div>
        <% end %>

        <!-- Timestamps -->
        <div class="border-t border-gray-200 pt-4">
          <div class="grid grid-cols-2 gap-4 text-xs text-gray-500">
            <div>
              <span class="font-medium">Created:</span>
              <%= if @viewing_program.inserted_at do %>
                <%= Calendar.strftime(@viewing_program.inserted_at, "%B %d, %Y at %I:%M %p") %>
              <% else %>
                N/A
              <% end %>
            </div>
            <div>
              <span class="font-medium">Last Updated:</span>
              <%= if @viewing_program.updated_at do %>
                <%= Calendar.strftime(@viewing_program.updated_at, "%B %d, %Y at %I:%M %p") %>
              <% else %>
                N/A
              <% end %>
            </div>
          </div>
        </div>
      </div>

      <!-- Modal Footer -->
      <div class="flex items-center justify-end gap-3 p-6 bg-gray-50 border-t border-gray-200">
        <button
          type="button"
          phx-click="close"
          class="px-4 py-2 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-100 transition"
        >
          Close
        </button>
        <button
          phx-click="edit_program"
          phx-value-id={@viewing_program.id}
          class="px-4 py-2 bg-purple-600 text-white rounded-lg hover:bg-purple-700 transition shadow"
        >
          Edit Program
        </button>
      </div>
    </div>
  </div>
<% end %>