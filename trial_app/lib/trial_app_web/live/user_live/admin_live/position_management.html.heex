<div class="flex min-h-screen bg-gray-50">
  <!-- Main Content Area with proper margin for sidebar -->
  <div class="flex-1 ml-64 transition-all duration-300">
      <div class="max-w-7xl mx-auto space-y-8 p-6">
        <!-- Header Section -->
        <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
          <div>
            <h1 class="text-2xl font-semibold text-gray-800">Position Management</h1>
            <p class="text-gray-600 mt-1">Create and manage job positions across your organization</p>
          </div>
          <div class="flex gap-3">
            <.link navigate={~p"/admin/dashboard"} class="px-4 py-2 rounded-lg text-gray-700 border border-gray-300 hover:bg-gray-50 transition flex items-center gap-2">
              <.icon name="hero-arrow-left" class="w-4 h-4" />
              Dashboard
            </.link>
            <button phx-click="new" class="px-4 py-2 rounded-lg bg-purple-600 text-white hover:bg-purple-700 transition flex items-center gap-2">
              <.icon name="hero-plus" class="w-4 h-4" />
              New Position
            </button>
          </div>
        </div>

        <!-- Stats Cards -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="bg-white shadow rounded-xl p-6 border border-gray-200">
            <div class="flex items-center justify-between mb-2">
              <div class="w-12 h-12 rounded-xl bg-purple-100 flex items-center justify-center">
                <.icon name="hero-briefcase" class="w-6 h-6 text-purple-600" />
              </div>
              <span class="text-2xl font-bold text-gray-900"><%= @stats.total %></span>
            </div>
            <p class="text-sm text-gray-600">Total Positions</p>
          </div>

          <div class="bg-white shadow rounded-xl p-6 border border-gray-200">
            <div class="flex items-center justify-between mb-2">
              <div class="w-12 h-12 rounded-xl bg-green-100 flex items-center justify-center">
                <.icon name="hero-document-check" class="w-6 h-6 text-green-600" />
              </div>
              <span class="text-2xl font-bold text-gray-900"><%= @stats.with_description %></span>
            </div>
            <p class="text-sm text-gray-600">With Description</p>
          </div>

          <div class="bg-white shadow rounded-xl p-6 border border-gray-200">
            <div class="flex items-center justify-between mb-2">
              <div class="w-12 h-12 rounded-xl bg-amber-100 flex items-center justify-center">
                <.icon name="hero-document-minus" class="w-6 h-6 text-amber-600" />
              </div>
              <span class="text-2xl font-bold text-gray-900"><%= @stats.without_description %></span>
            </div>
            <p class="text-sm text-gray-600">Needs Description</p>
          </div>
        </div>

        <!-- Search Bar -->
        <div class="bg-white shadow rounded-xl p-5 border border-gray-200">
          <.form for={%{}} as={:search} phx-change="search">
            <div class="relative">
              <.icon name="hero-magnifying-glass" class="absolute left-4 top-1/2 transform -translate-y-1/2 w-5 h-5 text-gray-400" />
              <input
                type="text"
                name="search[q]"
                value={@search}
                placeholder="Search positions by name or description..."
                class="w-full pl-12 pr-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-purple-500 focus:outline-none transition"
                phx-debounce="300"
              />
            </div>
          </.form>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
          <!-- Positions Table -->
          <div class="lg:col-span-2">
            <div class="bg-white shadow rounded-xl border border-gray-200 overflow-hidden">
              <!-- Table Header -->
              <div class="bg-gray-50 px-6 py-4 border-b border-gray-200">
                <div class="flex items-center justify-between">
                  <h2 class="text-lg font-semibold text-gray-800 flex items-center gap-2">
                    <.icon name="hero-list-bullet" class="w-5 h-5 text-purple-600" />
                    All Positions
                  </h2>
                  <span class="text-sm font-medium text-gray-600">
                    <%= length(@filtered_positions) %> <%= if length(@filtered_positions) == 1, do: "position", else: "positions" %>
                  </span>
                </div>
              </div>

              <!-- Table -->
              <div class="overflow-x-auto">
                <table class="min-w-full text-sm text-left text-gray-700">
                  <thead class="bg-gray-100 text-xs uppercase text-gray-700">
                    <tr>
                      <th class="px-4 py-3 font-medium">
                        <button phx-click="sort" phx-value-by="name" class="flex items-center gap-2 hover:text-gray-900 transition">
                          POSITION NAME
                          <.icon name={get_sort_icon(@sort_by, "name", @sort_order)} class="w-4 h-4" />
                        </button>
                      </th>
                      <th class="px-4 py-3 font-medium">
                        <button phx-click="sort" phx-value-by="description" class="flex items-center gap-2 hover:text-gray-900 transition">
                          DESCRIPTION
                          <.icon name={get_sort_icon(@sort_by, "description", @sort_order)} class="w-4 h-4" />
                        </button>
                      </th>
                      <th class="px-4 py-3 font-medium text-right">ACTIONS</th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-gray-200">
                    <%= for pos <- @filtered_positions do %>
                      <tr id={"pos_#{pos.id}"} class="hover:bg-gray-50 transition group">
                        <td class="px-4 py-3">
                          <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-lg bg-purple-100 flex items-center justify-center text-purple-700 font-bold">
                              <%= String.first(pos.name) |> String.upcase() %>
                            </div>
                            <div>
                              <span class="font-medium text-gray-900"><%= pos.name %></span>
                              <div class="text-xs text-gray-500">ID: <%= pos.id %></div>
                            </div>
                          </div>
                        </td>
                        <td class="px-4 py-3">
                          <%= if has_description?(pos) do %>
                            <div class="text-gray-700 text-sm" title={pos.description}>
                              <%= truncate(pos.description, 80) %>
                            </div>
                          <% else %>
                            <span class="text-gray-400 italic text-sm">No description</span>
                          <% end %>
                        </td>
                        <td class="px-4 py-3">
                          <div class="flex items-center justify-end gap-2 opacity-0 group-hover:opacity-100 transition">
                            <button
                              phx-click="edit"
                              phx-value-id={pos.id}
                              class="p-2 hover:bg-purple-50 rounded-lg transition"
                              title="Edit Position"
                            >
                              <.icon name="hero-pencil-square" class="w-4 h-4 text-purple-600" />
                            </button>
                            <button
                              phx-click="delete"
                              phx-value-id={pos.id}
                              data-confirm="Are you sure you want to delete this position?"
                              class="p-2 hover:bg-red-50 rounded-lg transition"
                              title="Delete Position"
                            >
                              <.icon name="hero-trash" class="w-4 h-4 text-red-600" />
                            </button>
                          </div>
                        </td>
                      </tr>
                    <% end %>

                    <%= if Enum.empty?(@filtered_positions) do %>
                      <tr>
                        <td colspan="3" class="py-12 text-center">
                          <div class="flex flex-col items-center gap-3">
                            <div class="w-16 h-16 rounded-full bg-gray-100 flex items-center justify-center">
                              <.icon name="hero-briefcase" class="w-8 h-8 text-gray-400" />
                            </div>
                            <div>
                              <p class="font-semibold text-gray-700">No positions found</p>
                              <p class="text-sm text-gray-500 mt-1">
                                <%= if @search != "", do: "Try adjusting your search", else: "Create your first position to get started" %>
                              </p>
                            </div>
                            <%= if @search == "" do %>
                              <button phx-click="new" class="mt-2 px-4 py-2 rounded-lg bg-purple-600 text-white hover:bg-purple-700 transition flex items-center gap-2">
                                <.icon name="hero-plus" class="w-4 h-4" />
                                Create First Position
                              </button>
                            <% end %>
                          </div>
                        </td>
                      </tr>
                    <% end %>
                  </tbody>
                </table>
              </div>
            </div>
          </div>

          <!-- Form Panel -->
          <div class="lg:col-span-1">
            <%= if @show_form do %>
              <div class="bg-white shadow rounded-xl border border-gray-200 overflow-hidden sticky top-4">
                <!-- Form Header -->
                <div class="bg-gradient-to-r from-purple-600 to-purple-700 px-6 py-4 text-white">
                  <div class="flex items-center justify-between">
                    <h2 class="text-lg font-semibold flex items-center gap-2">
                      <.icon name={if @editing, do: "hero-pencil-square", else: "hero-plus-circle"} class="w-5 h-5" />
                      <%= if @editing, do: "Edit Position", else: "New Position" %>
                    </h2>
                    <button phx-click="cancel" class="p-1 hover:bg-white/20 rounded-lg transition">
                      <.icon name="hero-x-mark" class="w-5 h-5" />
                    </button>
                  </div>
                </div>

                <!-- Form Body -->
                <div class="p-6">
                  <.form for={%{}} as={:position} phx-submit="save" class="space-y-5">
                    <!-- Name Input -->
                    <div>
                      <label class="block text-sm font-medium text-gray-700 mb-2">
                        Position Name <span class="text-red-500">*</span>
                      </label>
                      <input
                        type="text"
                        name="name"
                        value={@form.name}
                        placeholder="e.g., Software Engineer"
                        class="w-full px-4 py-2.5 rounded-lg border border-gray-300 focus:ring-2 focus:ring-purple-500 focus:outline-none transition"
                        required
                      />
                    </div>

                    <!-- Description Input -->
                    <div>
                      <label class="block text-sm font-medium text-gray-700 mb-2">
                        Description
                      </label>
                      <textarea
                        name="description"
                        rows="4"
                        placeholder="Describe the role and responsibilities..."
                        class="w-full px-4 py-2.5 rounded-lg border border-gray-300 focus:ring-2 focus:ring-purple-500 focus:outline-none transition resize-none"
                      ><%= @form.description %></textarea>
                      <p class="text-xs text-gray-500 mt-2">Provide details about the position's duties and requirements</p>
                    </div>

                    <!-- Action Buttons -->
                    <div class="flex gap-3 pt-2">
                      <button
                        type="submit"
                        class="flex-1 px-4 py-2.5 rounded-lg bg-purple-600 text-white hover:bg-purple-700 transition font-medium flex items-center justify-center gap-2"
                      >
                        <.icon name="hero-check" class="w-5 h-5" />
                        <%= if @editing, do: "Update Position", else: "Create Position" %>
                      </button>
                      <button
                        type="button"
                        phx-click="cancel"
                        class="px-4 py-2.5 rounded-lg border border-gray-300 text-gray-700 hover:bg-gray-50 transition font-medium"
                      >
                        Cancel
                      </button>
                    </div>
                  </.form>
                </div>
              </div>
            <% else %>
              <!-- Empty State / Instructions -->
              <div class="bg-gray-50 rounded-xl p-6 border border-gray-200">
                <div class="text-center">
                  <div class="w-14 h-14 bg-white rounded-xl flex items-center justify-center mx-auto mb-4 shadow-sm border border-gray-200">
                    <.icon name="hero-briefcase" class="w-7 h-7 text-purple-600" />
                  </div>
                  <h3 class="text-lg font-semibold text-gray-900 mb-2">Manage Positions</h3>
                  <p class="text-sm text-gray-600 mb-6">
                    Create, edit, and organize job positions for your organization.
                  </p>
                  <button phx-click="new" class="px-5 py-2.5 rounded-lg bg-purple-600 text-white hover:bg-purple-700 transition font-medium flex items-center justify-center gap-2 mx-auto">
                    <.icon name="hero-plus" class="w-5 h-5" />
                    Create New Position
                  </button>
                </div>

                <!-- Quick Tips -->
                <div class="mt-6 pt-6 border-t border-gray-200">
                  <h4 class="text-sm font-semibold text-gray-800 mb-3">Quick Tips:</h4>
                  <ul class="space-y-2 text-sm text-gray-600">
                    <li class="flex items-start gap-2">
                      <.icon name="hero-light-bulb" class="w-4 h-4 text-purple-600 flex-shrink-0 mt-0.5" />
                      <span>Use clear, descriptive names for positions</span>
                    </li>
                    <li class="flex items-start gap-2">
                      <.icon name="hero-light-bulb" class="w-4 h-4 text-purple-600 flex-shrink-0 mt-0.5" />
                      <span>Add detailed descriptions to help with assignments</span>
                    </li>
                    <li class="flex items-start gap-2">
                      <.icon name="hero-light-bulb" class="w-4 h-4 text-purple-600 flex-shrink-0 mt-0.5" />
                      <span>Click column headers to sort the table</span>
                    </li>
                  </ul>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      </div>
  </div>
</div>