<div class="min-h-screen bg-gradient-to-br from-purple-50 via-white to-blue-50">
  <div class="flex">
    <main class="ml-45 w-full p-8">
      <div class="max-w-7xl mx-auto">
        <!-- Header with Stats -->
        <div class="mb-8">
          <div class="flex justify-between items-start">
            <div>
              <h1 class="text-4xl font-bold bg-gradient-to-r from-purple-600 to-blue-600 bg-clip-text text-transparent">
                User Management
              </h1>
              <p class="text-gray-600 mt-2">Manage user accounts, roles, and team assignments</p>
            </div>
            <button
              phx-click="open_add_modal"
              class="btn bg-gradient-to-r from-purple-500 to-purple-700 text-white border-none hover:from-purple-600 hover:to-purple-800 shadow-lg hover:shadow-xl transition-all duration-200"
            >
              <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
              </svg>
              Add User
            </button>
          </div>

          <!-- Stats Cards -->
          <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mt-6">
            <div class="bg-white rounded-xl shadow-md p-5 border-l-4 border-purple-500 hover:shadow-lg transition-shadow">
              <div class="flex items-center justify-between">
                <div>
                  <p class="text-sm font-medium text-gray-600">Total Users</p>
                  <p class="text-3xl font-bold text-purple-600"><%= Enum.count(@users) %></p>
                </div>
                <div class="bg-purple-100 rounded-full p-3">
                  <svg class="w-8 h-8 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13.5 3a2.5 2.5 0 11-5 0 2.5 2.5 0 015 0z" />
                  </svg>
                </div>
              </div>
            </div>

            <div class="bg-white rounded-xl shadow-md p-5 border-l-4 border-green-500 hover:shadow-lg transition-shadow">
              <div class="flex items-center justify-between">
                <div>
                  <p class="text-sm font-medium text-gray-600">Active Users</p>
                  <p class="text-3xl font-bold text-green-600"><%= Enum.count(@users, &(&1.status == "active")) %></p>
                </div>
                <div class="bg-green-100 rounded-full p-3">
                  <svg class="w-8 h-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                </div>
              </div>
            </div>

            <div class="bg-white rounded-xl shadow-md p-5 border-l-4 border-yellow-500 hover:shadow-lg transition-shadow">
              <div class="flex items-center justify-between">
                <div>
                  <p class="text-sm font-medium text-gray-600">Pending</p>
                  <p class="text-3xl font-bold text-yellow-600"><%= Enum.count(@users, &(&1.status == "pending")) %></p>
                </div>
                <div class="bg-yellow-100 rounded-full p-3">
                  <svg class="w-8 h-8 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                </div>
              </div>
            </div>

            <div class="bg-white rounded-xl shadow-md p-5 border-l-4 border-blue-500 hover:shadow-lg transition-shadow">
              <div class="flex items-center justify-between">
                <div>
                  <p class="text-sm font-medium text-gray-600">Attachees</p>
                  <p class="text-3xl font-bold text-blue-600"><%= Enum.count(@users, &has_role?(&1, "attachee")) %></p>
                </div>
                <div class="bg-blue-100 rounded-full p-3">
                  <svg class="w-8 h-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                  </svg>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Search and Filter Section -->
        <div class="bg-white rounded-xl shadow-md p-6 mb-6">
          <div class="flex flex-col md:flex-row gap-4">
            <!-- Search -->
            <div class="flex-1">
              <label class="block text-sm font-medium text-gray-700 mb-2">Search Users</label>
              <div class="relative">
                <input
                  type="text"
                  phx-keyup="search"
                  phx-debounce="300"
                  name="query"
                  value={@search_query}
                  placeholder="Search by name or email..."
                  class="w-full pl-10 pr-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent"
                />
                <svg class="absolute left-3 top-2.5 w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
              </div>
            </div>

            <!-- Status Filter -->
            <div class="w-full md:w-48">
              <label class="block text-sm font-medium text-gray-700 mb-2">Status</label>
              <.link
                patch={~p"/admin/users?filter=#{@filter == "all" && "active" || "all"}"}
                class="w-full btn btn-outline"
              >
                <%= case @filter do
                  "all" -> "All Status"
                  "pending" -> "Pending"
                  "active" -> "Active"
                  _ -> "Filter Status"
                end %>
              </.link>
            </div>

            <!-- Role Filter -->
            <div class="w-full md:w-48">
              <label class="block text-sm font-medium text-gray-700 mb-2">Role</label>
              <.link
                patch={~p"/admin/users?role=#{@role_filter == "all" && "employee" || "all"}"}
                class="w-full btn btn-outline"
              >
                <%= case @role_filter do
                  "all" -> "All Roles"
                  "employee" -> "Employees"
                  "attachee" -> "Attachees"
                  "supervisor" -> "Supervisors"
                  "admin" -> "Admins"
                  _ -> "Filter Role"
                end %>
              </.link>
            </div>
          </div>
        </div>

        <!-- Filter Tabs -->
        <div class="mb-6">
          <div class="bg-white rounded-xl shadow-md">
            <nav class="flex space-x-1 p-2">
              <.link
                patch={~p"/admin/users?filter=all"}
                class={[
                  "flex-1 text-center py-3 px-4 rounded-lg font-medium text-sm transition-all duration-200",
                  @filter == "all" && "bg-gradient-to-r from-purple-500 to-purple-600 text-white shadow-md",
                  @filter != "all" && "text-gray-600 hover:bg-gray-100"
                ]}
              >
                <div class="flex items-center justify-center gap-2">
                  <span>All Users</span>
                  <span class={[
                    "px-2.5 py-0.5 rounded-full text-xs font-semibold",
                    @filter == "all" && "bg-white/20 text-white",
                    @filter != "all" && "bg-gray-200 text-gray-700"
                  ]}>
                    <%= Enum.count(@users) %>
                  </span>
                </div>
              </.link>

              <.link
                patch={~p"/admin/users?filter=pending"}
                class={[
                  "flex-1 text-center py-3 px-4 rounded-lg font-medium text-sm transition-all duration-200",
                  @filter == "pending" && "bg-gradient-to-r from-yellow-500 to-yellow-600 text-white shadow-md",
                  @filter != "pending" && "text-gray-600 hover:bg-gray-100"
                ]}
              >
                <div class="flex items-center justify-center gap-2">
                  <span>Pending</span>
                  <span class={[
                    "px-2.5 py-0.5 rounded-full text-xs font-semibold",
                    @filter == "pending" && "bg-white/20 text-white",
                    @filter != "pending" && "bg-yellow-100 text-yellow-700"
                  ]}>
                    <%= Enum.count(@users, &(&1.status == "pending")) %>
                  </span>
                </div>
              </.link>

              <.link
                patch={~p"/admin/users?filter=active"}
                class={[
                  "flex-1 text-center py-3 px-4 rounded-lg font-medium text-sm transition-all duration-200",
                  @filter == "active" && "bg-gradient-to-r from-green-500 to-green-600 text-white shadow-md",
                  @filter != "active" && "text-gray-600 hover:bg-gray-100"
                ]}
              >
                <div class="flex items-center justify-center gap-2">
                  <span>Active</span>
                  <span class={[
                    "px-2.5 py-0.5 rounded-full text-xs font-semibold",
                    @filter == "active" && "bg-white/20 text-white",
                    @filter != "active" && "bg-green-100 text-green-700"
                  ]}>
                    <%= Enum.count(@users, &(&1.status == "active")) %>
                  </span>
                </div>
              </.link>
            </nav>
          </div>
        </div>

        <!-- Users Table -->
        <%= if !Enum.empty?(@users) do %>
          <div class="bg-white rounded-xl shadow-md overflow-hidden border border-gray-100">
            <div class="overflow-x-auto">
              <table class="w-full">
                <thead class="bg-gradient-to-r from-purple-500 to-blue-500 text-white">
                  <tr>
                    <th class="px-6 py-4 text-left text-sm font-semibold">User</th>
                    <th class="px-6 py-4 text-left text-sm font-semibold">Email</th>
                    <th class="px-6 py-4 text-left text-sm font-semibold">Status</th>
                    <th class="px-6 py-4 text-left text-sm font-semibold">Roles</th>
                    <th class="px-6 py-4 text-left text-sm font-semibold">Team Assignments</th>
                    <th class="px-6 py-4 text-left text-sm font-semibold">Registered</th>
                    <th class="px-6 py-4 text-center text-sm font-semibold">Actions</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-gray-200">
                  <%= for user <- @users do %>
                    <tr class="hover:bg-purple-50 transition-colors duration-150">
                      <!-- User -->
                      <td class="px-6 py-4 whitespace-nowrap">
                        <div class="flex items-center gap-3">
                          <div class="bg-gradient-to-br from-purple-500 to-blue-500 text-white rounded-full w-10 h-10 flex items-center justify-center font-semibold shadow-md">
                            <%= String.at(user.username, 0) |> String.upcase() %>
                          </div>
                          <div>
                            <div class="font-semibold text-gray-900"><%= user.username %></div>
                          </div>
                        </div>
                      </td>

                      <!-- Email -->
                      <td class="px-6 py-4 whitespace-nowrap">
                        <div class="text-sm text-gray-600"><%= user.email %></div>
                      </td>

                      <!-- Status -->
                      <td class="px-6 py-4 whitespace-nowrap">
                        <span class={["badge", user_status_class(user.status)]}>
                          <%= user_status_label(user.status) %>
                        </span>
                      </td>

                      <!-- Roles -->
                      <td class="px-6 py-4">
                        <div class="flex flex-wrap gap-1">
                          <%= for role <- user.roles || [] do %>
                            <span class={["badge badge-sm", role_badge_class(role)]}>
                              <%= role_label(role) %>
                            </span>
                          <% end %>
                        </div>
                      </td>

                      <!-- Team Assignments -->
                      <td class="px-6 py-4">
                        <%= if Enum.empty?(user.employees) do %>
                          <span class="text-xs text-gray-400 italic">No assignments</span>
                        <% else %>
                          <div class="space-y-1">
                            <%= for employee <- Enum.take(user.employees, 2) do %>
                              <%= if employee.team do %>
                                <div class="text-xs">
                                  <span class="font-medium text-purple-700"><%= employee.team.name %></span>
                                  <span class="text-gray-500"> - <%= employee.department && employee.department.name || "N/A" %></span>
                                </div>
                              <% end %>
                            <% end %>
                            <%= if length(user.employees) > 2 do %>
                              <span class="text-xs text-purple-600 font-medium">
                                +<%= length(user.employees) - 2 %> more
                              </span>
                            <% end %>
                          </div>
                        <% end %>
                      </td>

                      <!-- Registered -->
                      <td class="px-6 py-4 whitespace-nowrap">
                        <div class="text-sm text-gray-600">
                          <%= Timex.format!(user.inserted_at, "{M}/{D}/{YYYY}") %>
                        </div>
                      </td>

                      <!-- Actions -->
                      <td class="px-6 py-4 whitespace-nowrap">
                        <div class="flex items-center justify-center gap-2">
                          <button
                            phx-click="view_user"
                            phx-value-user-id={user.id}
                            class="btn btn-sm bg-gradient-to-r from-purple-500 to-purple-600 text-white border-none hover:from-purple-600 hover:to-purple-700 shadow-sm"
                            title="View User"
                          >
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                            </svg>
                          </button>
                          <button
                            phx-click="edit_user"
                            phx-value-user-id={user.id}
                            class="btn btn-sm btn-outline btn-primary hover:bg-purple-50"
                            title="Edit User"
                          >
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                            </svg>
                          </button>
                        </div>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          </div>
        <% end %>

        <!-- Empty State -->
        <%= if Enum.empty?(@users) do %>
          <div class="bg-white rounded-xl shadow-md p-12 text-center">
            <div class="bg-gray-100 rounded-full w-20 h-20 flex items-center justify-center mx-auto mb-4">
              <svg class="w-10 h-10 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197m13.5-9a2.5 2.5 0 11-5 0 2.5 2.5 0 015 0z" />
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-gray-900 mb-2">No users found</h3>
            <p class="text-gray-500 mb-6">
              <%= if @filter == "pending" do %>
                No users are waiting for approval.
              <% else %>
                Get started by creating a new user.
              <% end %>
            </p>
            <button
              phx-click="open_add_modal"
              class="btn bg-gradient-to-r from-purple-500 to-purple-700 text-white border-none hover:from-purple-600 hover:to-purple-800"
            >
              <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
              </svg>
              Add Your First User
            </button>
          </div>
        <% end %>
      </div>
    </main>
  </div>
  
  <!-- ==================== VIEW USER MODAL ==================== -->
  <%= if @show_view_modal && @selected_user do %>
    <div class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4">
      <div class="bg-white rounded-xl shadow-xl max-w-4xl w-full max-h-[90vh] overflow-y-auto">
        <div class="px-6 py-4 border-b border-gray-200 flex items-center justify-between">
          <div>
            <h2 class="text-xl font-bold text-gray-900">User Details</h2>
            <p class="text-sm text-gray-500 mt-1"><%= @selected_user.username %></p>
          </div>
          <button phx-click="close_modal" class="text-gray-400 hover:text-gray-600 transition">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M6 18L18 6M6 6l12 12"
              />
            </svg>
          </button>
        </div>

        <div class="px-6 py-4 space-y-6">
          <!-- Avatar + Header -->
          <div class="flex items-center gap-4 pb-6 border-b border-gray-200">
            <div class="w-16 h-16 rounded-full bg-purple-600 flex items-center justify-center text-white text-2xl font-bold">
              <%= String.first(@selected_user.username) |> String.upcase() %>
            </div>
            <div>
              <h3 class="text-2xl font-bold text-gray-900"><%= @selected_user.username %></h3>
              <p class="text-gray-600"><%= @selected_user.email %></p>
              <div class="flex gap-2 mt-2">
                <span class={[
                  "inline-flex px-2 py-1 text-xs font-semibold rounded-full",
                  user_status_class(@selected_user.status)
                ]}>
                  <%= user_status_label(@selected_user.status) %>
                </span>
              </div>
            </div>
          </div>
          
          <!-- User Info Grid -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="bg-gray-50 rounded-lg p-4 border border-gray-200">
              <div class="text-xs text-gray-500 font-medium uppercase mb-1">Email</div>
              <div class="text-sm font-semibold text-gray-900"><%= @selected_user.email %></div>
            </div>
            <div class="bg-gray-50 rounded-lg p-4 border border-gray-200">
              <div class="text-xs text-gray-500 font-medium uppercase mb-1">Username</div>
              <div class="text-sm font-semibold text-gray-900"><%= @selected_user.username %></div>
            </div>
            <div class="bg-gray-50 rounded-lg p-4 border border-gray-200">
              <div class="text-xs text-gray-500 font-medium uppercase mb-1">Roles</div>
              <%= if @selected_user.roles && length(@selected_user.roles) > 0 do %>
                <div class="flex flex-wrap gap-1">
                  <%= for role <- @selected_user.roles do %>
                    <span class={[
                      "inline-flex items-center px-2 py-1 text-xs rounded-full font-medium",
                      role_badge_color(role)
                    ]}>
                      <%= String.capitalize(role) %>
                    </span>
                  <% end %>
                </div>
              <% else %>
                <div class="text-sm text-gray-500">No roles assigned</div>
              <% end %>
            </div>
            <div class="bg-gray-50 rounded-lg p-4 border border-gray-200">
              <div class="text-xs text-gray-500 font-medium uppercase mb-1">Status</div>
              <div class="text-sm font-semibold text-gray-900">
                <%= user_status_label(@selected_user.status) %>
              </div>
            </div>
            <div class="bg-gray-50 rounded-lg p-4 border border-gray-200">
              <div class="text-xs text-gray-500 font-medium uppercase mb-1">Registered On</div>
              <div class="text-sm font-semibold text-gray-900">
                <%= Timex.format!(@selected_user.inserted_at, "{Mfull} {D}, {YYYY}") %>
              </div>
            </div>
            <div class="bg-gray-50 rounded-lg p-4 border border-gray-200">
              <div class="text-xs text-gray-500 font-medium uppercase mb-1">Last Updated</div>
              <div class="text-sm font-semibold text-gray-900">
                <%= Timex.format!(@selected_user.updated_at, "{Mfull} {D}, {YYYY}") %>
              </div>
            </div>
          </div>
          
          <!-- Team Assignments -->
          <div class="bg-gray-50 rounded-lg p-4 border border-gray-200">
            <div class="text-xs text-gray-500 font-medium uppercase mb-3">Team Assignments</div>
            <%= if map_size(@team_assignments) > 0 do %>
              <div class="space-y-3">
                <%= for {_team_id, assignment} <- @team_assignments do %>
                  <div class="bg-white p-4 rounded-lg border border-gray-200">
                    <h4 class="font-semibold text-gray-900"><%= assignment.team_name %></h4>
                    <p class="text-sm text-gray-600 mt-1">
                      <span class="font-medium">Department:</span> <%= assignment.department_name %>
                    </p>
                    <p class="text-sm text-gray-600">
                      <span class="font-medium">Organization:</span> <%= assignment.organization_name %>
                    </p>
                  </div>
                <% end %>
              </div>
            <% else %>
              <div class="text-center py-6">
                <p class="text-gray-500 text-sm">No team assignments</p>
              </div>
            <% end %>
          </div>
        </div>

        <div class="px-6 py-4 border-t border-gray-200 flex justify-end gap-3">
          <button
            type="button"
            phx-click="close_modal"
            class="px-4 py-2 rounded-lg text-sm font-medium text-gray-700 hover:bg-gray-100 transition border border-gray-300"
          >
            Close
          </button>
          <button
            type="button"
            phx-click="edit_user"
            phx-value-user-id={@selected_user.id}
            class="bg-purple-600 text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-purple-700 transition shadow"
          >
            Edit User
          </button>
        </div>
      </div>
    </div>
  <% end %>
  
  <!-- ==================== EDIT USER MODAL ==================== -->
  <%= if @show_edit_modal && @selected_user do %>
    <div class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4">
      <div class="bg-white rounded-xl shadow-xl max-w-4xl w-full max-h-[90vh] overflow-y-auto">
        <div class="px-6 py-4 border-b border-gray-200 flex items-center justify-between">
          <div>
            <h2 class="text-xl font-bold text-gray-900">Edit User</h2>
            <p class="text-sm text-gray-500 mt-1"><%= @selected_user.username %></p>
          </div>
          <button phx-click="close_modal" class="text-gray-400 hover:text-gray-600 transition">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M6 18L18 6M6 6l12 12"
              />
            </svg>
          </button>
        </div>

        <form phx-submit="save_user" class="px-6 py-4 space-y-6">
          <!-- Email & Username -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-2">Email</label>
              <input
                type="email"
                name="email"
                value={@user_form.email}
                placeholder="user@example.com"
                class="w-full px-4 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-purple-500 focus:border-transparent"
              />
            </div>
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-2">Username</label>
              <input
                type="text"
                name="username"
                value={@user_form.username}
                placeholder="username"
                class="w-full px-4 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-purple-500 focus:border-transparent"
              />
            </div>
          </div>
          
          <!-- Roles (Checkboxes) & Status -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-3">Roles</label>
              <div class="space-y-2">
                <div class="flex items-center">
                  <input
                    type="checkbox"
                    id="is_attachee"
                    name="is_attachee"
                    value="true"
                    checked={@user_form.is_attachee}
                    class="h-4 w-4 text-purple-600 focus:ring-purple-500 border-gray-300 rounded"
                  />
                  <label for="is_attachee" class="ml-2 text-sm text-gray-700">Attachee</label>
                </div>
                <div class="flex items-center">
                  <input
                    type="checkbox"
                    id="is_supervisor"
                    name="is_supervisor"
                    value="true"
                    checked={@user_form.is_supervisor}
                    class="h-4 w-4 text-purple-600 focus:ring-purple-500 border-gray-300 rounded"
                  />
                  <label for="is_supervisor" class="ml-2 text-sm text-gray-700">Supervisor</label>
                </div>
                <div class="flex items-center">
                  <input
                    type="checkbox"
                    id="is_admin"
                    name="is_admin"
                    value="true"
                    checked={@user_form.is_admin}
                    class="h-4 w-4 text-purple-600 focus:ring-purple-500 border-gray-300 rounded"
                  />
                  <label for="is_admin" class="ml-2 text-sm text-gray-700">Admin</label>
                </div>
              </div>
              <p class="mt-2 text-xs text-gray-500">Select one or more roles for this user</p>
            </div>
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-2">Status</label>
              <select
                name="status"
                class="w-full px-4 py-2 rounded-lg border border-gray-300 bg-white focus:ring-2 focus:ring-purple-500 focus:border-transparent"
              >
                <option value="pending" selected={@user_form.status == "pending"}>Pending</option>
                <option value="active" selected={@user_form.status == "active"}>Active</option>
                <option value="suspended" selected={@user_form.status == "suspended"}>
                  Suspended
                </option>
              </select>
            </div>
          </div>
          
          <!-- Attachee Enrollment -->
          <div class="bg-gray-50 p-4 rounded-xl border border-gray-200">
            <label class="block text-sm font-semibold text-gray-700 mb-3">
              Attachee Enrollment
            </label>
            <div class="flex items-center gap-3 mb-4">
              <input
                type="checkbox"
                id="is_attachee_enrollment"
                name="is_attachee"
                value="true"
                class="h-4 w-4 text-purple-600 focus:ring-purple-500 border-gray-300 rounded"
              />
              <label for="is_attachee_enrollment" class="text-sm text-gray-700">
                Enroll this user as an attachee
              </label>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div>
                <label class="block text-sm font-medium text-gray-600 mb-1">
                  Start date (optional)
                </label>
                <input
                  type="date"
                  name="attachee_starts_on"
                  class="w-full px-3 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-purple-500 focus:border-transparent"
                />
              </div>
              <div>
                <label class="block text-sm font-medium text-gray-600 mb-1">
                  End date (optional)
                </label>
                <input
                  type="date"
                  name="attachee_ends_on"
                  class="w-full px-3 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-purple-500 focus:border-transparent"
                />
              </div>
            </div>
            <p class="mt-2 text-xs text-gray-500">
              If checked, an Attachee record will be created for each selected team/department.
            </p>
          </div>
          
          <!-- Team Assignments -->
          <div class="bg-gray-50 p-4 rounded-xl border border-gray-200">
            <label class="block text-sm font-semibold text-gray-700 mb-3">Team Assignments</label>
            
            <!-- Filters -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
              <div>
                <label class="block text-sm font-medium text-gray-600 mb-1">
                  Filter by Organization
                </label>
                <select
                  phx-change="select_organization"
                  name="filter_organization_id"
                  value={@selected_org_id || ""}
                  class="w-full px-3 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-purple-500 focus:border-transparent"
                >
                  <option value="">All Organizations</option>
                  <%= for org <- @organizations do %>
                    <option value={org.id} selected={@selected_org_id == org.id}>
                      <%= org.name %>
                    </option>
                  <% end %>
                </select>
              </div>
              <div>
                <label class="block text-sm font-medium text-gray-600 mb-1">
                  Filter by Department
                </label>
                <select
                  phx-change="select_department"
                  name="filter_department_id"
                  value={@selected_dept_id || ""}
                  class="w-full px-3 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-purple-500 focus:border-transparent"
                >
                  <option value="">All Departments</option>
                  <%= for dept <- @available_departments do %>
                    <option value={dept.id} selected={@selected_dept_id == dept.id}>
                      <%= dept.name %> - <%= dept.organization.name %>
                    </option>
                  <% end %>
                </select>
              </div>
            </div>
            
            <!-- Teams Grid -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 max-h-64 overflow-y-auto p-3 border border-gray-200 rounded-lg bg-white">
              <%= for team <- @available_teams do %>
                <div class="flex items-start">
                  <input
                    type="checkbox"
                    id={"team_#{team.id}"}
                    name={"team_assignment[#{team.id}]"}
                    value="true"
                    checked={Map.has_key?(@team_assignments, to_string(team.id))}
                    phx-click="toggle_team_assignment"
                    phx-value-team-id={team.id}
                    class="h-4 w-4 mt-1 text-purple-600 focus:ring-purple-500 border-gray-300 rounded"
                  />
                  <label for={"team_#{team.id}"} class="ml-2 text-sm text-gray-700">
                    <div class="font-semibold"><%= team.name %></div>
                    <div class="text-xs text-gray-500">
                      <%= team.department.name %> - <%= team.department.organization.name %>
                    </div>
                  </label>
                </div>
              <% end %>
              <%= if Enum.empty?(@available_teams) do %>
                <div class="col-span-full text-center py-6 text-gray-500 italic">
                  No teams available
                </div>
              <% end %>
            </div>
            
            <!-- Hidden inputs for selected teams -->
            <%= for {team_id, _} <- @team_assignments do %>
              <input type="hidden" name="team_ids[]" value={team_id} />
            <% end %>
          </div>
          
          <!-- Form Actions -->
          <div class="flex justify-end gap-3 pt-6 border-t border-gray-200">
            <button
              type="button"
              phx-click="close_modal"
              class="px-4 py-2 rounded-lg text-sm font-medium text-gray-700 hover:bg-gray-100 transition border border-gray-300"
            >
              Cancel
            </button>
            <button
              type="submit"
              class="bg-purple-600 text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-purple-700 transition shadow"
            >
              Save Changes
            </button>
          </div>
        </form>
      </div>
    </div>
  <% end %>
  
  <!-- ==================== ADD USER MODAL ==================== -->
  <%= if @show_add_modal do %>
    <div class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4">
      <div class="bg-white rounded-xl shadow-xl max-w-2xl w-full max-h-[90vh] overflow-y-auto">
        <div class="px-6 py-4 border-b border-gray-200 flex items-center justify-between">
          <div>
            <h2 class="text-xl font-bold text-gray-900">Add New User</h2>
            <p class="text-sm text-gray-500 mt-1">Create a new user account</p>
          </div>
          <button phx-click="close_modal" class="text-gray-400 hover:text-gray-600 transition">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M6 18L18 6M6 6l12 12"
              />
            </svg>
          </button>
        </div>

        <form phx-submit="create_user" class="px-6 py-4 space-y-6">
          <!-- Email -->
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2">
              Email <span class="text-red-500">*</span>
            </label>
            <input
              type="email"
              name="email"
              value={@user_form["email"] || ""}
              phx-blur="update_form_field"
              phx-value-field="email"
              placeholder="user@example.com"
              required
              class="w-full px-4 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-purple-500 focus:border-transparent"
            />
          </div>
          
          <!-- First Name & Last Name -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-2">
                First Name <span class="text-red-500">*</span>
              </label>
              <input
                type="text"
                name="first_name"
                value={@user_form["first_name"] || ""}
                phx-blur="update_form_field"
                phx-value-field="first_name"
                placeholder="John"
                required
                class="w-full px-4 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-purple-500 focus:border-transparent"
              />
            </div>
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-2">
                Last Name <span class="text-red-500">*</span>
              </label>
              <input
                type="text"
                name="last_name"
                value={@user_form["last_name"] || ""}
                phx-blur="update_form_field"
                phx-value-field="last_name"
                placeholder="Doe"
                required
                class="w-full px-4 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-purple-500 focus:border-transparent"
              />
            </div>
          </div>
          
          <!-- Phone Number -->
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2">
              Phone Number <span class="text-red-500">*</span>
            </label>
            <input
              type="tel"
              name="phone_number"
              value={@user_form["phone_number"] || ""}
              phx-blur="update_form_field"
              phx-value-field="phone_number"
              placeholder="+254 712 345 678"
              required
              class="w-full px-4 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-purple-500 focus:border-transparent"
            />
          </div>
          
          <!-- Form Actions -->
          <div class="flex justify-end gap-3 pt-6 border-t border-gray-200">
            <button
              type="button"
              phx-click="close_modal"
              class="px-4 py-2 rounded-lg text-sm font-medium text-gray-700 hover:bg-gray-100 transition border border-gray-300"
            >
              Cancel
            </button>
            <button
              type="submit"
              class="bg-purple-600 text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-purple-700 transition shadow"
            >
              Add User
            </button>
          </div>
        </form>
      </div>
    </div>
  <% end %>
  
  <!-- ==================== DELETE CONFIRMATION MODAL ==================== -->
  <%= if @show_delete_modal && @selected_user do %>
    <div class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4">
      <div class="bg-white rounded-xl shadow-xl max-w-md w-full">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-xl font-bold text-gray-900">Confirm Deletion</h2>
        </div>

        <div class="px-6 py-4">
          <p class="text-gray-700">
            Are you sure you want to delete user <strong><%= @selected_user.username %></strong>?
          </p>
          <p class="text-sm text-red-600 mt-2">
            This action cannot be undone. The user and all associated data will be permanently removed from the system.
          </p>
        </div>

        <div class="px-6 py-4 border-t border-gray-200 flex justify-end gap-3">
          <button
            type="button"
            phx-click="close_modal"
            class="px-4 py-2 rounded-lg text-sm font-medium text-gray-700 hover:bg-gray-100 transition border border-gray-300"
          >
            Cancel
          </button>
          <button
            type="button"
            phx-click="delete_user"
            class="bg-red-600 text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-red-700 transition shadow"
          >
            Delete User
          </button>
        </div>
      </div>
    </div>
  <% end %>
</div>